import { JobAdapter } from trb/jobs
import { Duration } from trb/std/time

enum SQLDatabase
	SQLite
	PostgreSQL
	MySQL
end

class SQLAdapter implements JobAdapter
	readonly @database_adapter: SQLDatabase
	readonly @database: String
	readonly @database_environment: String
	readonly @poll_interval: Duration
	readonly @lease_timeout: Duration
	readonly @shutdown_timeout: Duration
	readonly @default_maximum_attempts: Integer
	readonly @retry_base_delay: Duration
	readonly @worker_concurrency: Integer

	def initialize(
			database_adapter:: SQLDatabase = SQLDatabase::SQLite,
			database:: String = "jobs.sqlite3",
			database_environment:: String = "TRB_JOBS_DATABASE",
			poll_interval:: Duration = Duration.seconds(1),
			lease_timeout:: Duration = Duration.seconds(60),
			shutdown_timeout:: Duration = Duration.seconds(30),
			default_maximum_attempts:: Integer = 5,
			retry_base_delay:: Duration = Duration.seconds(1),
			worker_concurrency:: Integer = 1,
		)
		@database_adapter = database_adapter
		@database = database
		@database_environment = database_environment
		@poll_interval = poll_interval
		@lease_timeout = lease_timeout
		@shutdown_timeout = shutdown_timeout
		@default_maximum_attempts = default_maximum_attempts
		@retry_base_delay = retry_base_delay
		@worker_concurrency = worker_concurrency
		return
	end
end
