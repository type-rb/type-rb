import { Result } from trb/std/result
import { Instant } from trb/std/time
import { Unit } from trb/std/unit

enum EnqueueErrorKind
	Serialization
	InvalidArgument
	Cancelled
	Adapter
end

record EnqueueError
	kind: EnqueueErrorKind
	message: String
end

record JobReference
	id: String
	job_name: String
end

record EnqueueRequest
	job_name: String
	payload: String
	payload_version: Integer
	queue_name: String
	priority: Integer
	maximum_attempts: Integer?
end

record JobError
	message: String
end

alias JobResult = Result<Unit, JobError>

interface JobAdapter
	enqueue(request: EnqueueRequest): Result<JobReference, EnqueueError>
	enqueue_at(request: EnqueueRequest, scheduled_at: Instant): Result<JobReference, EnqueueError>
end

class Job
end

def queue(name: String)
	return
end

def priority(value: Integer)
	return
end

def maximum_attempts(value: Integer)
	return
end
