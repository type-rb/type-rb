import { Result } from trb/std/result
import { Unit } from trb/std/unit

enum EnqueueErrorKind
	Serialization
	InvalidArgument
	Cancelled
	Adapter
end

record EnqueueError
	kind: EnqueueErrorKind
	message: String
end

record JobReference
	id: String
	job_name: String
end

record JobError
	message: String
end

type JobResult = Result<Unit, JobError>

interface JobAdapter
end

class Job
end

def queue(name: String)
	return
end

def priority(value: Integer)
	return
end

def maximum_attempts(value: Integer)
	return
end
