import { Body, Header, Headers } from trb/http
import { QueryParameter } from trb/std/url

record NoBody
end

class Response<T>
	readonly @status: Integer
	readonly @headers: Headers
	readonly @url: String
	readonly @body: T

	def initialize(status: Integer, headers: Headers, url: String, body: T)
		@status = status
		@headers = headers
		@url = url
		@body = body
		return
	end
end

enum RequestErrorKind
	Network
	Timeout
	Abort
	Contract
end

class RequestError
	readonly @kind: RequestErrorKind
	readonly @message: String
	readonly @response: Response<Body>?

	def initialize(kind: RequestErrorKind, message: String, response: Response<Body>? = nil)
		@kind = kind
		@message = message
		@response = response
		return
	end
end

enum RequestBody
	Text(value: String)
	Bytes(value: Bytes)
	Form(value: Array<QueryParameter>)
	Json(value: String)
end

class HttpClient
	readonly @base_url: String

	def initialize(base_url: String = "")
		@base_url = base_url
		return
	end
end

def _transport_response(status: Integer, headers: Array<Header>, url: String, bytes: Bytes): Response<Body>
	return Response<Body>.new(status, Headers.new(headers), url, Body.new(bytes))
end

def _map_response<T>(response: Response<Body>, body: T): Response<T>
	return Response<T>.new(response.status, response.headers, response.url, body)
end
