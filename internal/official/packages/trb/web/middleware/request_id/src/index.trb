import { Context, Next, Response } from trb/web
import { Middleware } from trb/web/middleware
import trb/std/encoding/hex
import { Result } from trb/std/result
import trb/std/secure_random

record RequestIDOptions
	header_name: String
	limit_length: Integer
end

class RequestIDMiddleware implements Middleware
	@options: RequestIDOptions

	def initialize(options: RequestIDOptions)
		@options = options
		return
	end

	def call(context: Context, next_handler: Next): Response
		return _invoke(context, next_handler, @options)
	end
end

module RequestID
	def self.default_options(): RequestIDOptions
		return RequestIDOptions.new(header_name: "x-request-id", limit_length: 255)
	end

	def self.middleware(options: RequestIDOptions = RequestID.default_options()): Middleware
		return RequestIDMiddleware.new(options)
	end

	def self.call(context: Context, next_handler: Next, options: RequestIDOptions = RequestID.default_options()): Response
		return _invoke(context, next_handler, options)
	end
end

def _invoke(context: Context, next_handler: Next, options: RequestIDOptions): Response
	mut value := _generate()
	case context.request.header_value(options.header_name)
	when Result::Ok(candidate)
		if _valid?(candidate, options.limit_length)
			value = candidate
		end
	when Result::Err(_error)
	end
	request := context.request.with_header(options.header_name, value)
	next_context := context.with_request(request)
	response := next_handler.call(next_context)
	return response.with_header(options.header_name, value)
end

def _generate(): String
	return Hex.encode(SecureRandom.bytes(16))
end

def _valid?(value: String, limit_length: Integer): Boolean
	if value == "" || limit_length < 1 || value.size() > limit_length
		return false
	end
	value.codepoints().each do |codepoint|
		letter := codepoint >= 65 && codepoint <= 90 || codepoint >= 97 && codepoint <= 122
		digit := codepoint >= 48 && codepoint <= 57
		symbol := codepoint == 45 || codepoint == 61 || codepoint == 95
		if !letter && !digit && !symbol
			return false
		end
	end
	return true
end
