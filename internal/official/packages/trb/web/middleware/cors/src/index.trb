import { Context, Next, Request, Response, empty } from trb/web
import { Middleware } from trb/web/middleware

enum PreflightMaxAge
	Disabled
	Seconds(value: Integer)
end

record CORSOptions
	allow_origins: Array<String>
	allow_methods: Array<String>
	allow_headers: Array<String>
	expose_headers: Array<String>
	credentials: Boolean
	max_age: PreflightMaxAge
end

class CORSMiddleware implements Middleware
	@options: CORSOptions

	def initialize(options: CORSOptions)
		@options = options
		return
	end

	def call(context: Context, next_handler: Next): Response
		return _invoke(context, next_handler, @options)
	end
end

module CORS
	def self.default_options(): CORSOptions
		return CORSOptions.new(
			allow_origins: ["*"],
			allow_methods: ["GET", "HEAD", "PUT", "POST", "DELETE", "PATCH", "OPTIONS"],
			allow_headers: [],
			expose_headers: [],
			credentials: false,
			max_age: PreflightMaxAge::Disabled,
		)
	end

	def self.middleware(options: CORSOptions = CORS.default_options()): Middleware
		return CORSMiddleware.new(options)
	end

	def self.call(context: Context, next_handler: Next, options: CORSOptions = CORS.default_options()): Response
		return _invoke(context, next_handler, options)
	end
end

def _invoke(context: Context, next_handler: Next, options: CORSOptions): Response
	request := context.request
	origin := _request_origin(request)
	if _preflight?(request)
		return _preflight_response(request, origin, options)
	end
	response := next_handler.call(context)
	return _apply_actual_response(response, origin, options)
end

def _request_origin(request: Request): String
	values := request.header_values("origin")
	if values.size() != 1
		return ""
	end
	return values[0]
end

def _preflight?(request: Request): Boolean
	if request.method.to_s() != "OPTIONS"
		return false
	end
	return request.header_values("access-control-request-method").size() == 1
end

def _preflight_response(request: Request, origin: String, options: CORSOptions): Response
	mut response := empty()
	if _varies_by_origin?(options)
		response = response.vary("Origin")
	end
	allowed_origin := _allowed_origin(origin, options)
	if allowed_origin == ""
		return response
	end
	response = _apply_origin(response, allowed_origin, options)
	if !options.allow_methods.empty?()
		response = response.with_header("access-control-allow-methods", options.allow_methods.join(", "))
	end
	if options.allow_headers.empty?()
		requested_headers := request.header_values("access-control-request-headers")
		if !requested_headers.empty?()
			response = response.with_header("access-control-allow-headers", requested_headers.join(", "))
			response = response.vary("Access-Control-Request-Headers")
		end
	else
		response = response.with_header("access-control-allow-headers", options.allow_headers.join(", "))
	end
	return _apply_max_age(response, options.max_age)
end

def _apply_actual_response(mut response: Response, origin: String, options: CORSOptions): Response
	if _varies_by_origin?(options)
		response = response.vary("Origin")
	end
	allowed_origin := _allowed_origin(origin, options)
	if allowed_origin == ""
		return response
	end
	response = _apply_origin(response, allowed_origin, options)
	if !options.expose_headers.empty?()
		response = response.with_header("access-control-expose-headers", options.expose_headers.join(", "))
	end
	return response
end

def _allowed_origin(origin: String, options: CORSOptions): String
	if origin == ""
		return ""
	end
	if options.allow_origins.include?("*")
		if options.credentials
			return origin
		end
		return "*"
	end
	if options.allow_origins.include?(origin)
		return origin
	end
	return ""
end

def _varies_by_origin?(options: CORSOptions): Boolean
	return !options.allow_origins.include?("*") || options.credentials
end

def _apply_origin(response: Response, origin: String, options: CORSOptions): Response
	mut result := response.with_header("access-control-allow-origin", origin)
	if options.credentials
		result = result.with_header("access-control-allow-credentials", "true")
	end
	return result
end

def _apply_max_age(response: Response, max_age: PreflightMaxAge): Response
	case max_age
	when PreflightMaxAge::Disabled
		return response
	when PreflightMaxAge::Seconds(value)
		if value < 0
			return response
		end
		return response.with_header("access-control-max-age", value.to_s())
	end
end
