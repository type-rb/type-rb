import { Context, Next, Response } from trb/web
import { Middleware } from trb/web/middleware
import trb/internal/web/logger as native_logger

record LoggerOptions
	stderr: Boolean
	exclude_paths: Array<String>
end

class LoggerMiddleware implements Middleware
	@options: LoggerOptions

	def initialize(options: LoggerOptions)
		@options = options
		return
	end

	def call(context: Context, next_handler: Next): Response
		return _invoke(context, next_handler, @options)
	end
end

module Logger
	def self.default_options(): LoggerOptions
		return LoggerOptions.new(stderr: false, exclude_paths: [])
	end

	def self.middleware(options: LoggerOptions = Logger.default_options()): Middleware
		return LoggerMiddleware.new(options)
	end

	def self.call(context: Context, next_handler: Next, options: LoggerOptions = Logger.default_options()): Response
		return _invoke(context, next_handler, options)
	end
end

def _invoke(context: Context, next_handler: Next, options: LoggerOptions): Response
	return native_logger.call(context, next_handler, options)
end
