import { Result } from trb/std/result
import { JsonError } from trb/std/json
import { PercentDecodeError, QueryParameter, parse_query } from trb/std/url
import { Body, Header, Headers, HeaderValueError } from trb/http
import trb/internal/runtime

record Request
	method: String
	path: String
	query_string: String
	headers: Headers
	body: Body
end

record RequestCookie
	name: String
	value: String
end

enum QueryValueError
	Malformed(error: PercentDecodeError)
	Missing(name: String)
	Duplicate(name: String)
end

enum CookieValueError
	Missing(name: String)
	Duplicate(name: String)
end

enum RequestError
	MissingContentType
	DuplicateContentType
	UnsupportedContentType(value: String)
	InvalidUtf8
	InvalidJson(error: JsonError)
end

record ServerConfig
	host: String
	port: Integer
	body_limit_bytes: Integer
	shutdown_timeout_milliseconds: Integer
end

def configure_server(
		host:: String = "0.0.0.0",
		port:: Integer = 3000,
		body_limit_bytes:: Integer = 1048576,
		shutdown_timeout_milliseconds:: Integer = 10000,
	): ServerConfig
	return ServerConfig.new(
		host: host,
		port: port,
		body_limit_bytes: body_limit_bytes,
		shutdown_timeout_milliseconds: shutdown_timeout_milliseconds,
	)
end

enum CookieSameSite
	Lax
	Strict
	None
end

enum ResponseCookieAttribute
	Domain(value: String)
	Path(value: String)
	MaxAge(seconds: Integer)
	Secure
	HttpOnly
	SameSite(value: CookieSameSite)
end

record ResponseCookie
	name: String
	value: String
	attributes: Array<ResponseCookieAttribute>
end

record Context
	request: Request
	path_parameters: Hash<String, String>
end

record Response
	status: Integer
	headers: Headers
	body: Body
end

def text(value: String, status: Integer = 200): Response
	return Response.new(
		status: status,
		headers: Headers.new([Header.new(name: "content-type", value: "text/plain; charset=utf-8")]),
		body: Body.new(value.to_bytes()),
	)
end

def bytes(value: Bytes, status: Integer = 200): Response
	return Response.new(
		status: status,
		headers: Headers.new([Header.new(name: "content-type", value: "application/octet-stream")]),
		body: Body.new(value),
	)
end

def empty(status: Integer = 204): Response
	return Response.new(status: status, headers: Headers.new(), body: Body.empty())
end

def with_header(response: Response, name: String, value: String): Response
	return Response.new(status: response.status, headers: response.headers.with(name, value), body: response.body)
end

def add_header(response: Response, name: String, value: String): Response
	return Response.new(status: response.status, headers: response.headers.add(name, value), body: response.body)
end

def without_header(response: Response, name: String): Response
	return Response.new(status: response.status, headers: response.headers.without(name), body: response.body)
end

def with_status(response: Response, status: Integer): Response
	return Response.new(status: status, headers: response.headers, body: response.body)
end

def redirect(location: String, status: Integer = 302): Response
	return with_header(empty(status), "location", location)
end

def response_header_values(response: Response, name: String): Array<String>
	return response.headers.values(name)
end

def response_header_value(response: Response, name: String): Result<String, HeaderValueError>
	return response.headers.value(name)
end

def vary(response: Response, field: String): Response
	normalized_field := field.strip().downcase()
	if normalized_field == ""
		return response
	end
	response_header_values(response, "vary").each do |value|
		value.split(",").each do |existing_field|
			normalized_existing := existing_field.strip().downcase()
			if normalized_existing == "*" || normalized_existing == normalized_field
				return response
			end
		end
	end
	if normalized_field == "*"
		return with_header(response, "vary", "*")
	end
	return add_header(response, "vary", field.strip())
end

def with_request_header(request: Request, name: String, value: String): Request
	return Request.new(
		method: request.method,
		path: request.path,
		query_string: request.query_string,
		headers: request.headers.with(name, value),
		body: request.body,
	)
end

def add_request_header(request: Request, name: String, value: String): Request
	return Request.new(
		method: request.method,
		path: request.path,
		query_string: request.query_string,
		headers: request.headers.add(name, value),
		body: request.body,
	)
end

def without_request_header(request: Request, name: String): Request
	return Request.new(
		method: request.method,
		path: request.path,
		query_string: request.query_string,
		headers: request.headers.without(name),
		body: request.body,
	)
end

def new_response_cookie(name: String, value: String): ResponseCookie
	return ResponseCookie.new(name: name, value: value, attributes: [])
end

def set_cookie(response: Response, cookie_value: ResponseCookie): Response
	if !_valid_response_cookie?(cookie_value)
		return runtime.fail<Response>("trb/web response cookie is invalid")
	end
	prefix := cookie_value.name + "="
	response_header_values(response, "set-cookie").each do |existing_value|
		if existing_value.start_with?(prefix)
			return runtime.fail<Response>("trb/web response contains duplicate cookie name")
		end
	end
	mut parts := [cookie_value.name + "=" + cookie_value.value]
	cookie_value.attributes.each do |attribute|
		parts.push(_response_cookie_attribute(attribute))
	end
	return add_header(response, "set-cookie", parts.join("; "))
end

def _valid_response_cookie?(cookie_value: ResponseCookie): Boolean
	if !_valid_cookie_name?(cookie_value.name) || !_valid_cookie_value?(cookie_value.value)
		return false
	end
	mut seen: Hash<String, Boolean> := {}
	mut secure := false
	mut has_domain := false
	mut has_path := false
	mut path := ""
	mut same_site_none := false
	cookie_value.attributes.each do |attribute|
		name := _response_cookie_attribute_name(attribute)
		if seen.key?(name)
			return false
		end
		seen[name] = true
		case attribute
		when ResponseCookieAttribute::Domain(value)
			if !_valid_cookie_domain?(value)
				return false
			end
			has_domain = true
		when ResponseCookieAttribute::Path(value)
			if !_valid_cookie_path?(value)
				return false
			end
			has_path = true
			path = value
		when ResponseCookieAttribute::MaxAge(seconds)
			if seconds < 0
				return false
			end
		when ResponseCookieAttribute::Secure
			secure = true
		when ResponseCookieAttribute::HttpOnly
		when ResponseCookieAttribute::SameSite(value)
			if value == CookieSameSite::None
				same_site_none = true
			end
		end
	end
	if same_site_none && !secure
		return false
	end
	normalized_name := cookie_value.name.downcase()
	if normalized_name.start_with?("__secure-") && !secure
		return false
	end
	if normalized_name.start_with?("__host-")
		if !secure || has_domain || !has_path || path != "/"
			return false
		end
	end
	return true
end

def _valid_cookie_name?(value: String): Boolean
	if value == ""
		return false
	end
	value.codepoints().each do |codepoint|
		letter := codepoint >= 65 && codepoint <= 90 || codepoint >= 97 && codepoint <= 122
		digit := codepoint >= 48 && codepoint <= 57
		symbol := codepoint == 33 || codepoint >= 35 && codepoint <= 39 || codepoint == 42 || codepoint == 43 || codepoint == 45 || codepoint == 46 || codepoint == 94 || codepoint == 95 || codepoint == 96 || codepoint == 124 || codepoint == 126
		if !letter && !digit && !symbol
			return false
		end
	end
	return true
end

def _valid_cookie_value?(value: String): Boolean
	value.codepoints().each do |codepoint|
		allowed := codepoint == 33 || codepoint >= 35 && codepoint <= 43 || codepoint >= 45 && codepoint <= 58 || codepoint >= 60 && codepoint <= 91 || codepoint >= 93 && codepoint <= 126
		if !allowed
			return false
		end
	end
	return true
end

def _valid_cookie_domain?(value: String): Boolean
	if value == "" || value.size() > 253 || value.start_with?(".") || value.end_with?(".")
		return false
	end
	value.split(".").each do |label|
		codepoints := label.codepoints()
		if codepoints.empty?() || codepoints.size() > 63 || codepoints[0] == 45 || codepoints[codepoints.size() - 1] == 45
			return false
		end
		codepoints.each do |codepoint|
			letter := codepoint >= 65 && codepoint <= 90 || codepoint >= 97 && codepoint <= 122
			digit := codepoint >= 48 && codepoint <= 57
			if !letter && !digit && codepoint != 45
				return false
			end
		end
	end
	return true
end

def _valid_cookie_path?(value: String): Boolean
	if !value.start_with?("/")
		return false
	end
	value.codepoints().each do |codepoint|
		if !(codepoint >= 32 && codepoint <= 58 || codepoint >= 60 && codepoint <= 126)
			return false
		end
	end
	return true
end

def _response_cookie_attribute_name(attribute: ResponseCookieAttribute): String
	case attribute
	when ResponseCookieAttribute::Domain(_value)
		return "domain"
	when ResponseCookieAttribute::Path(_value)
		return "path"
	when ResponseCookieAttribute::MaxAge(_seconds)
		return "max-age"
	when ResponseCookieAttribute::Secure
		return "secure"
	when ResponseCookieAttribute::HttpOnly
		return "httponly"
	when ResponseCookieAttribute::SameSite(_value)
		return "samesite"
	end
end

def _response_cookie_attribute(attribute: ResponseCookieAttribute): String
	case attribute
	when ResponseCookieAttribute::Domain(value)
		return "Domain=" + value
	when ResponseCookieAttribute::Path(value)
		return "Path=" + value
	when ResponseCookieAttribute::MaxAge(seconds)
		return "Max-Age=" + seconds.to_s()
	when ResponseCookieAttribute::Secure
		return "Secure"
	when ResponseCookieAttribute::HttpOnly
		return "HttpOnly"
	when ResponseCookieAttribute::SameSite(value)
		return "SameSite=" + _cookie_same_site(value)
	end
end

def _cookie_same_site(value: CookieSameSite): String
	case value
	when CookieSameSite::Lax
		return "Lax"
	when CookieSameSite::Strict
		return "Strict"
	when CookieSameSite::None
		return "None"
	end
end

interface Next
	call(context: Context): Response
end

def path_param(context: Context, name: String): String
	return context.path_parameters[name]
end

def query_parameters(request: Request): Result<Array<QueryParameter>, PercentDecodeError>
	return parse_query(request.query_string)
end

def query_values(request: Request, name: String): Result<Array<String>, PercentDecodeError>
	case query_parameters(request)
	when Result::Ok(parameters)
		mut values: Array<String> := []
		parameters.each do |parameter|
			if parameter.name == name
				values.push(parameter.value)
			end
		end
		return Result<Array<String>, PercentDecodeError>::Ok(values)
	when Result::Err(error)
		return Result<Array<String>, PercentDecodeError>::Err(error)
	end
end

def query_value(request: Request, name: String): Result<String, QueryValueError>
	case query_values(request, name)
	when Result::Ok(values)
		if values.empty?()
			return Result<String, QueryValueError>::Err(QueryValueError::Missing(name))
		end
		if values.size() > 1
			return Result<String, QueryValueError>::Err(QueryValueError::Duplicate(name))
		end
		return Result<String, QueryValueError>::Ok(values[0])
	when Result::Err(error)
		return Result<String, QueryValueError>::Err(QueryValueError::Malformed(error))
	end
end

def header_values(request: Request, name: String): Array<String>
	return request.headers.values(name)
end

def header_value(request: Request, name: String): Result<String, HeaderValueError>
	return request.headers.value(name)
end

def cookies(request: Request): Array<RequestCookie>
	mut result: Array<RequestCookie> := []
	header_values(request, "cookie").each do |header|
		header.split(";").each do |part|
			pair := part.strip()
			if pair == ""
				next
			end
			parts := pair.split("=")
			if parts.size() < 2
				next
			end
			name := parts.first().strip()
			if name == ""
				next
			end
			mut value_parts := parts.dup()
			value_parts.shift()
			value := value_parts.join("=").strip()
			result.push(RequestCookie.new(name: name, value: value))
		end
	end
	return result
end

def cookie(request: Request, name: String): String?
	cookies(request).each do |candidate|
		if candidate.name == name
			return candidate.value
		end
	end
	return nil
end

def cookie_values(request: Request, name: String): Array<String>
	mut values: Array<String> := []
	cookies(request).each do |candidate|
		if candidate.name == name
			values.push(candidate.value)
		end
	end
	return values
end

def cookie_value(request: Request, name: String): Result<String, CookieValueError>
	values := cookie_values(request, name)
	if values.empty?()
		return Result<String, CookieValueError>::Err(CookieValueError::Missing(name))
	end
	if values.size() > 1
		return Result<String, CookieValueError>::Err(CookieValueError::Duplicate(name))
	end
	return Result<String, CookieValueError>::Ok(values[0])
end
