import { Result } from trb/std/result
import { JsonError } from trb/std/json
import { PercentDecodeError, QueryParameter, parse_query } from trb/std/url

record Request
	method: String
	path: String
	query_string: String
	headers: Hash<String, Array<String>>
	body: Bytes
end

record RequestCookie
	name: String
	value: String
end

enum QueryValueError
	Malformed(error: PercentDecodeError)
	Missing(name: String)
	Duplicate(name: String)
end

enum HeaderValueError
	Missing(name: String)
	Duplicate(name: String)
end

enum CookieValueError
	Missing(name: String)
	Duplicate(name: String)
end

enum RequestError
	MissingContentType
	DuplicateContentType
	UnsupportedContentType(value: String)
	InvalidUtf8
	InvalidJson(error: JsonError)
end

record ServerConfig
	host: String
	port: Integer
	body_limit_bytes: Integer
	shutdown_timeout_milliseconds: Integer
end

def configure_server(
		host:: String = "0.0.0.0",
		port:: Integer = 3000,
		body_limit_bytes:: Integer = 1048576,
		shutdown_timeout_milliseconds:: Integer = 10000,
	): ServerConfig
	return ServerConfig.new(
		host: host,
		port: port,
		body_limit_bytes: body_limit_bytes,
		shutdown_timeout_milliseconds: shutdown_timeout_milliseconds,
	)
end

enum CookieSameSite
	Lax
	Strict
	None
end

enum ResponseCookieAttribute
	Domain(value: String)
	Path(value: String)
	MaxAge(seconds: Integer)
	Secure
	HttpOnly
	SameSite(value: CookieSameSite)
end

record ResponseCookie
	name: String
	value: String
	attributes: Array<ResponseCookieAttribute>
end

record Context
	request: Request
	path_parameters: Hash<String, String>
end

record Response
	status: Integer
	headers: Hash<String, Array<String>>
	body: Bytes
end

def text(value: String, status: Integer = 200): Response
	return Response.new(
		status: status,
		headers: { "content-type" =>["text/plain; charset=utf-8"] },
		body: value.to_bytes(),
	)
end

def bytes(value: Bytes, status: Integer = 200): Response
	return Response.new(
		status: status,
		headers: { "content-type" =>["application/octet-stream"] },
		body: value,
	)
end

def empty(status: Integer = 204): Response
	return Response.new(status: status, headers: {}, body: "".to_bytes())
end

def with_header(response: Response, name: String, value: String): Response
	normalized_name := name.downcase()
	mut headers: Hash<String, Array<String>> := {}
	response.headers.each do |header_name, values|
		if header_name.downcase() != normalized_name
			headers[header_name] = values.dup()
		end
	end
	headers[normalized_name] = [value]
	return Response.new(status: response.status, headers: headers, body: response.body)
end

def add_header(response: Response, name: String, value: String): Response
	normalized_name := name.downcase()
	mut headers: Hash<String, Array<String>> := {}
	mut added_values: Array<String> := []
	response.headers.each do |header_name, values|
		if header_name.downcase() == normalized_name
			values.each do |existing_value|
				added_values.push(existing_value)
			end
		else
			headers[header_name] = values.dup()
		end
	end
	added_values.push(value)
	headers[normalized_name] = added_values
	return Response.new(status: response.status, headers: headers, body: response.body)
end

def without_header(response: Response, name: String): Response
	normalized_name := name.downcase()
	mut headers: Hash<String, Array<String>> := {}
	response.headers.each do |header_name, values|
		if header_name.downcase() != normalized_name
			headers[header_name] = values.dup()
		end
	end
	return Response.new(status: response.status, headers: headers, body: response.body)
end

def with_status(response: Response, status: Integer): Response
	mut headers: Hash<String, Array<String>> := {}
	response.headers.each do |header_name, values|
		headers[header_name] = values.dup()
	end
	return Response.new(status: status, headers: headers, body: response.body)
end

def redirect(location: String, status: Integer = 302): Response
	return with_header(empty(status), "location", location)
end

def response_header_values(response: Response, name: String): Array<String>
	normalized_name := name.downcase()
	mut result: Array<String> := []
	response.headers.each do |header_name, values|
		if header_name.downcase() == normalized_name
			values.each do |value|
				result.push(value)
			end
		end
	end
	return result
end

def vary(response: Response, field: String): Response
	normalized_field := field.strip().downcase()
	if normalized_field == ""
		return response
	end
	response_header_values(response, "vary").each do |value|
		value.split(",").each do |existing_field|
			normalized_existing := existing_field.strip().downcase()
			if normalized_existing == "*" || normalized_existing == normalized_field
				return response
			end
		end
	end
	if normalized_field == "*"
		return with_header(response, "vary", "*")
	end
	return add_header(response, "vary", field.strip())
end

def with_request_header(request: Request, name: String, value: String): Request
	normalized_name := name.downcase()
	mut headers: Hash<String, Array<String>> := {}
	request.headers.each do |header_name, values|
		if header_name.downcase() != normalized_name
			headers[header_name] = values.dup()
		end
	end
	headers[normalized_name] = [value]
	return Request.new(
		method: request.method,
		path: request.path,
		query_string: request.query_string,
		headers: headers,
		body: request.body,
	)
end

def new_response_cookie(name: String, value: String): ResponseCookie
	return ResponseCookie.new(name: name, value: value, attributes: [])
end

def set_cookie(response: Response, cookie_value: ResponseCookie): Response
	mut parts := [cookie_value.name + "=" + cookie_value.value]
	cookie_value.attributes.each do |attribute|
		parts.push(_response_cookie_attribute(attribute))
	end
	return add_header(response, "set-cookie", parts.join("; "))
end

def _response_cookie_attribute(attribute: ResponseCookieAttribute): String
	case attribute
	when ResponseCookieAttribute::Domain(value)
		return "Domain=" + value
	when ResponseCookieAttribute::Path(value)
		return "Path=" + value
	when ResponseCookieAttribute::MaxAge(seconds)
		return "Max-Age=" + seconds.to_s()
	when ResponseCookieAttribute::Secure
		return "Secure"
	when ResponseCookieAttribute::HttpOnly
		return "HttpOnly"
	when ResponseCookieAttribute::SameSite(value)
		return "SameSite=" + _cookie_same_site(value)
	end
end

def _cookie_same_site(value: CookieSameSite): String
	case value
	when CookieSameSite::Lax
		return "Lax"
	when CookieSameSite::Strict
		return "Strict"
	when CookieSameSite::None
		return "None"
	end
end

interface Next
	call(context: Context): Response
end

def path_param(context: Context, name: String): String
	return context.path_parameters[name]
end

def query_parameters(request: Request): Result<Array<QueryParameter>, PercentDecodeError>
	return parse_query(request.query_string)
end

def query_values(request: Request, name: String): Result<Array<String>, PercentDecodeError>
	case query_parameters(request)
	when Result::Ok(parameters)
		mut values: Array<String> := []
		parameters.each do |parameter|
			if parameter.name == name
				values.push(parameter.value)
			end
		end
		return Result<Array<String>, PercentDecodeError>::Ok(values)
	when Result::Err(error)
		return Result<Array<String>, PercentDecodeError>::Err(error)
	end
end

def query_value(request: Request, name: String): Result<String, QueryValueError>
	case query_values(request, name)
	when Result::Ok(values)
		if values.empty?()
			return Result<String, QueryValueError>::Err(QueryValueError::Missing(name))
		end
		if values.size() > 1
			return Result<String, QueryValueError>::Err(QueryValueError::Duplicate(name))
		end
		return Result<String, QueryValueError>::Ok(values[0])
	when Result::Err(error)
		return Result<String, QueryValueError>::Err(QueryValueError::Malformed(error))
	end
end

def header_values(request: Request, name: String): Array<String>
	normalized_name := name.downcase()
	mut result: Array<String> := []
	request.headers.each do |header_name, values|
		if header_name.downcase() == normalized_name
			values.each do |value|
				result.push(value)
			end
		end
	end
	return result
end

def header_value(request: Request, name: String): Result<String, HeaderValueError>
	values := header_values(request, name)
	if values.empty?()
		return Result<String, HeaderValueError>::Err(HeaderValueError::Missing(name))
	end
	if values.size() > 1
		return Result<String, HeaderValueError>::Err(HeaderValueError::Duplicate(name))
	end
	return Result<String, HeaderValueError>::Ok(values[0])
end

def cookies(request: Request): Array<RequestCookie>
	mut result: Array<RequestCookie> := []
	header_values(request, "cookie").each do |header|
		header.split(";").each do |part|
			pair := part.strip()
			if pair == ""
				next
			end
			parts := pair.split("=")
			if parts.size() < 2
				next
			end
			name := parts.first().strip()
			if name == ""
				next
			end
			mut value_parts := parts.dup()
			value_parts.shift()
			value := value_parts.join("=").strip()
			result.push(RequestCookie.new(name: name, value: value))
		end
	end
	return result
end

def cookie(request: Request, name: String): String?
	cookies(request).each do |candidate|
		if candidate.name == name
			return candidate.value
		end
	end
	return nil
end

def cookie_values(request: Request, name: String): Array<String>
	mut values: Array<String> := []
	cookies(request).each do |candidate|
		if candidate.name == name
			values.push(candidate.value)
		end
	end
	return values
end

def cookie_value(request: Request, name: String): Result<String, CookieValueError>
	values := cookie_values(request, name)
	if values.empty?()
		return Result<String, CookieValueError>::Err(CookieValueError::Missing(name))
	end
	if values.size() > 1
		return Result<String, CookieValueError>::Err(CookieValueError::Duplicate(name))
	end
	return Result<String, CookieValueError>::Ok(values[0])
end
