import { Result } from trb/std/result
import { PercentDecodeError, QueryParameter, parse_query } from trb/std/url

record Request
	method: String
	path: String
	query_string: String
	headers: Hash<String, Array<String>>
	body: Bytes
end

record RequestCookie
	name: String
	value: String
end

record Context
	request: Request
	path_parameters: Hash<String, String>
end

record Response
	status: Integer
	headers: Hash<String, Array<String>>
	body: Bytes
end

def with_header(response: Response, name: String, value: String): Response
	normalized_name := name.downcase()
	mut headers: Hash<String, Array<String>> := {}
	response.headers.each do |header_name, values|
		if header_name.downcase() != normalized_name
			headers[header_name] = values.dup()
		end
	end
	headers[normalized_name] = [value]
	return Response.new(status: response.status, headers: headers, body: response.body)
end

def add_header(response: Response, name: String, value: String): Response
	normalized_name := name.downcase()
	mut headers: Hash<String, Array<String>> := {}
	mut added_values: Array<String> := []
	response.headers.each do |header_name, values|
		if header_name.downcase() == normalized_name
			values.each do |existing_value|
				added_values.push(existing_value)
			end
		else
			headers[header_name] = values.dup()
		end
	end
	added_values.push(value)
	headers[normalized_name] = added_values
	return Response.new(status: response.status, headers: headers, body: response.body)
end

interface Next
	call(context: Context): Response
end

def path_param(context: Context, name: String): String
	return context.path_parameters[name]
end

def query_parameters(request: Request): Result<Array<QueryParameter>, PercentDecodeError>
	return parse_query(request.query_string)
end

def header_values(request: Request, name: String): Array<String>
	normalized_name := name.downcase()
	mut result: Array<String> := []
	request.headers.each do |header_name, values|
		if header_name.downcase() == normalized_name
			values.each do |value|
				result.push(value)
			end
		end
	end
	return result
end

def cookies(request: Request): Array<RequestCookie>
	mut result: Array<RequestCookie> := []
	header_values(request, "cookie").each do |header|
		header.split(";").each do |part|
			pair := part.strip()
			if pair == ""
				next
			end
			parts := pair.split("=")
			if parts.size() < 2
				next
			end
			name := parts.first().strip()
			if name == ""
				next
			end
			mut value_parts := parts.dup()
			value_parts.shift()
			value := value_parts.join("=").strip()
			result.push(RequestCookie.new(name: name, value: value))
		end
	end
	return result
end

def cookie(request: Request, name: String): String?
	cookies(request).each do |candidate|
		if candidate.name == name
			return candidate.value
		end
	end
	return nil
end
