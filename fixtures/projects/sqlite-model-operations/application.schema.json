          "type": "Integer",
          "primaryKey": true,
          "generated": true
        },
        "passed": {
          "type": "Boolean",
          "hasDefault": true
        },
        "rating": {
          "type": "Float"
        },
        "payload": {
          "type": "Bytes",
          "nullable": true
        }
      },
      "uniqueConstraints": {
        "primary:id": {
          "primary": true,
          "columns": [
            "id"
          ]
        }
      }
    },
    "tags": {
      "columns": {
