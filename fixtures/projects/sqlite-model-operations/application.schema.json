          "primaryKey": true,
          "generated": true
        },
        "on_date": {
          "type": "Date"
        },
        "at_time": {
          "type": "TimeOfDay"
        },
        "local_at": {
          "type": "DateTime"
        },
        "exact_at": {
          "type": "Instant"
        },
        "optional_at": {
          "type": "DateTime",
          "nullable": true
        }
      },
      "uniqueConstraints": {
        "primary:id": {
          "primary": true,
          "columns": [
            "id"
          ]
        }
      }
    },
    "observations": {
      "columns": {
        "id": {"type": "Integer", "primaryKey": true, "generated": true},
        "label": {"type": "String"},
