import { has_diagnostic } from state/state
import { emit_qbe } from compiler
import { MirFunction, mir_function_index } from mir/model/module
import { verify_mir } from mir/verify/module
import { load_integer, load_string, store_string } from support/storage
import { describe, expect, test } from trb/std/test
import { control_test_output, control_test_state } from testing/mir/control

describe("general scalar MIR control") do
	test("checks nested branches, elsif, early returns and continuing joins") do
		mut bodies := [
			"\tif value < 0\n\t\treturn -value\n\telse\n\t\treturn value + 1\n\tend",
			"\toffset := value + 1\n\tif value < 0\n\t\tif offset == 0\n\t\t\treturn 4\n\t\tend\n\t\treturn offset\n\telsif value == 0\n\t\treturn 7\n\tend\n\treturn offset * 2",
			"\tif value < 0\n\t\t_unused := value + 1\n\telse\n\t\t_unused := value + 2\n\tend\n\treturn value",
		]
		bodies.push("\tmut total := value\n\tif value < 0\n\t\ttotal = -value\n\telse\n\t\ttotal += 2\n\tend\n\treturn total")
		bodies.push("\tmut total := 0\n\tmut i := 0\n\twhile i < value\n\t\ti += 1\n\t\tif i == 2\n\t\t\tnext\n\t\tend\n\t\tlocal := i * 2\n\t\tif i > 5\n\t\t\tbreak\n\t\tend\n\t\ttotal += local\n\tend\n\treturn total")
		bodies.push("\tmut total := 0\n\tmut i := 0\n\twhile i < value\n\t\tmut j := 0\n\t\twhile j < i\n\t\t\tj += 1\n\t\t\tif j == 2\n\t\t\t\tbreak\n\t\t\tend\n\t\t\ttotal += j\n\t\tend\n\t\ti += 1\n\tend\n\treturn total")
		bodies.each do |body|
			state := control_test_state(body)
			expect(has_diagnostic(state)).to_be_false()
			index := mir_function_index(state.scalar_mir, 0)
			expect(index >= 0).to_be_true()
			if index >= 0
				expect(state.scalar_mir.functions[index].kind).to_equal(3)
				expect(verify_mir(state.scalar_mir, true)).to_equal("")
			end
		end
	end

	test("emits checked control and values without reading the source body again") do
		mut state := control_test_state("\toffset := value + 1\n\tif offset < 3\n\t\treturn offset\n\tend\n\treturn offset * 2")
		expect(has_diagnostic(state)).to_be_false()
		before := control_test_output(emit_qbe(state))
		mut index := load_integer(state.declarations.function_body_starts, 0)
		while index < load_integer(state.declarations.function_body_ends, 0)
			store_string(state.source_tokens.token_texts, index, "unavailable")
			index += 1
		end
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		expect(before.include?("@mir_")).to_be_true()
	end

	test("rejects a control edge whose live argument is unavailable") do
		mut state := control_test_state("\toffset := value + 1\n\tif offset < 3\n\t\treturn offset\n\tend\n\treturn offset * 2")
		function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, 0)]
		entry := state.scalar_mir.blocks[function.block_start]
		mut arguments := state.scalar_mir.arguments
		arguments[entry.first_argument_start] = 9007199254740991
		expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
	end

	test("rejects selecting the induction adapter for a general conditional") do
		mut state := control_test_state("\tif value < 0\n\t\treturn -value\n\telse\n\t\treturn value\n\tend")
		index := mir_function_index(state.scalar_mir, 0)
		function := state.scalar_mir.functions[index]
		state.scalar_mir.functions[index] = MirFunction.new(kind: 2, result_type: function.result_type, integer_guard: 0, id: function.id, entry_block: function.entry_block, source_id: function.source_id, line: function.line, parameter_start: function.parameter_start, parameter_count: function.parameter_count, block_start: function.block_start, block_count: function.block_count)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR function adapter kind is invalid")
	end
	test("diagnoses an assignment to a computed expression without indexing its absent origin") do
		state := control_test_state("\tvalue + 1 = 2\n\treturn value")
		expect(has_diagnostic(state)).to_be_true()
		expect(load_string(state.diagnostics.messages, 0)).to_equal("assignment target is immutable")
	end

end
