import { orm_project_column, orm_query_columns, orm_query_roots, orm_query_type } from frontend/providers/orm_queries
import { find_object_in_module } from frontend/types/object_types
import { orm_sql_parameter, orm_time_column, orm_write_source } from frontend/providers/orm_writes
import { parse_function } from frontend/syntax/declaration_syntax
import { character_in, lex_module } from frontend/syntax/lexer
import { append_import, parse_module } from frontend/syntax/parser
import { ObjectField, ObjectMethod } from frontend/types/object_model
import { OrmColumn, OrmTable } from project/orm_schema
import { web_dispatch_quote } from project/web_dispatch_source
import { web_route_join } from project/web_route_paths
import { import_kind_named } from state/import_kinds
import { compiler_reserve_source } from state/source_capacity
import { CompilerState, add_module, diagnostic, find_module, has_diagnostic } from state/state
import { integer_string } from support/literals
import { load_integer, load_string, store_integer } from support/storage
import { unicode_identifier_part, unicode_identifier_start } from support/unicode_identifiers

# Only the provider can attach these bindings. The linked declarations keep
# their original module identities, including an application's own model.
def orm_bind(mut state: CompilerState, target: Integer, name: String, binding_name: String)
	module_id := state.module_graph.active_module[0]
	binding := append_import(state, load_string(state.module_graph.module_names, target), name, binding_name, import_kind_named(), 1)
	store_integer(state.module_graph.import_targets, binding, target)
	store_integer(state.module_graph.import_used, binding, 1)
	store_integer(state.module_graph.module_import_counts, module_id, load_integer(state.module_graph.module_import_counts, module_id) + 1)
end

def orm_add_method(mut state: CompilerState, index: Integer, source: String, name: String, receiver: String)
	row := state.nominal.objects[index]
	compiler_reserve_source(state, source.size())
	start := state.source_tokens.token_count[0]
	lex_module(state, source, state.module_graph.active_module[0])
	previous_owner := state.global_bindings.declaration_owner[0]
	state.global_bindings.declaration_owner[0] = row.name
	template := state.type_resolution.generic_functions.size()
	mut cursor := [start]
	if !has_diagnostic(state) && parse_function(state, cursor, receiver, [], true, false)
		state.nominal.objects[index].methods.push(ObjectMethod.new(name: name, class_member: receiver == "", origin: row.origin, function: -1, generic_function: template))
	end
	state.global_bindings.declaration_owner[0] = previous_owner
end

# Model reads and scalar projections must decode a stored value identically.
def orm_cell_reader(column: OrmColumn, slot: String, type_name: String, variant: String, zero: String): String
	reader := "orm_read_" + slot
	cell_result := "Result<" + type_name + ", DbError>"
	invalid := "return " + cell_result + "::Err(DbError.new(kind: DbErrorKind::InvalidData, message: invalid_message))\n"
	mut errors := "invalid_message: String = \"database row was invalid\""
	if column.type_name == "Integer"
		errors += ", overflow_message: String = \"database row was invalid\""
	end
	mut source := "def " + reader + "(raw: SQLite::Parameter, " + errors + "): " + cell_result + "\n"
	mut decoded_type := type_name
	if orm_time_column(column.type_name) && !column.nullable
		decoded_type += "?"
	end
	source += "mut " + slot + ": " + decoded_type + " := " + zero + "\ncase raw\nwhen SQLite::Parameter::" + variant + "(value)\n"
	if column.type_name == "Integer"
		source += "if value < -9007199254740991 || value > 9007199254740991\nreturn " + cell_result + "::Err(DbError.new(kind: DbErrorKind::InvalidData, message: overflow_message))\nend\n"
	end
	if orm_time_column(column.type_name)
		parser := column.type_name + ".try_parse(OrmSql.time_text("
		finish := ", " + web_dispatch_quote(column.type_name) + ")) catch |_error|\n" + invalid + "end\n"
		source += slot + " = " + parser + "value" + finish
		source += "when SQLite::Parameter::Blob(value)\n" + slot + " = " + parser + "value.to_s()" + finish
	elsif column.type_name == "Boolean"
		source += "if value != 0 && value != 1\n" + invalid + "end\n" + slot + " = value == 1\n"
	else
		source += slot + " = value\n"
	end
	if column.type_name == "Float"
		source += "when SQLite::Parameter::Integer(value)\n" + slot + " = value.to_f()\n"
	elsif column.type_name == "Boolean"
		text_bool := "if parsed == nil\n" + invalid + "end\n" + slot + " = parsed\n"
		source += "when SQLite::Parameter::Text(value)\nparsed := OrmSql.boolean_value(value)\n" + text_bool
		source += "when SQLite::Parameter::Blob(value)\nparsed := OrmSql.boolean_value(value.to_s())\n" + text_bool
	elsif column.type_name == "Bytes"
		source += "when SQLite::Parameter::Text(value)\n" + slot + " = value.to_bytes()\n"
	end
	if column.nullable
		source += "when SQLite::Parameter::Null\n"
	end
	source += "else\n" + invalid + "end\n"
	if orm_time_column(column.type_name) && !column.nullable
		source += "if " + slot + " == nil\n" + invalid + "end\n"
	end
	source += "return " + cell_result + "::Ok(" + slot + ")\nend\n"
	return source
end

def orm_lookup_methods(mut state: CompilerState, index: Integer, table: OrmTable, database: String, environment: String)
	row := state.nominal.objects[index]
	mut key := ""
	mut primary_columns := 0
	mut key_type := ""
	mut nullable_key := false
	mut requires_row := false
	mut time_types: Hash<String, Integer> := {}
	mut fields := "record OrmRowValues\nscope: Integer\n"
	mut defaults := ["scope: 0"]
	mut arguments := ["scope: scope"]
	mut columns: Array<String> := []
	mut initialize := ""
	mut decode := ""
	mut readers := ""
	connection := web_dispatch_quote(database) + ", " + web_dispatch_quote(environment)
	result := "Result<OrmModelType?, DbError>"
	model_result := "Result<OrmModelType, DbError>"
	row.methods.each do |method|
		if !method.class_member && method.name == "initialize"
			return
		end
	end
	mut position := 0
	while position < table.columns.size()
		column := table.columns[position]
		if column.name == "" || (!character_in(column.name[0], "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_") && !unicode_identifier_start(column.name[0]))
			return
		end
		mut letter := 1
		while letter < column.name.size()
			if !character_in(column.name[letter], "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789") && !unicode_identifier_part(column.name[letter])
				return
			end
			letter += 1
		end
		mut variant := "Text"
		mut zero := "\"\""
		if column.type_name == "Integer"
			variant = "Integer"
			zero = "0"
		elsif column.type_name == "Boolean"
			variant = "Integer"
			zero = "false"
		elsif column.type_name == "Float"
			variant = "Float"
			zero = "0.0"
		elsif column.type_name == "Bytes"
			variant = "Blob"
			zero = "\"\".to_bytes()"
		elsif orm_time_column(column.type_name)
			zero = "nil"
			time_types[column.type_name] = 1
			if !column.nullable
				requires_row = true
			end
		elsif column.type_name != "String"
			return
		end
		if column.primary_key
			primary_columns += 1
			key = column.name
			key_type = column.type_name
			nullable_key = column.nullable
		end
		slot := "v" + integer_string(position)
		mut type_name := column.type_name
		if column.nullable
			type_name += "?"
			zero = "nil"
		end
		fields += slot + ": " + type_name + "\n"
		defaults.push(slot + ": " + zero)
		arguments.push(slot + ": " + slot)
		columns.push("\"" + column.name + "\"")
		initialize += "@" + column.name + " = values." + slot + "\n"
		readers += orm_cell_reader(column, slot, type_name, variant, zero)
		readers += orm_project_column(table.name, column, connection, slot, type_name)
		decode += slot + " := try orm_read_" + slot + "(raw[" + integer_string(position) + "])\n"
		position += 1
	end
	if primary_columns != 1
		key = ""
	end
	mut scope_field := "_orm_scope"
	mut collision := true
	while collision
		collision = false
		row.fields.each do |field|
			if field.name == "@" + scope_field
				scope_field += "_"
				collision = true
			end
		end
	end
	state.nominal.objects[index].fields.push(ObjectField.new(name: "@" + scope_field, type_name: "Integer", line: row.line, origin: row.origin, readonly: true, default_start: -1, default_finish: -1))
	initialize += "@" + scope_field + " = values.scope\n"
	fields += "end\n" + readers
	fields += "def orm_read(raw: Array<SQLite::Parameter>, scope: Integer): " + model_result + "\n" + decode
	fields += "return " + model_result + "::Ok(OrmModelType.new(OrmRowValues.new(" + web_route_join(arguments, ", ") + ")))\nend\n"
	writes := orm_write_source(table, connection, web_route_join(columns, ", "), key, row.name + "Changes", scope_field)
	fields += writes.declarations
	fields += orm_query_type(table, connection, web_route_join(columns, ", "))
	if key != ""
		fields += "def orm_key(model: OrmModelType): SQLite::Parameter\nvalue := model." + key + "\n"
		if nullable_key
			fields += "if value == nil\nreturn SQLite::Parameter::Null\nend\n"
		end
		fields += "return " + orm_sql_parameter(key_type, "value") + "\nend\n"
		statement := "SELECT " + web_route_join(columns, ", ") + " FROM \"" + table.name + "\" WHERE \"" + key + "\" = ? LIMIT 1"
		mut body := "def orm_find(scope: Integer, key: " + key_type + "): " + result + "\n"
		body += "raw := OrmSql.lookup(" + web_dispatch_quote(database) + ", " + web_dispatch_quote(environment) + ", " + web_dispatch_quote(statement) + ", " + orm_sql_parameter(key_type, "key") + ", " + integer_string(position) + ", scope) catch |error|\nreturn " + result + "::Err(error)\nend\n"
		body += "if raw == nil\nreturn " + result + "::Ok(nil)\nend\n"
		body += "item := orm_read(raw, scope) catch |error|\nreturn " + result + "::Err(error)\nend\nreturn " + result + "::Ok(item)\nend\n"
		fields += body
	end
	fields += "class OrmScope\nreadonly @_scope: Integer\ndef initialize(scope: Integer)\n@_scope = scope\nend\n"
	if key != ""
		fields += "def find(key: " + key_type + "): " + result + "\nreturn orm_find(@_scope, key)\nend\n"
	end
	count := web_dispatch_quote("SELECT count(*) FROM \"" + table.name + "\"")
	fields += "def count(): Result<Integer, DbError>\nreturn OrmSql.count_rows(" + connection + ", " + count + ", @_scope)\nend\n" + writes.scoped_create + "end\n"
	compiler_reserve_source(state, fields.size())
	generated := add_module(state, "$orm:" + integer_string(index), "<SQLite model " + row.name + ">")
	start := state.source_tokens.token_count[0]
	state.module_graph.orm_model_modules.push(generated)
	lex_module(state, fields, generated)
	if has_diagnostic(state) || !parse_module(state, start, generated)
		return
	end
	orm := find_module(state, "trb/orm/index")
	sqlite := find_module(state, "trb/internal/sqlite/index")
	runtime := find_module(state, "trb/internal/orm/sql/index")
	results := find_module(state, "trb/std/result/index")
	if orm < 0 || sqlite < 0 || runtime < 0 || results < 0
		diagnostic(state, "TRBN4003", row.line, "missing owned SQLite model lookup runtime")
		return
	end
	orm_bind(state, row.source_id, row.name, "OrmModelType")
	orm_bind(state, orm, "Transaction", "Transaction")
	orm_bind(state, orm, "DbError", "DbError")
	orm_bind(state, orm, "DbErrorKind", "DbErrorKind")
	orm_bind(state, results, "Result", "Result")
	orm_bind(state, sqlite, "SQLite", "SQLite")
	orm_bind(state, runtime, "OrmSql", "OrmSql")
	time := find_module(state, "trb/std/time/index")
	["Date", "TimeOfDay", "DateTime", "Instant"].each do |name|
		if time_types.key?(name)
			orm_bind(state, time, name, name)
		end
	end
	query_type := find_object_in_module(state, generated, "OrmQuery")
	scope_type := find_object_in_module(state, generated, "OrmScope")
	orm_query_columns(table, key).each do |method|
		orm_add_method(state, query_type, method.source, method.name, "OrmQuery")
	end
	orm_query_roots("@_scope", "").each do |method|
		orm_add_method(state, scope_type, method.source, method.name, "OrmScope")
	end
	orm_query_roots("0", "self.").each do |method|
		orm_add_method(state, index, method.source, method.name, "")
	end
	mut initializer := "values: OrmRowValues"
	if !requires_row
		initializer += " = OrmRowValues.new(" + web_route_join(defaults, ", ") + ")"
	end
	orm_add_method(state, index, "def initialize(" + initializer + ")\n" + initialize + "end\n", "initialize", "OrmModelType")
	orm_add_method(state, index, "def self.using(tx: Transaction): OrmScope\nreturn OrmScope.new(OrmSql.scope_id(tx))\nend\n", "using", "")
	if key == ""
		return
	end
	orm_add_method(state, index, "def self.find(key: " + key_type + "): " + result + "\nreturn orm_find(0, key)\nend\n", "find", "")
	if writes.create_method != ""
		orm_add_method(state, index, writes.create_method, "create", "")
		orm_add_method(state, index, writes.with_method, "with", "OrmModelType")
		orm_add_method(state, index, writes.update_method, "update", "OrmModelType")
	end
	remove := "DELETE FROM \"" + table.name + "\" WHERE \"" + key + "\" = ?"
	deletion := "def delete(): Result<Boolean, DbError>\nreturn OrmSql.delete_row(" + connection + ", " + web_dispatch_quote(remove) + ", orm_key(self), @" + scope_field + ")\nend\n"
	orm_add_method(state, index, deletion, "delete", "OrmModelType")
end

# Only the verified ORM provider issues or reads the pinned declaration's lease.
def declare_orm_transaction(mut state: CompilerState, owner: Integer)
	transaction := find_object_in_module(state, owner, "Transaction")
	if transaction >= 0
		row := state.nominal.objects[transaction]
		state.nominal.objects[transaction].fields.push(ObjectField.new(name: "@_orm_lease", type_name: "OrmSql::Lease?", line: row.line, origin: row.origin, readonly: true, default_start: -1, default_finish: -1))
		orm_add_method(state, transaction, "def initialize(lease: OrmSql::Lease? = nil)\n@_orm_lease = lease\nend\n", "initialize", "Transaction")
	end
end
