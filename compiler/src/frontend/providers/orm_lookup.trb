import { orm_write_source } from frontend/providers/orm_writes
import { parse_function } from frontend/syntax/declaration_syntax
import { character_in, lex_module } from frontend/syntax/lexer
import { append_import, parse_module } from frontend/syntax/parser
import { ObjectMethod } from frontend/types/object_model
import { OrmTable } from project/orm_schema
import { web_dispatch_quote } from project/web_dispatch_source
import { web_route_join } from project/web_route_paths
import { import_kind_named } from state/import_kinds
import { compiler_reserve_source } from state/source_capacity
import { CompilerState, add_module, diagnostic, find_module, has_diagnostic } from state/state
import { integer_string } from support/literals
import { load_integer, load_string, store_integer } from support/storage
import { unicode_identifier_part, unicode_identifier_start } from support/unicode_identifiers

# Only the provider can attach these bindings. The linked declarations keep
# their original module identities, including an application's own model.
def orm_bind(mut state: CompilerState, target: Integer, name: String, binding_name: String)
	module_id := state.module_graph.active_module[0]
	binding := append_import(state, load_string(state.module_graph.module_names, target), name, binding_name, import_kind_named(), 1)
	store_integer(state.module_graph.import_targets, binding, target)
	store_integer(state.module_graph.import_used, binding, 1)
	store_integer(state.module_graph.module_import_counts, module_id, load_integer(state.module_graph.module_import_counts, module_id) + 1)
end

def orm_add_method(mut state: CompilerState, index: Integer, source: String, name: String, receiver: String)
	row := state.nominal.objects[index]
	compiler_reserve_source(state, source.size())
	start := state.source_tokens.token_count[0]
	lex_module(state, source, state.module_graph.active_module[0])
	previous_owner := state.global_bindings.declaration_owner[0]
	state.global_bindings.declaration_owner[0] = row.name
	template := state.type_resolution.generic_functions.size()
	mut cursor := [start]
	if !has_diagnostic(state) && parse_function(state, cursor, receiver, [], true, false)
		state.nominal.objects[index].methods.push(ObjectMethod.new(name: name, class_member: receiver == "", origin: row.origin, function: -1, generic_function: template))
	end
	state.global_bindings.declaration_owner[0] = previous_owner
end

def orm_lookup_methods(mut state: CompilerState, index: Integer, table: OrmTable, database: String, environment: String)
	row := state.nominal.objects[index]
	mut key := ""
	mut key_type := ""
	mut key_variant := ""
	mut nullable_key := false
	mut fields := "record OrmRowValues\n"
	mut defaults: Array<String> := []
	mut arguments: Array<String> := []
	mut columns: Array<String> := []
	mut initialize := ""
	mut decode := ""
	result := "Result<OrmModelType?, DbError>"
	model_result := "Result<OrmModelType, DbError>"
	invalid := "return " + model_result + "::Err(DbError.new(kind: DbErrorKind::InvalidData, message: \"database row was invalid\"))\n"
	row.methods.each do |method|
		if !method.class_member && method.name == "initialize"
			return
		end
	end
	mut position := 0
	while position < table.columns.size()
		column := table.columns[position]
		if column.name == "" || (!character_in(column.name[0], "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_") && !unicode_identifier_start(column.name[0]))
			return
		end
		mut letter := 1
		while letter < column.name.size()
			if !character_in(column.name[letter], "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789") && !unicode_identifier_part(column.name[letter])
				return
			end
			letter += 1
		end
		mut variant := "Text"
		mut zero := "\"\""
		if column.type_name == "Integer"
			variant = "Integer"
			zero = "0"
		elsif column.type_name != "String"
			return
		end
		if column.primary_key
			if key != ""
				return
			end
			key = column.name
			key_type = column.type_name
			key_variant = variant
			nullable_key = column.nullable
		end
		slot := "v" + integer_string(position)
		mut type_name := column.type_name
		if column.nullable
			type_name += "?"
			zero = "nil"
		end
		fields += slot + ": " + type_name + "\n"
		defaults.push(slot + ": " + zero)
		arguments.push(slot + ": " + slot)
		columns.push("\"" + column.name + "\"")
		initialize += "@" + column.name + " = values." + slot + "\n"
		decode += "mut " + slot + ": " + type_name + " := " + zero + "\ncase raw[" + integer_string(position) + "]\nwhen SQLite::Parameter::" + variant + "(value)\n"
		if variant == "Integer"
			decode += "if value < -9007199254740991 || value > 9007199254740991\n" + invalid + "end\n"
		end
		decode += slot + " = value\n"
		if column.nullable
			decode += "when SQLite::Parameter::Null\n"
		end
		decode += "else\n" + invalid + "end\n"
		position += 1
	end
	if key == ""
		return
	end
	fields += "end\n"
	fields += "def orm_read(raw: Array<SQLite::Parameter>): " + model_result + "\n" + decode
	fields += "return " + model_result + "::Ok(OrmModelType.new(OrmRowValues.new(" + web_route_join(arguments, ", ") + ")))\nend\n"
	connection := web_dispatch_quote(database) + ", " + web_dispatch_quote(environment)
	fields += "def orm_key(model: OrmModelType): SQLite::Parameter\nvalue := model." + key + "\n"
	if nullable_key
		fields += "if value == nil\nreturn SQLite::Parameter::Null\nend\n"
	end
	fields += "return SQLite::Parameter::" + key_variant + "(value)\nend\n"
	writes := orm_write_source(table, connection, web_route_join(columns, ", "), key, row.name + "Changes")
	fields += writes.declarations
	compiler_reserve_source(state, fields.size())
	generated := add_module(state, "$orm:" + integer_string(index), "<SQLite model " + row.name + ">")
	start := state.source_tokens.token_count[0]
	lex_module(state, fields, generated)
	if has_diagnostic(state) || !parse_module(state, start, generated)
		return
	end
	orm := find_module(state, "trb/orm/index")
	sqlite := find_module(state, "trb/internal/sqlite/index")
	runtime := find_module(state, "trb/internal/orm/sql/index")
	results := find_module(state, "trb/std/result/index")
	if orm < 0 || sqlite < 0 || runtime < 0 || results < 0
		diagnostic(state, "TRBN4003", row.line, "missing owned SQLite model lookup runtime")
		return
	end
	orm_bind(state, row.source_id, row.name, "OrmModelType")
	orm_bind(state, orm, "DbError", "DbError")
	orm_bind(state, orm, "DbErrorKind", "DbErrorKind")
	orm_bind(state, results, "Result", "Result")
	orm_bind(state, sqlite, "SQLite", "SQLite")
	orm_bind(state, runtime, "OrmSql", "OrmSql")
	orm_add_method(state, index, "def initialize(values: OrmRowValues = OrmRowValues.new(" + web_route_join(defaults, ", ") + "))\n" + initialize + "end\n", "initialize", "OrmModelType")
	statement := "SELECT " + web_route_join(columns, ", ") + " FROM \"" + table.name + "\" WHERE \"" + key + "\" = ? LIMIT 1"
	mut body := "def self.find(key: " + key_type + "): " + result + "\n"
	body += "raw := OrmSql.lookup(" + web_dispatch_quote(database) + ", " + web_dispatch_quote(environment) + ", " + web_dispatch_quote(statement) + ", SQLite::Parameter::" + key_variant + "(key), " + integer_string(position) + ") catch |error|\nreturn " + result + "::Err(error)\nend\n"
	body += "if raw == nil\nreturn " + result + "::Ok(nil)\nend\n"
	body += "item := orm_read(raw) catch |error|\nreturn " + result + "::Err(error)\nend\nreturn " + result + "::Ok(item)\nend\n"
	orm_add_method(state, index, body, "find", "")
	if writes.create_method != ""
		orm_add_method(state, index, writes.create_method, "create", "")
		orm_add_method(state, index, writes.with_method, "with", "OrmModelType")
		orm_add_method(state, index, writes.update_method, "update", "OrmModelType")
	end
	remove := "DELETE FROM \"" + table.name + "\" WHERE \"" + key + "\" = ?"
	deletion := "def delete(): Result<Boolean, DbError>\nreturn OrmSql.delete_row(" + connection + ", " + web_dispatch_quote(remove) + ", orm_key(self))\nend\n"
	orm_add_method(state, index, deletion, "delete", "OrmModelType")
end
