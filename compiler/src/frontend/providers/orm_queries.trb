import { orm_sql_parameter, orm_time_column } from frontend/providers/orm_writes
import { OrmColumn, OrmTable } from project/orm_schema
import { web_dispatch_quote } from project/web_dispatch_source
import { integer_string } from support/literals

record OrmQueryMethod
	name: String
	source: String
end

# Select only the requested storage column. Model reads and column projections
# share the same schema decoder, including nullable binary and temporal values.
def orm_project_column(table: String, column: OrmColumn, connection: String, slot: String, element: String): String
	statement := web_dispatch_quote("SELECT \"" + column.name + "\" FROM \"" + table + "\"")
	result := "Result<Array<" + element + ">, DbError>"
	mut source := "def orm_project_" + slot + "(query: OrmSql::Selection, first: Boolean): " + result + "\n"
	source += "rows := try OrmSql.read_rows(" + connection + ", query, " + statement + ", 1, first, \"database projection query failed\")\n"
	source += "mut values: Array<" + element + "> := []\nmut i := 0\nwhile i < rows.size()\n"
	mut errors := "first ? \"database projection value was invalid\" : \"database projection row was invalid\""
	if column.type_name == "Integer"
		errors += ", \"database Integer is outside the portable range\""
	end
	source += "value := try orm_read_" + slot + "(rows[i][0], " + errors + ")\n"
	return source + "values.push(value)\ni += 1\nend\nreturn " + result + "::Ok(values)\nend\n"
end

def orm_query_type(table: OrmTable, connection: String, projection: String): String
	select_rows := web_dispatch_quote("SELECT " + projection + " FROM \"" + table.name + "\"")
	count_rows := web_dispatch_quote("SELECT 1 FROM \"" + table.name + "\"")
	args := connection + ", @_query, " + select_rows + ", " + integer_string(table.columns.size())
	mut source := "class OrmQuery\nreadonly @_query: OrmSql::Selection\ndef initialize(query: OrmSql::Selection)\n@_query = query\nend\n"
	source += "def limit(count: Integer): OrmQuery\nreturn OrmQuery.new(OrmSql.limited(@_query, count))\nend\n"
	source += "def offset(count: Integer): OrmQuery\nreturn OrmQuery.new(OrmSql.skipped(@_query, count))\nend\n"
	source += "def all(): Result<Array<OrmModelType>, DbError>\nrows := try OrmSql.read_rows(" + args + ", false)\nmut items: Array<OrmModelType> := []\nmut i := 0\nwhile i < rows.size()\nitem := try orm_read(rows[i], @_query.scope)\nitems.push(item)\ni += 1\nend\nreturn Result<Array<OrmModelType>, DbError>::Ok(items)\nend\n"
	source += "def first(): Result<OrmModelType?, DbError>\nrows := try OrmSql.read_rows(" + args + ", true)\nif rows.size() == 0\nreturn Result<OrmModelType?, DbError>::Ok(nil)\nend\nitem := try orm_read(rows[0], @_query.scope)\nreturn Result<OrmModelType?, DbError>::Ok(item)\nend\n"
	# A bounded SELECT 1 can stop at the first match and preserves zero limits.
	source += "def exists?(): Result<Boolean, DbError>\nrows := try OrmSql.read_rows(" + connection + ", @_query, " + count_rows + ", 1, true, \"database existence query failed\")\nreturn Result<Boolean, DbError>::Ok(rows.size() > 0)\nend\n"
	source += "def count(): Result<Integer, DbError>\npage := OrmSql.read_statement(@_query, " + count_rows + ", false)\nreturn OrmSql.count_rows(" + connection + ", \"SELECT count(*) FROM (\" + page + \") AS trb_page\", @_query.scope, @_query.values)\nend\nend\n"
	return source
end

def orm_query_roots(scope: String, prefix: String): Array<OrmQueryMethod>
	root := "OrmQuery.new(OrmSql.selection(" + scope + "))"
	mut methods: Array<OrmQueryMethod> := []
	["all", "first", "limit", "offset"].each do |name|
		mut result := "OrmQuery"
		mut param := ""
		mut arg := ""
		if name == "all"
			result = "Result<Array<OrmModelType>, DbError>"
		elsif name == "first"
			result = "Result<OrmModelType?, DbError>"
		else
			param = "count: Integer"
			arg = "count"
		end
		methods.push(OrmQueryMethod.new(name: name, source: "def " + prefix + name + "(" + param + "): " + result + "\nreturn " + root + "." + name + "(" + arg + ")\nend\n"))
	end
	methods.push(OrmQueryMethod.new(name: "$orm_query", source: "def " + prefix + "orm_query_root(): OrmQuery\nreturn " + root + "\nend\n"))
	return methods
end

# Aggregate the filtered page in SQLite. The locked column determines which
# operations exist and the result type exposed to the checker.
def orm_aggregate_methods(table: OrmTable, col: OrmColumn, slot: String, connection: String): Array<OrmQueryMethod>
	mut methods: Array<OrmQueryMethod> := []
	mut numeric := false
	if col.type_name == "Integer" || col.type_name == "Float"
		numeric = true
	end
	if !numeric && col.type_name != "String" && !orm_time_column(col.type_name)
		return methods
	end
	mut operations := ["minimum", "maximum"]
	if numeric
		operations.push("sum")
		operations.push("average")
	end
	projection := web_dispatch_quote("SELECT \"" + col.name + "\" AS trb_value FROM \"" + table.name + "\"")
	operations.each do |operation|
		mut expression := "MIN(trb_value)"
		mut element := col.type_name + "?"
		if operation == "maximum"
			expression = "MAX(trb_value)"
		elsif operation == "sum"
			expression = "COALESCE(SUM(trb_value), 0)"
			element = col.type_name
		elsif operation == "average"
			expression = "AVG(trb_value)"
			element = "Float?"
		end
		result := "Result<" + element + ", DbError>"
		mut body := "def orm_" + operation + "_" + slot + "(): " + result + "\n"
		body += "raw := try OrmSql.aggregate_value(" + connection + ", @_query, " + projection + ", " + web_dispatch_quote(expression) + ")\n"
		if operation == "average"
			body += "return OrmSql.average_value(raw)\n"
		else
			if operation != "sum"
				body += "case raw\nwhen SQLite::Parameter::Null\nreturn " + result + "::Ok(nil)\nelse\nend\n"
			end
			mut errors := "\"database aggregate result was invalid\""
			if col.type_name == "Integer"
				errors += ", \"database Integer is outside the portable range\""
			end
			body += "value := try orm_read_" + slot + "(raw, " + errors + ")\n"
			if operation == "sum" && col.nullable
				body += "if value == nil\nreturn " + result + "::Err(DbError.new(kind: DbErrorKind::InvalidData, message: \"database aggregate result was invalid\"))\nend\n"
			end
			body += "return " + result + "::Ok(value)\n"
		end
		methods.push(OrmQueryMethod.new(name: "$" + operation + ":" + col.name, source: body + "end\n"))
	end
	return methods
end

# These nominal method keys cannot be named in user source. The call checker
# selects a signature from the locked schema before it evaluates the value.
def orm_query_columns(table: OrmTable, key: String, connection: String): Array<OrmQueryMethod>
	mut methods := [OrmQueryMethod.new(name: "$orm_query", source: "def orm_query_root(): OrmQuery\nreturn self\nend\n")]
	mut index := 0
	table.columns.each do |col|
		column := web_dispatch_quote("\"" + col.name + "\"")
		mut type_name := col.type_name
		mut parameter := orm_sql_parameter(type_name, "value")
		mut setup := ""
		if col.nullable
			type_name += "?"
			setup = "if value == nil\nreturn OrmQuery.new(OrmSql.filter(@_query, " + column + ", operator, SQLite::Parameter::Null))\nend\n"
		end
		slot := "v" + integer_string(index)
		index += 1
		orm_aggregate_methods(table, col, slot, connection).each { |method| methods.push(method) }
		project := "orm_project_" + slot + "(@_query, "
		array := "Result<Array<" + type_name + ">, DbError>"
		optional := col.type_name + "?"
		picked := "Result<" + optional + ", DbError>"
		pluck := "(): " + array + "\nreturn " + project + "false)\nend\n"
		methods.push(OrmQueryMethod.new(name: "$pluck:" + col.name, source: "def orm_pluck_" + slot + pluck))
		methods.push(OrmQueryMethod.new(name: "$pick:" + col.name, source: "def orm_pick_" + slot + "(): " + picked + "\nvalues := try " + project + "true)\nif values.size() == 0\nreturn " + picked + "::Ok(nil)\nend\nreturn " + picked + "::Ok(values[0])\nend\n"))
		subquery := "OrmSql::Subquery<" + col.type_name + ">"
		project_sql := web_dispatch_quote("SELECT \"" + col.name + "\" FROM \"" + table.name + "\"")
		methods.push(OrmQueryMethod.new(name: "$select:" + col.name, source: "def orm_select_" + slot + "(): " + subquery + "\nreturn " + subquery + "::Projected(@_query, " + project_sql + ")\nend\n"))
		methods.push(OrmQueryMethod.new(name: "$sub:" + col.name, source: "def orm_sub_" + slot + "(operator: String, sub: " + subquery + "): OrmQuery\ncase sub\nwhen OrmSql::Subquery::Projected(inner, projection)\nreturn OrmQuery.new(OrmSql.filter_subquery(@_query, " + column + ", operator, inner, projection))\nend\nend\n"))
		if col.type_name == "Integer"
			methods.push(OrmQueryMethod.new(name: "$range:" + col.name, source: "def orm_range_" + slot + "(first: Integer, last: Integer, exclusive: Boolean): OrmQuery\nreturn OrmQuery.new(OrmSql.filter_range(@_query, " + column + ", first, last, exclusive))\nend\n"))
		end
		if col.name == key
			methods.push(OrmQueryMethod.new(name: "$ids", source: "def orm_project_ids" + pluck))
		end
		mut body := "return OrmQuery.new(OrmSql.filter(@_query, " + column + ", operator, " + parameter + "))\nend\n"
		methods.push(OrmQueryMethod.new(name: "$eq:" + col.name, source: "def orm_eq_" + col.name + "(operator: String, value: " + type_name + "): OrmQuery\n" + setup + body))
		if orm_time_column(col.type_name) || col.type_name == "Integer" || col.type_name == "Float" || col.type_name == "String"
			methods.push(OrmQueryMethod.new(name: "$cmp:" + col.name, source: "def orm_cmp_" + col.name + "(operator: String, value: " + col.type_name + "): OrmQuery\n" + body))
		end
		methods.push(OrmQueryMethod.new(name: "$sort:" + col.name, source: "def orm_sort_" + col.name + "(direction: String): OrmQuery\nreturn OrmQuery.new(OrmSql.ordered(@_query, " + column + ", direction))\nend\n"))
	end
	return methods
end
