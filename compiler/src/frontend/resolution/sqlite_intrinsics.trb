import { sqlite_mutable, sqlite_names, sqlite_parameter_names, sqlite_parameters, sqlite_result } from mir/model/sqlite_contract
import { CompilerState } from state/state
import { standard_source_sqlite } from state/standard_source_kinds
import { load_integer, load_string, sparse_integer_at } from support/storage

def standard_sqlite_host(state: CompilerState, function: Integer): Integer
	if function < 0 || function >= state.declarations.function_count[0]
		return -1
	end
	owner := load_integer(state.declarations.function_modules, function)
	if sparse_integer_at(state.standard_modules, owner) != standard_source_sqlite()
		return -1
	end
	names := sqlite_names()
	name := load_string(state.declarations.function_names, function)
	mut kind := 0
	while kind < names.size() && names[kind] != name
		kind += 1
	end
	if kind == names.size()
		return -1
	end
	parameters := sqlite_parameters(kind)
	parameter_names := sqlite_parameter_names(kind)
	if load_integer(state.declarations.function_parameter_counts, function) != parameters.size() || load_string(state.declarations.function_result_types, function) != sqlite_result(kind) || load_integer(state.declarations.function_body_starts, function) != load_integer(state.declarations.function_body_ends, function) || sparse_integer_at(state.parsed.function_expression_bodies, function) != 0
		return -1
	end
	start := load_integer(state.declarations.function_parameter_starts, function)
	mut index := 0
	while index < parameters.size()
		parameter := start + index
		if load_string(state.declarations.parameter_names, parameter) != parameter_names[index] || load_string(state.declarations.parameter_types, parameter) != parameters[index] || load_integer(state.declarations.parameter_mutable, parameter) != sqlite_mutable(kind, index) || load_integer(state.declarations.parameter_named_only, parameter) != 0 || sparse_integer_at(state.parsed.parameter_defaults, parameter) > 0
			return -1
		end
		index += 1
	end
	return kind
end
