import { process_mutable, process_names, process_parameter_names, process_parameters, process_result } from mir/model/process_contract
import { standard_source_internal_process } from state/standard_source_kinds
import { CompilerState } from state/state
import { load_integer, load_string, sparse_integer_at } from support/storage

# Module ownership and the complete host signature are checked independently
# of the import alias used by the public wrapper.
def standard_process(state: CompilerState, function: Integer): Integer
	if function < 0 || function >= state.declarations.function_count[0]
		return -1
	end
	owner := load_integer(state.declarations.function_modules, function)
	if sparse_integer_at(state.standard_modules, owner) != standard_source_internal_process()
		return -1
	end
	names := process_names()
	name := load_string(state.declarations.function_names, function)
	mut kind := 0
	while kind < names.size() && names[kind] != name
		kind += 1
	end
	if kind == names.size()
		return -1
	end
	parameters := process_parameters(kind)
	parameter_names := process_parameter_names(kind)
	if load_integer(state.declarations.function_parameter_counts, function) != parameters.size() || load_string(state.declarations.function_result_types, function) != process_result(kind) || load_integer(state.declarations.function_body_starts, function) != load_integer(state.declarations.function_body_ends, function) || sparse_integer_at(state.parsed.function_expression_bodies, function) != 0
		return -1
	end
	start := load_integer(state.declarations.function_parameter_starts, function)
	mut index := 0
	while index < parameters.size()
		parameter := start + index
		if load_string(state.declarations.parameter_names, parameter) != parameter_names[index] || load_string(state.declarations.parameter_types, parameter) != parameters[index] || load_integer(state.declarations.parameter_mutable, parameter) != process_mutable(kind, index) || load_integer(state.declarations.parameter_named_only, parameter) != 0 || sparse_integer_at(state.parsed.parameter_defaults, parameter) > 0
			return -1
		end
		index += 1
	end
	return kind
end
