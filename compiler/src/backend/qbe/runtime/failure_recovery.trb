import { emit_resource_cleanup_runtime } from backend/qbe/runtime/resource_cleanup
import { QbeOutput, qbe_output_line } from backend/qbe/output

# Only this callback trampoline contains a returns-twice libc call. Saved scope
# fields are immutable across the callback and read after either return path.
# Target validation checks the bounded environment against the system ABI.
# The 1024-byte environment ends before the saved resource cleanup boundary.
# Unwind only younger resources; a recover nested inside an outer resource must
# leave that outer resource available to its checked lexical owner.
def emit_failure_recovery_runtime(mut output: QbeOutput, deadlines: Boolean)
	emit_resource_cleanup_runtime(output)
	qbe_output_line(output, "# Typed collection failures retain their reference category in a catch frame.\n# With no recovery frame, preserve the ordinary terminal diagnostic.\ndata $trbn_array_caught_bounds = { b \"panic: Array index is out of bounds\", b 10 }\nfunction $trbn_array_bounds_fail() {\n@start\n call $trbn_failure_notice(l $trbn_array_caught_bounds, l 36, l 1, l 0, l 0, l 0)\n call $trbn_unwind()\n call $trbn_fail(l $trbn_bounds_error, l 30)\n hlt\n}\ndata $trbn_string_caught_bounds = { b \"panic: String index is out of bounds\", b 10 }\nfunction $trbn_string_bounds_fail() {\n@start\n call $trbn_failure_notice(l $trbn_string_caught_bounds, l 37, l 1, l 0, l 0, l 0)\n call $trbn_unwind()\n call $trbn_fail(l $trbn_bounds_error, l 30)\n hlt\n}\n")
	qbe_output_line(output, "# The nearest frame alone owns failure notification. Ordinary recover frames\n# leave the callback empty; optional test support supplies its own recorder.\nfunction $trbn_failure_notice(l %message, l %size, l %raw, l %path, l %line, l %column) {\n@start\n %scope =l loadl $trbn_recovery_scope\n %present =w cnel %scope, 0\n jnz %present, @callback, @done\n@callback\n %callback_slot =l add %scope, 1064\n %callback =l loadl %callback_slot\n %enabled =w cnel %callback, 0\n jnz %enabled, @notify, @done\n@notify\n %context_slot =l add %scope, 16\n %context =l loadl %context_slot\n call %callback(l %context, l %message, l %size, l %raw, l %path, l %line, l %column)\n jmp @done\n@done\n ret\n}")
	qbe_output_line(output, "data $trbn_recovery_scope = align 8 { l 0 }\n\nfunction $trbn_unwind() {\n@start\n %scope =l loadl $trbn_recovery_scope")
	if deadlines
		qbe_output_line(output, " call $trbn_deadline_leave_recovery(l %scope)")
	end
	qbe_output_line(output, " %scope_nonzero =w cnel %scope, 0\n jnz %scope_nonzero, @recover, @terminal\n@recover\n %cleanup_slot =l add %scope, 1056\n %cleanup_boundary =l loadl %cleanup_slot\n call $trbn_resource_unwind(l %cleanup_boundary)\n %environment =l add %scope, 32\n call $longjmp(l %environment, w 1)\n hlt\n@terminal\n call $trbn_resource_unwind(l 0)\n ret\n}\n\nfunction $trbn_fail(l %message, l %size) {\n@start\n call $trbn_failure_notice(l %message, l %size, l 1, l 0, l 0, l 0)\n call $trbn_unwind()\n call $trbn_fatal(l %message, l %size)\n hlt\n}\n")
	qbe_output_line(output, "function l $trbn_runtime_recover_l(l %action, l %fallback) {\n@start\n %scope =l alloc16 1072\n %previous =l loadl $trbn_recovery_scope\n storel %previous, %scope\n %saved_roots =l add %scope, 8\n %roots =l loadl $trbn_gc_temp_count\n storel %roots, %saved_roots\n %saved_fallback =l add %scope, 16\n storel %fallback, %saved_fallback\n %saved_action =l add %scope, 24\n storel %action, %saved_action\n %cleanup_slot =l add %scope, 1056\n %cleanup_boundary =l loadl $trbn_resource_scope\n storel %cleanup_boundary, %cleanup_slot\n %notice_slot =l add %scope, 1064\n storel 0, %notice_slot\n %environment =l add %scope, 32\n %caught =w call $setjmp(l %environment)\n jnz %caught, @caught, @invoke\n@invoke\n storel %scope, $trbn_recovery_scope\n %action_slot =l add %scope, 24\n %closure =l loadl %action_slot\n %code_slot =l add %closure, 8\n %code =l loadl %code_slot\n %result =l call %code(l %closure)\n jmp @complete\n@caught\n %fallback_slot =l add %scope, 16\n %fallback_result =l loadl %fallback_slot\n jmp @complete\n@complete\n %value =l phi @invoke %result, @caught %fallback_result\n %parent =l loadl %scope\n storel %parent, $trbn_recovery_scope\n %root_slot =l add %scope, 8\n %root_count =l loadl %root_slot\n storel %root_count, $trbn_gc_temp_count\n ret %value\n}\n")
	qbe_output_line(output, "function d $trbn_runtime_recover_d(l %action, d %fallback) {\n@start\n %scope =l alloc16 1072\n %previous =l loadl $trbn_recovery_scope\n storel %previous, %scope\n %saved_roots =l add %scope, 8\n %roots =l loadl $trbn_gc_temp_count\n storel %roots, %saved_roots\n %saved_fallback =l add %scope, 16\n stored %fallback, %saved_fallback\n %saved_action =l add %scope, 24\n storel %action, %saved_action\n %cleanup_slot =l add %scope, 1056\n %cleanup_boundary =l loadl $trbn_resource_scope\n storel %cleanup_boundary, %cleanup_slot\n %notice_slot =l add %scope, 1064\n storel 0, %notice_slot\n %environment =l add %scope, 32\n %caught =w call $setjmp(l %environment)\n jnz %caught, @caught, @invoke\n@invoke\n storel %scope, $trbn_recovery_scope\n %action_slot =l add %scope, 24\n %closure =l loadl %action_slot\n %code_slot =l add %closure, 8\n %code =l loadl %code_slot\n %result =d call %code(l %closure)\n jmp @complete\n@caught\n %fallback_slot =l add %scope, 16\n %fallback_result =d loadd %fallback_slot\n jmp @complete\n@complete\n %value =d phi @invoke %result, @caught %fallback_result\n %parent =l loadl %scope\n storel %parent, $trbn_recovery_scope\n %root_slot =l add %scope, 8\n %root_count =l loadl %root_slot\n storel %root_count, $trbn_gc_temp_count\n ret %value\n}\n")
end
