import { QbeOutput, qbe_output_line } from backend/qbe/output
import { mir_signature_standard } from mir/model/call_kinds
import { MirModule } from mir/model/module
import { sqlite_kind } from mir/model/sqlite_contract

def sqlite_runtime_needed(native_module: MirModule): Boolean
	native_module.signatures.each do |signature|
		if signature.kind == mir_signature_standard() && sqlite_kind(signature.adapter) >= 0
			return true
		end
	end
	return false
end

def emit_sqlite_error_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function l $trbn_sqlite_error_message(l %status) {\n@start\n %native =w copy %status\n %message =l call $sqlite3_errstr(w %native)\n %value =l call $trbn_string_from_c(l %message)\n ret %value\n}\n\n")
end

# Each call owns its database, prepared statements and optional transaction.
# The caller supplies checked frames and receives the count after close.
def emit_sqlite_write_runtime(mut output: QbeOutput)
	qbe_output_line(output, "# An owned write batch holds all SQLite handles inside this foreign call.\n# Request records contain SQL (8), cells (8), and parameter count (4).\n# Cells contain the SQLite type (4+4 padding), word (8), length (8), real (8).\ndata $sqlite_begin_write = { b \"BEGIN IMMEDIATE\", b 0 }\ndata $sqlite_commit_write = { b \"COMMIT\", b 0 }\ndata $sqlite_rollback_write = { b \"ROLLBACK\", b 0 }\n\n")
	qbe_output_line(output, "function w $sqlite_bind_cell(l %statement, w %index, l %cell) {\n@start\n    %kind =w loadw %cell\n    %integer =w ceqw %kind, 1\n    jnz %integer, @bind_integer, @maybe_float\n@bind_integer\n    %ip =l add %cell, 8\n    %iv =l loadl %ip\n    %i =w call $sqlite3_bind_int64(l %statement, w %index, l %iv)\n    ret %i\n@maybe_float\n    %float =w ceqw %kind, 2\n    jnz %float, @bind_float, @maybe_text\n@bind_float\n    %fp =l add %cell, 24\n    %fv =d loadd %fp\n    %f =w call $sqlite3_bind_double(l %statement, w %index, d %fv)\n    ret %f\n@maybe_text\n    %text =w ceqw %kind, 3\n    jnz %text, @bind_text, @maybe_blob\n@bind_text\n    %tp =l add %cell, 8\n    %tv =l loadl %tp\n    %tnp =l add %cell, 16\n    %tn =l loadl %tnp\n    %t =w call $sqlite3_bind_text64(l %statement, w %index, l %tv, l %tn, l -1, w 1)\n    ret %t\n@maybe_blob\n    %blob =w ceqw %kind, 4\n    jnz %blob, @bind_blob, @maybe_null\n@bind_blob\n    %bp =l add %cell, 8\n    %bv =l loadl %bp\n    %bnp =l add %cell, 16\n    %bn =l loadl %bnp\n    %b =w call $sqlite3_bind_blob64(l %statement, w %index, l %bv, l %bn, l -1)\n    ret %b\n@maybe_null\n    %nil =w ceqw %kind, 5\n    jnz %nil, @bind_null, @invalid\n@bind_null\n    %n =w call $sqlite3_bind_null(l %statement, w %index)\n    ret %n\n@invalid\n    ret 21\n}\n\n")
	qbe_output_line(output, "function w $sqlite_bind_cells(l %statement, l %cells, w %count) {\n@start\n    %arity =w call $sqlite3_bind_parameter_count(l %statement)\n    %matches =w ceqw %arity, %count\n    jnz %matches, @loop, @invalid\n@loop\n    %position =w phi @start 0, @advance %index\n    %finished =w ceqw %position, %count\n    jnz %finished, @success, @bind\n@bind\n    %wide =l extuw %position\n    %offset =l mul %wide, 32\n    %cell =l add %cells, %offset\n    %index =w add %position, 1\n    %status =w call $sqlite_bind_cell(l %statement, w %index, l %cell)\n    jnz %status, @failed, @advance\n@advance\n    jmp @loop\n@success\n    ret 0\n@failed\n    ret %status\n@invalid\n    ret 21\n}\n\n")
	qbe_output_line(output, "function w $sqlite_one_write(l %database, l %request) {\n@start\n    %statement_slot =l alloc8 8\n    %tail_slot =l alloc8 8\n    storel 0, %statement_slot\n    storel 0, %tail_slot\n    %sql =l loadl %request\n    %prepared =w call $sqlite3_prepare_v2(l %database, l %sql, w -1, l %statement_slot, l %tail_slot)\n    %statement =l loadl %statement_slot\n    jnz %prepared, @prepare_error, @check_statement\n@prepare_error\n    jmp @finalize\n@check_statement\n    %statement_present =w cnel %statement, 0\n    jnz %statement_present, @check_tail, @invalid\n@check_tail\n    %tail =l loadl %tail_slot\n    storel 0, %statement_slot\n    %tail_code =w call $sqlite3_prepare_v2(l %database, l %tail, w -1, l %statement_slot, l 0)\n    %excess =l loadl %statement_slot\n    call $sqlite3_finalize(l %excess)\n    %unparsed =w cnew %tail_code, 0\n    %additional =w cnel %excess, 0\n    %bad_tail =w or %unparsed, %additional\n    jnz %bad_tail, @invalid, @result_shape\n@result_shape\n    %columns =w call $sqlite3_column_count(l %statement)\n    jnz %columns, @invalid, @bind\n@invalid\n    jmp @finalize\n@bind\n    %cellsp =l add %request, 8\n    %countp =l add %request, 16\n    %cells =l loadl %cellsp\n    %count =w loadw %countp\n    %bound =w call $sqlite_bind_cells(l %statement, l %cells, w %count)\n    jnz %bound, @bind_error, @step\n@bind_error\n    jmp @finalize\n@step\n    %stepped =w call $sqlite3_step(l %statement)\n    %done =w ceqw %stepped, 101\n    jnz %done, @done, @step_error\n@done\n    jmp @finalize\n@step_error\n    %row =w ceqw %stepped, 100\n    jnz %row, @invalid, @failed_step\n@failed_step\n    jmp @finalize\n@finalize\n    %status =w phi @prepare_error %prepared, @invalid 21, @bind_error %bound, @done 0, @failed_step %stepped\n    %closed =w call $sqlite3_finalize(l %statement)\n    jnz %status, @report_status, @report_finalize\n@report_status\n    ret %status\n@report_finalize\n    ret %closed\n}\n\n")
	qbe_output_line(output, "export function w $trbn_sqlite_write_batch(l %source, l %requests, l %count, w %transaction, w %busy_ms, l %changes) {\n@start\n    %empty =w cslel %count, 0\n    %timeout_invalid =w csltw %busy_ms, 0\n    %transaction_invalid =w cugtw %transaction, 1\n    %invalid_header =w or %empty, %timeout_invalid\n    %invalid =w or %invalid_header, %transaction_invalid\n    jnz %invalid, @invalid_input, @open\n@invalid_input\n    ret 21\n@open\n    %slot =l alloc8 8\n    storel 0, %slot\n    %opened =w call $sqlite3_open_v2(l %source, l %slot, w 65606, l 0)\n    %database =l loadl %slot\n    jnz %opened, @open_failed, @configure\n@open_failed\n    call $sqlite3_close(l %database)\n    ret %opened\n@configure\n    %configured =w call $sqlite3_busy_timeout(l %database, w %busy_ms)\n    jnz %configured, @cleanup, @select_transaction\n@select_transaction\n    jnz %transaction, @begin, @work\n@begin\n    %begun =w call $sqlite3_exec(l %database, l $sqlite_begin_write, l 0, l 0, l 0)\n    jnz %begun, @cleanup, @work\n@work\n    %index =l phi @select_transaction 0, @begin 0, @advance %following\n    %done =w ceql %index, %count\n    jnz %done, @finish, @execute\n@execute\n    %offset =l mul %index, 24\n    %request =l add %requests, %offset\n    %executed =w call $sqlite_one_write(l %database, l %request)\n    jnz %executed, @cleanup, @advance\n@advance\n    %following =l add %index, 1\n    jmp @work\n@finish\n    jnz %transaction, @commit, @cleanup\n@commit\n    %committed =w call $sqlite3_exec(l %database, l $sqlite_commit_write, l 0, l 0, l 0)\n    jmp @cleanup\n@cleanup\n    %status =w phi @configure %configured, @begin %begun, @execute %executed, @finish 0, @commit %committed\n    %autocommit =w call $sqlite3_get_autocommit(l %database)\n    jnz %autocommit, @close, @rollback\n@rollback\n    call $sqlite3_exec(l %database, l $sqlite_rollback_write, l 0, l 0, l 0)\n    jmp @close\n@close\n    %total =l call $sqlite3_total_changes64(l %database)\n    %closed =w call $sqlite3_close(l %database)\n    jnz %status, @failed, @check_close\n@failed\n    ret %status\n@check_close\n    jnz %closed, @failed_close, @success\n@failed_close\n    ret %closed\n@success\n    storel %total, %changes\n    ret 0\n}\n\n")
	qbe_output_line(output, "# This entry prepares foreign frames from typed managed arrays. No pointer to a\n# connection, a statement, or an argument frame leaves the invocation.\n\n")
	qbe_output_line(output, "function l $sqlite_array_length(l %array) {\n@start\n    %lengthp =l add %array, 8\n    %length =l loadl %lengthp\n    ret %length\n}\n\n")
	qbe_output_line(output, "function l $sqlite_array_data(l %array) {\n@start\n    %storage =l add %array, 24\n    %data =l loadl %storage\n    ret %data\n}\n\n")
	qbe_output_line(output, "function l $sqlite_c_string(l %value) {\n@start\n    %lengthp =l add %value, 8\n    %length =l loadl %lengthp\n    %data =l add %value, 24\n    %embedded =l call $memchr(l %data, w 0, l %length)\n    %has_nul =w cnel %embedded, 0\n    jnz %has_nul, @invalid, @ready\n@invalid\n    ret 0\n@ready\n    ret %data\n}\n\n")
	qbe_output_line(output, "function w $sqlite_prepare_cells(l %frames, l %kinds, l %words, l %reals, l %buffers, l %count) {\n@start\n    %kind_data =l call $sqlite_array_data(l %kinds)\n    %word_data =l call $sqlite_array_data(l %words)\n    %real_data =l call $sqlite_array_data(l %reals)\n    %buffer_data =l call $sqlite_array_data(l %buffers)\n    jmp @loop\n@loop\n    %index =l phi @start 0, @next %following\n    %finished =w ceql %index, %count\n    jnz %finished, @success, @load\n@load\n    %offset =l mul %index, 8\n    %frame_offset =l mul %index, 32\n    %frame =l add %frames, %frame_offset\n    %kindp =l add %kind_data, %offset\n    %kind =l loadl %kindp\n    %value =l sub %kind, 1\n    %valid =w culel %value, 4\n    jnz %valid, @initialize, @invalid\n@initialize\n    storew %kind, %frame\n    %wordp =l add %word_data, %offset\n    %word =l loadl %wordp\n    %realp =l add %real_data, %offset\n    %real =d loadd %realp\n    %real_slot =l add %frame, 24\n    stored %real, %real_slot\n    %text_or_blob =l sub %kind, 3\n    %bytes =w culel %text_or_blob, 1\n    jnz %bytes, @copy_buffer, @copy_word\n@copy_buffer\n    %bufferp =l add %buffer_data, %offset\n    %buffer =l loadl %bufferp\n    %buffer_lengthp =l add %buffer, 8\n    %length =l loadl %buffer_lengthp\n    %pointer =l add %buffer, 24\n    jmp @publish\n@copy_word\n    jmp @publish\n@publish\n    %payload =l phi @copy_word %word, @copy_buffer %pointer\n    %size =l phi @copy_word 0, @copy_buffer %length\n    %payload_slot =l add %frame, 8\n    %size_slot =l add %frame, 16\n    storel %payload, %payload_slot\n    storel %size, %size_slot\n    jmp @next\n@next\n    %following =l add %index, 1\n    jmp @loop\n@success\n    ret 0\n@invalid\n    ret 21\n}\n\n")
	qbe_output_line(output, "function w $sqlite_prepare_requests(l %frames, l %cells, l %statements, l %offsets, l %request_count, l %cell_count) {\n@start\n    %sql_data =l call $sqlite_array_data(l %statements)\n    %offset_data =l call $sqlite_array_data(l %offsets)\n    %first =l loadl %offset_data\n    %last_offset =l mul %request_count, 8\n    %lastp =l add %offset_data, %last_offset\n    %total =l loadl %lastp\n    %starts_at_zero =w ceql %first, 0\n    %covers_cells =w ceql %total, %cell_count\n    %whole =w and %starts_at_zero, %covers_cells\n    jnz %whole, @loop, @invalid\n@loop\n    %index =l phi @start 0, @next %following\n    %finished =w ceql %index, %request_count\n    jnz %finished, @success, @span\n@span\n    %offset =l mul %index, 8\n    %leftp =l add %offset_data, %offset\n    %rightp =l add %leftp, 8\n    %left =l loadl %leftp\n    %right =l loadl %rightp\n    %count =l sub %right, %left\n    %right_valid =w culel %right, %cell_count\n    %left_valid =w culel %left, %right\n    %count_valid =w culel %count, 2147483647\n    %bounds =w and %right_valid, %left_valid\n    %valid =w and %bounds, %count_valid\n    jnz %valid, @source, @invalid\n@source\n    %sqlp =l add %sql_data, %offset\n    %sql =l loadl %sqlp\n    %source =l call $sqlite_c_string(l %sql)\n    %valid_source =w cnel %source, 0\n    jnz %valid_source, @initialize, @invalid\n@initialize\n    %frame_offset =l mul %index, 24\n    %frame =l add %frames, %frame_offset\n    %cellsp =l add %frame, 8\n    %countp =l add %frame, 16\n    %cell_offset =l mul %left, 32\n    %first_cell =l add %cells, %cell_offset\n    storel %source, %frame\n    storel %first_cell, %cellsp\n    storew %count, %countp\n    jmp @next\n@next\n    %following =l add %index, 1\n    jmp @loop\n@success\n    ret 0\n@invalid\n    ret 21\n}\n\n")
	qbe_output_line(output, "export function l $trbn_sqlite_write(l %source, l %statements, l %offsets, l %kinds, l %words, l %reals, l %buffers, l %transaction, l %busy, l %result) {\n@start\n    %source_path =l call $sqlite_c_string(l %source)\n    %request_count =l call $sqlite_array_length(l %statements)\n    %offset_count =l call $sqlite_array_length(l %offsets)\n    %cell_count =l call $sqlite_array_length(l %kinds)\n    %word_count =l call $sqlite_array_length(l %words)\n    %real_count =l call $sqlite_array_length(l %reals)\n    %buffer_count =l call $sqlite_array_length(l %buffers)\n    %result_count =l call $sqlite_array_length(l %result)\n    %expected_offsets =l add %request_count, 1\n    %has_source =w cnel %source_path, 0\n    %has_request =w csgtl %request_count, 0\n    %has_offsets =w ceql %offset_count, %expected_offsets\n    %has_words =w ceql %word_count, %cell_count\n    %has_reals =w ceql %real_count, %cell_count\n    %has_buffers =w ceql %buffer_count, %cell_count\n    %has_result =w ceql %result_count, 1\n    %timeout_valid =w culel %busy, 2147483647\n    %transaction_valid =w culel %transaction, 1\n    %sources_valid =w and %has_source, %has_request\n    %result_valid =w and %has_offsets, %has_result\n    %primitive_valid =w and %has_words, %has_reals\n    %values_valid =w and %primitive_valid, %has_buffers\n    %settings_valid =w and %timeout_valid, %transaction_valid\n    %frames_valid =w and %sources_valid, %result_valid\n    %input_valid =w and %frames_valid, %values_valid\n    %shape_valid =w and %input_valid, %settings_valid\n    %artifact =w loadub $trbn_sqlite_build_identity\n    %artifact_valid =w ceqw %artifact, 84\n    %valid =w and %shape_valid, %artifact_valid\n    jnz %valid, @cell_allocation, @invalid\n@cell_allocation\n    %cell_storage =l mul %cell_count, 32\n    %cell_size =l add %cell_storage, 32\n    %cells =l call $malloc(l %cell_size)\n    %cells_ready =w cnel %cells, 0\n    jnz %cells_ready, @request_allocation, @allocation_failed\n@request_allocation\n    %request_size =l mul %request_count, 24\n    %requests =l call $malloc(l %request_size)\n    %requests_ready =w cnel %requests, 0\n    jnz %requests_ready, @prepare_cells, @free_cells\n@free_cells\n    call $free(l %cells)\n    jmp @allocation_failed\n@prepare_cells\n    %cell_status =w call $sqlite_prepare_cells(l %cells, l %kinds, l %words, l %reals, l %buffers, l %cell_count)\n    jnz %cell_status, @cleanup, @prepare_requests\n@prepare_requests\n    %request_status =w call $sqlite_prepare_requests(l %requests, l %cells, l %statements, l %offsets, l %request_count, l %cell_count)\n    jnz %request_status, @cleanup, @write\n@write\n    %changes =l alloc8 8\n    %write_status =w call $trbn_sqlite_write_batch(l %source_path, l %requests, l %request_count, w %transaction, w %busy, l %changes)\n    jnz %write_status, @cleanup, @publish\n@publish\n    %value =l loadl %changes\n    %data =l call $sqlite_array_data(l %result)\n    storel %value, %data\n    jmp @cleanup\n@cleanup\n    %status =w phi @prepare_cells %cell_status, @prepare_requests %request_status, @write %write_status, @publish 0\n    call $free(l %requests)\n    call $free(l %cells)\n    %code =l extsw %status\n    ret %code\n@invalid\n    ret 21\n@allocation_failed\n    ret 7\n}\n\n")
end
