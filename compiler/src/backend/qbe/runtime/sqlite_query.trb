import { QbeOutput, qbe_output_line } from backend/qbe/output

def emit_sqlite_query_runtime(mut output: QbeOutput)
	qbe_output_line(output, "# A query may return no result or exactly one row with the expected width.\n# TEXT and BLOB are copied while the statement is alive and owned by the caller.\nfunction w $sqlite_copy_column(l %statement, w %index, l %cell, l %required) {\n@start\n    %kind =w call $sqlite3_column_type(l %statement, w %index)\n    %unchecked =w ceql %required, 0\n    %actual =l extuw %kind\n    %matches =w ceql %required, %actual\n    %allowed =w or %unchecked, %matches\n    jnz %allowed, @copy_value, @mismatch\n@mismatch\n    ret 20\n@copy_value\n    %word =l add %cell, 8\n    %length =l add %cell, 16\n    %real =l add %cell, 24\n    %null =w ceqw %kind, 5\n    jnz %null, @store_kind, @maybe_integer\n@maybe_integer\n    %integer =w ceqw %kind, 1\n    jnz %integer, @integer, @maybe_float\n@integer\n    %integer_value =l call $sqlite3_column_int64(l %statement, w %index)\n    storel %integer_value, %word\n    jmp @store_kind\n@maybe_float\n    %float =w ceqw %kind, 2\n    jnz %float, @float, @maybe_text\n@float\n    %float_value =d call $sqlite3_column_double(l %statement, w %index)\n    stored %float_value, %real\n    jmp @store_kind\n@maybe_text\n    %text =w ceqw %kind, 3\n    jnz %text, @text, @maybe_blob\n@text\n    %text_data =l call $sqlite3_column_text(l %statement, w %index)\n    jmp @copy\n@maybe_blob\n    %blob =w ceqw %kind, 4\n    jnz %blob, @blob, @invalid\n@blob\n    %blob_data =l call $sqlite3_column_blob(l %statement, w %index)\n    jmp @copy\n@copy\n    %data =l phi @text %text_data, @blob %blob_data\n    %bytes =w call $sqlite3_column_bytes(l %statement, w %index)\n    %is_empty =w ceqw %bytes, 0\n    jnz %is_empty, @check_error, @allocate\n@check_error\n    %database =l call $sqlite3_db_handle(l %statement)\n    %status =w call $sqlite3_errcode(l %database)\n    %allocation_failed =w ceqw %status, 7\n    jnz %allocation_failed, @nomem, @store_kind\n@allocate\n    %data_ready =w cnel %data, 0\n    jnz %data_ready, @buffer, @nomem\n@buffer\n    %size =l extuw %bytes\n    %copy =l call $malloc(l %size)\n    %copy_ready =w cnel %copy, 0\n    jnz %copy_ready, @copy_bytes, @nomem\n@copy_bytes\n    call $memcpy(l %copy, l %data, l %size)\n    storel %copy, %word\n    storel %size, %length\n    jmp @store_kind\n@store_kind\n    storew %kind, %cell\n    ret 0\n@invalid\n    ret 21\n@nomem\n    ret 7\n}\n\n")
	qbe_output_line(output, "export function $trbn_sqlite_free_row(l %row, w %columns) {\n@start\n    %count =l extuw %columns\n    jmp @next\n@next\n    %index =l phi @start 0, @advance %following\n    %done =w ceql %count, %index\n    jnz %done, @return, @inspect\n@inspect\n    %offset =l mul %index, 32\n    %cell =l add %row, %offset\n    %kind =w loadw %cell\n    %text =w ceqw %kind, 3\n    %blob =w ceqw %kind, 4\n    %allocated =w or %text, %blob\n    jnz %allocated, @release, @advance\n@release\n    %word =l add %cell, 8\n    %value =l loadl %word\n    call $free(l %value)\n    storel 0, %word\n    jmp @advance\n@advance\n    %following =l add %index, 1\n    jmp @next\n@return\n    ret\n}\n\n")
	qbe_output_line(output, "function w $sqlite_collect_single_row(l %statement, l %row, w %columns, l %shape) {\n@start\n    %first =w call $sqlite3_step(l %statement)\n    %has_row =w ceqw %first, 100\n    jnz %has_row, @collect, @return_first\n@return_first\n    ret %first\n@collect\n    %count =l extuw %columns\n    jmp @column\n@column\n    %index =l phi @collect 0, @advance %following\n    %complete =w ceql %index, %count\n    jnz %complete, @extra, @expected\n@expected\n    %has_shape =w cnel %shape, 0\n    jnz %has_shape, @load_type, @any\n@load_type\n    %kind_offset =l mul %index, 8\n    %kind_slot =l add %shape, %kind_offset\n    %want =l loadl %kind_slot\n    jmp @copy\n@any\n    jmp @copy\n@copy\n    %required =l phi @load_type %want, @any 0\n    %offset =l mul %index, 32\n    %slot =l add %row, %offset\n    %value_status =w call $sqlite_copy_column(l %statement, w %index, l %slot, l %required)\n    jnz %value_status, @column_failed, @advance\n@column_failed\n    ret %value_status\n@advance\n    %following =l add %index, 1\n    jmp @column\n@extra\n    %last =w call $sqlite3_step(l %statement)\n    %excess =w ceqw %last, 100\n    jnz %excess, @invalid, @check_done\n@check_done\n    %done =w ceqw %last, 101\n    jnz %done, @row, @failed\n@invalid\n    ret 21\n@failed\n    ret %last\n@row\n    ret 0\n}\n\n")
	qbe_output_line(output, "function w $sqlite_query_on_connection(l %db, l %request, w %write, l %row, w %columns, l %shape) {\n@start\n    %statement_slot =l alloc8 8\n    storel 0, %statement_slot\n    jmp @prepare\n@prepare\n    %sql =l loadl %request\n    %prepared =w call $sqlite_prepare_single(l %db, l %sql, l %statement_slot)\n    %statement =l loadl %statement_slot\n    jnz %prepared, @prepared_error, @verify_shape\n@prepared_error\n    jmp @finalize\n@verify_shape\n    %actual =w call $sqlite3_column_count(l %statement)\n    %same_width =w ceqw %actual, %columns\n    %readonly =w call $sqlite3_stmt_readonly(l %statement)\n    %allowed =w or %write, %readonly\n    %compatible =w and %same_width, %allowed\n    jnz %compatible, @bind, @unsupported\n@unsupported\n    jmp @finalize\n@bind\n    %cellsp =l add %request, 8\n    %countp =l add %request, 16\n    %cells =l loadl %cellsp\n    %count =w loadw %countp\n    %bound =w call $sqlite_bind_cells(l %statement, l %cells, w %count)\n    jnz %bound, @bind_error, @step\n@bind_error\n    jmp @finalize\n@step\n    %stepped =w call $sqlite_collect_single_row(l %statement, l %row, w %columns, l %shape)\n    jmp @finalize\n@finalize\n    %status =w phi @prepared_error %prepared, @unsupported 21, @bind_error %bound, @step %stepped\n    %finalized =w call $sqlite3_finalize(l %statement)\n    %one =w ceqw %status, 0\n    %none =w ceqw %status, 101\n    %finished =w or %one, %none\n    jnz %finished, @finalized_check, @return_status\n@finalized_check\n    jnz %finalized, @return_finalized, @return_status\n@return_finalized\n    ret %finalized\n@return_status\n    ret %status\n}\n\nexport function w $trbn_sqlite_single_row(l %source, l %request, w %mode, w %busy_ms, l %row, w %columns, l %shape) {\n@start\n    %valid_width =w csgtw %columns, 0\n    %valid_timeout =w csgew %busy_ms, 0\n    %write =w ceqw %mode, 1\n    %valid_mode =w culew %mode, 2\n    %dimensions_valid =w and %valid_width, %valid_timeout\n    %valid =w and %dimensions_valid, %valid_mode\n    jnz %valid, @open_mode, @invalid\n@invalid\n    ret 21\n@open_mode\n    %row_count =l extuw %columns\n    %row_size =l mul %row_count, 32\n    call $memset(l %row, w 0, l %row_size)\n    jnz %mode, @readwrite_mode, @read_mode\n@readwrite_mode\n    jmp @open\n@read_mode\n    jmp @open\n@open\n    %flags =w phi @readwrite_mode 65606, @read_mode 65601\n    %db_slot =l alloc8 8\n    storel 0, %db_slot\n    %opened =w call $sqlite3_open_v2(l %source, l %db_slot, w %flags, l 0)\n    %db =l loadl %db_slot\n    jnz %opened, @cleanup, @configure\n@configure\n    %configured =w call $sqlite3_busy_timeout(l %db, w %busy_ms)\n    jnz %configured, @cleanup, @begin_mode\n@begin_mode\n    jnz %write, @begin, @prepare\n@begin\n    %begun =w call $sqlite3_exec(l %db, l $sqlite_begin_write, l 0, l 0, l 0)\n    jnz %begun, @cleanup, @prepare\n@prepare\n    %status =w call $sqlite_query_on_connection(l %db, l %request, w %write, l %row, w %columns, l %shape)\n    %one =w ceqw %status, 0\n    %none =w ceqw %status, 101\n    %finished =w or %one, %none\n    jnz %finished, @commit_mode, @cleanup\n@commit_mode\n    jnz %write, @commit, @cleanup\n@commit\n    %committed =w call $sqlite3_exec(l %db, l $sqlite_commit_write, l 0, l 0, l 0)\n    jnz %committed, @cleanup, @commit_done\n@commit_done\n    jmp @cleanup\n@cleanup\n    %outcome =w phi @open %opened, @configure %configured, @begin %begun, @prepare %status, @commit_mode %status, @commit %committed, @commit_done %status\n    %connected =w cnel %db, 0\n    jnz %connected, @check_transaction, @release\n@check_transaction\n    %autocommit =w call $sqlite3_get_autocommit(l %db)\n    jnz %autocommit, @close, @rollback\n@rollback\n    call $sqlite3_exec(l %db, l $sqlite_rollback_write, l 0, l 0, l 0)\n    jmp @close\n@close\n    %closed =w call $sqlite3_close(l %db)\n    %bad_close =w cnew %closed, 0\n    jnz %bad_close, @release_close, @return_or_release\n@return_or_release\n    %row_found =w ceqw %outcome, 0\n    jnz %row_found, @success, @release\n@release_close\n    call $trbn_sqlite_free_row(l %row, w %columns)\n    ret %closed\n@release\n    call $trbn_sqlite_free_row(l %row, w %columns)\n    ret %outcome\n@success\n    ret 0\n}\n\n")
	qbe_output_line(output, "data $trbn_sqlite_empty_bytes = { b 0 }\n\n\n")
	qbe_output_line(output, "function $sqlite_publish_row(l %row, l %width, l %kinds, l %words, l %reals, l %buffers) {\n@start\n    %kind_data =l call $sqlite_array_data(l %kinds)\n    %word_data =l call $sqlite_array_data(l %words)\n    %real_data =l call $sqlite_array_data(l %reals)\n    %buffer_data =l call $sqlite_array_data(l %buffers)\n    jmp @next\n@next\n    %index =l phi @start 0, @advance %following\n    %done =w ceql %index, %width\n    jnz %done, @return, @publish\n@publish\n    %offset =l mul %index, 8\n    %frame_offset =l mul %index, 32\n    %frame =l add %row, %frame_offset\n    %kind =w loadw %frame\n    %kind_word =l extuw %kind\n    %kind_slot =l add %kind_data, %offset\n    storel %kind_word, %kind_slot\n    %payload_slot =l add %frame, 8\n    %payload =l loadl %payload_slot\n    %text =w ceqw %kind, 3\n    %blob =w ceqw %kind, 4\n    %bytes =w or %text, %blob\n    jnz %bytes, @pack_bytes, @scalars\n@scalars\n    %word_slot =l add %word_data, %offset\n    storel %payload, %word_slot\n    %real_slot =l add %frame, 24\n    %real =d loadd %real_slot\n    %real_out =l add %real_data, %offset\n    stored %real, %real_out\n    jmp @advance\n@pack_bytes\n    %length_slot =l add %frame, 16\n    %length =l loadl %length_slot\n    %empty =w ceql %length, 0\n    jnz %empty, @empty, @copy\n@empty\n    jmp @make_buffer\n@copy\n    jmp @make_buffer\n@make_buffer\n    %data =l phi @empty $trbn_sqlite_empty_bytes, @copy %payload\n    %managed =l call $trbn_string_from_bytes(l %data, l %length)\n    %buffer_slot =l add %buffer_data, %offset\n    storel %managed, %buffer_slot\n    jmp @advance\n@advance\n    %following =l add %index, 1\n    jmp @next\n@return\n    ret\n}\n\n")
	qbe_output_line(output, "export function l $trbn_sqlite_query(l %source, l %statement, l %kinds, l %words, l %reals, l %buffers, l %mode, l %busy, l %out_kinds, l %out_words, l %out_reals, l %out_buffers, l %scope) {\n@start\n    %path =l call $sqlite_c_string(l %source)\n    %sql =l call $sqlite_c_string(l %statement)\n    %cell_count =l call $sqlite_array_length(l %kinds)\n    %word_count =l call $sqlite_array_length(l %words)\n    %real_count =l call $sqlite_array_length(l %reals)\n    %buffer_count =l call $sqlite_array_length(l %buffers)\n    %width =l call $sqlite_array_length(l %out_kinds)\n    %word_width =l call $sqlite_array_length(l %out_words)\n    %real_width =l call $sqlite_array_length(l %out_reals)\n    %buffer_width =l call $sqlite_array_length(l %out_buffers)\n    %has_source =w cnel %path, 0\n    %has_sql =w cnel %sql, 0\n    %count_valid =w culel %cell_count, 32766\n    %has_words =w ceql %word_count, %cell_count\n    %has_reals =w ceql %real_count, %cell_count\n    %has_buffers =w ceql %buffer_count, %cell_count\n    %width_offset =l sub %width, 1\n    %width_valid =w culel %width_offset, 32766\n    %same_words =w ceql %width, %word_width\n    %same_reals =w ceql %width, %real_width\n    %same_buffers =w ceql %width, %buffer_width\n    %timeout_valid =w culel %busy, 2147483647\n    %mode_valid =w culel %mode, 2\n    %identity =w loadub $trbn_sqlite_build_identity\n    %artifact_valid =w ceqw %identity, 84\n    %source_valid =w and %has_source, %has_sql\n    %parameters_numeric =w and %has_words, %has_reals\n    %parameters_present =w and %parameters_numeric, %has_buffers\n    %parameters_valid =w and %parameters_present, %count_valid\n    %input_valid =w and %source_valid, %parameters_valid\n    %numeric_width =w and %same_words, %same_reals\n    %matched_width =w and %numeric_width, %same_buffers\n    %output_valid =w and %matched_width, %width_valid\n    %configuration_valid =w and %timeout_valid, %mode_valid\n    %call_valid =w and %input_valid, %output_valid\n    %environment_valid =w and %artifact_valid, %configuration_valid\n    %valid =w and %call_valid, %environment_valid\n    jnz %valid, @allocate, @invalid\n@allocate\n    %all_cells =l add %cell_count, %width\n    %bytes =l mul %all_cells, 32\n    %cells =l call $malloc(l %bytes)\n    %ready =w cnel %cells, 0\n    jnz %ready, @prepare, @allocation_failed\n@prepare\n    %checked =w call $sqlite_prepare_cells(l %cells, l %kinds, l %words, l %reals, l %buffers, l %cell_count)\n    jnz %checked, @release, @run\n@run\n    %parameter_bytes =l mul %cell_count, 32\n    %row =l add %cells, %parameter_bytes\n    %request =l alloc8 24\n    %cell_slot =l add %request, 8\n    %count_slot =l add %request, 16\n    storel %sql, %request\n    storel %cells, %cell_slot\n    storew %cell_count, %count_slot\n    %shape =l call $sqlite_array_data(l %out_kinds)\n    %has_scope =w cnel %scope, 0\n    jnz %has_scope, @scoped, @standalone\n@scoped\n    %session =l call $sqlite_session_lookup(l %scope)\n    %has_session =w cnel %session, 0\n    jnz %has_session, @scoped_query, @closed\n@scoped_query\n    %db_address =l add %session, 32\n    %db =l loadl %db_address\n    %row_bytes =l mul %width, 32\n    call $memset(l %row, w 0, l %row_bytes)\n    %write =w ceql %mode, 1\n    %scoped_status =w call $sqlite_query_on_connection(l %db, l %request, w %write, l %row, w %width, l %shape)\n    jnz %scoped_status, @scoped_error, @publish\n@scoped_error\n    call $trbn_sqlite_free_row(l %row, w %width)\n    jmp @release\n@closed\n    jmp @release\n@standalone\n    %status =w call $trbn_sqlite_single_row(l %path, l %request, w %mode, w %busy, l %row, w %width, l %shape)\n    jnz %status, @release, @publish\n@publish\n    call $sqlite_publish_row(l %row, l %width, l %out_kinds, l %out_words, l %out_reals, l %out_buffers)\n    call $trbn_sqlite_free_row(l %row, w %width)\n    jmp @release\n@release\n    %outcome =w phi @prepare %checked, @standalone %status, @closed -1, @scoped_error %scoped_status, @publish 0\n    call $free(l %cells)\n    %result =l extsw %outcome\n    ret %result\n@invalid\n    ret 21\n@allocation_failed\n    ret 7\n}\n\n")
end
