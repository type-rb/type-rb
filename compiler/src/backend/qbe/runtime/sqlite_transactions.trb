import { QbeOutput, qbe_output_line } from backend/qbe/output

# Sessions use monotonic IDs. Only native frames retain SQLite pointers.
# The shared cleanup stack rolls back interrupted scopes in lexical order.
def emit_sqlite_transaction_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $sqlite_sessions = align 8 { l 0 }\ndata $sqlite_last_session = align 8 { l 0 }\ndata $sqlite_savepoint = { b \"SAVEPOINT trbn_orm_nested\", b 0 }\ndata $sqlite_release_savepoint = { b \"RELEASE trbn_orm_nested\", b 0 }\ndata $sqlite_rollback_savepoint = { b \"ROLLBACK TO trbn_orm_nested; RELEASE trbn_orm_nested\", b 0 }\n\n")
	qbe_output_line(output, "function l $sqlite_session_lookup(l %id) {\n@start\n    %first =l loadl $sqlite_sessions\n    jmp @next\n@next\n    %node =l phi @start %first, @advance %previous\n    jnz %node, @inspect, @absent\n@inspect\n    %idp =l add %node, 40\n    %current =l loadl %idp\n    %same =w ceql %id, %current\n    jnz %same, @health, @advance\n@health\n    %rootp =l add %node, 48\n    %root =l loadl %rootp\n    %poisonp =l add %root, 56\n    %poison =w loadw %poisonp\n    jnz %poison, @absent, @found\n@advance\n    %prevp =l add %node, 24\n    %previous =l loadl %prevp\n    jmp @next\n@found\n    ret %node\n@absent\n    ret 0\n}\n\n")
	qbe_output_line(output, "function w $sqlite_session_close(l %node) {\n@start\n    %prevp =l add %node, 24\n    %previous =l loadl %prevp\n    storel %previous, $sqlite_sessions\n    %dbp =l add %node, 32\n    %db =l loadl %dbp\n    %rootp =l add %node, 48\n    %root =l loadl %rootp\n    %outer =w ceql %root, %node\n    jnz %outer, @outer, @inner\n@outer\n    jmp @mode\n@inner\n    jmp @mode\n@mode\n    %commit_sql =l phi @outer $sqlite_commit_write, @inner $sqlite_release_savepoint\n    %rollback_sql =l phi @outer $sqlite_rollback_write, @inner $sqlite_rollback_savepoint\n    %finishp =l add %node, 8\n    %commit =w loadw %finishp\n    %poisonp =l add %root, 56\n    %poison =w loadw %poisonp\n    jnz %commit, @check_commit, @rollback\n@check_commit\n    jnz %poison, @rollback, @commit\n@commit\n    %committed =w call $sqlite3_exec(l %db, l %commit_sql, l 0, l 0, l 0)\n    jnz %committed, @rollback, @clean\n@rollback\n    %original =w phi @mode 0, @check_commit %poison, @commit %committed\n    %rolled =w call $sqlite3_exec(l %db, l %rollback_sql, l 0, l 0, l 0)\n    jnz %rolled, @poison, @clean\n@poison\n    storew %rolled, %poisonp\n    jmp @clean\n@clean\n    %status =w phi @commit 0, @rollback %original, @poison %rolled\n    jnz %outer, @close, @free\n@close\n    %closed =w call $sqlite3_close(l %db)\n    jnz %status, @free, @closed_status\n@closed_status\n    jmp @free\n@free\n    %result =w phi @clean %status, @close %status, @closed_status %closed\n    call $free(l %node)\n    ret %result\n}\n\n")
	qbe_output_line(output, "export function l $trbn_sqlite_transaction(l %operation, l %source, l %scope) {\n@start\n    %begin =w culel %operation, 1\n    jnz %begin, @allocate, @finish\n@allocate\n    %last =l loadl $sqlite_last_session\n    %available =w csltl %last, 9007199254740991\n    jnz %available, @frame, @overflow\n@frame\n    %node =l call $calloc(l 1, l 64)\n    jnz %node, @begin_kind, @oom\n@begin_kind\n    jnz %operation, @parent, @open_root\n@open_root\n    %path =l call $sqlite_c_string(l %source)\n    jnz %path, @open, @invalid_path\n@open\n    %slot =l alloc8 8\n    storel 0, %slot\n    %opened =w call $sqlite3_open_v2(l %path, l %slot, w 65606, l 0)\n    %owned =l loadl %slot\n    jnz %opened, @open_error, @begin_root\n@begin_root\n    %started =w call $sqlite3_exec(l %owned, l $sqlite_begin_write, l 0, l 0, l 0)\n    jnz %started, @open_error, @register\n@open_error\n    %error =w phi @open %opened, @begin_root %started\n    call $sqlite3_close(l %owned)\n    jmp @discard\n@parent\n    %parent =l call $sqlite_session_lookup(l %scope)\n    jnz %parent, @save, @closed_parent\n@save\n    %parent_db =l add %parent, 32\n    %borrowed =l loadl %parent_db\n    %parent_rootp =l add %parent, 48\n    %parent_root =l loadl %parent_rootp\n    %saved =w call $sqlite3_exec(l %borrowed, l $sqlite_savepoint, l 0, l 0, l 0)\n    jnz %saved, @discard, @register\n@invalid_path\n    jmp @discard\n@closed_parent\n    jmp @discard\n@discard\n    %failed =w phi @invalid_path 14, @open_error %error, @closed_parent 21, @save %saved\n    call $free(l %node)\n    %code =l extsw %failed\n    %negative =l sub 0, %code\n    ret %negative\n@register\n    %db =l phi @begin_root %owned, @save %borrowed\n    %root =l phi @begin_root %node, @save %parent_root\n    %id =l add %last, 1\n    storel %id, $sqlite_last_session\n    %prev =l loadl $sqlite_sessions\n    %resource =l loadl $trbn_resource_scope\n    storel %resource, %node\n    %kindp =l add %node, 12\n    storew 2, %kindp\n    %callbackp =l add %node, 16\n    storel $sqlite_session_close, %callbackp\n    %prevp =l add %node, 24\n    storel %prev, %prevp\n    %dbp =l add %node, 32\n    storel %db, %dbp\n    %idp =l add %node, 40\n    storel %id, %idp\n    %rootp =l add %node, 48\n    storel %root, %rootp\n    storel %node, $sqlite_sessions\n    storel %node, $trbn_resource_scope\n    ret %id\n@finish\n    %valid_op =w culel %operation, 3\n    %current =l loadl $sqlite_sessions\n    %resource_top =l loadl $trbn_resource_scope\n    %top =w ceql %current, %resource_top\n    %active =w cnel %current, 0\n    %usable =w and %active, %top\n    %valid =w and %usable, %valid_op\n    jnz %valid, @match, @invalid\n@match\n    %current_idp =l add %current, 40\n    %current_id =l loadl %current_idp\n    %matches =w ceql %current_id, %scope\n    jnz %matches, @consume, @invalid\n@consume\n    %commit =w ceql %operation, 2\n    %flagp =l add %current, 8\n    storew %commit, %flagp\n    %status =w call $trbn_resource_close(l %current)\n    %wide =l extsw %status\n    %result =l sub 0, %wide\n    ret %result\n@overflow\n    ret -13\n@oom\n    ret -7\n@invalid\n    ret -21\n}\n\n")
end
