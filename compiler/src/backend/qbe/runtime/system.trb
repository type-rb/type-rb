				qbe_output_line(
					output,
					"function w $trbn_run_cc(l %cc, l %assembly, l %output) {\n@start\n\t%dead_strip =l loadl $trbn_selected_dead_strip\n\t%a =l alloc8 56\n\tstorel %cc, %a\n\t%a1 =l add %a, 8\n\tstorel %assembly, %a1\n\t%a2 =l add %a, 16\n\tstorel %dead_strip, %a2\n\t%a3 =l add %a, 24\n\tstorel $trbn_math_library, %a3\n\t%a4 =l add %a, 32\n\tstorel $trbn_o_flag, %a4\n\t%a5 =l add %a, 40\n\tstorel %output, %a5\n\t%a6 =l add %a, 48\n\tstorel 0, %a6\n\t%r =w call $trbn_run(l %cc, l %a)\n\tret %r\n}\n",
				)
			else
				if string_starts_with(line, "function l $trbn_read_source")
					qbe_output_line(
						output,
						"function l $trbn_read_source(l %path) {\n@start\n\t%data =l add %path, 24\n\t%source =l call $trbn_read_file(l %data)\n\tret %source\n}\n",
					)
				else
					if !project_runtime_qbe_line(line)
						qbe_output_line(output, line)
					end
				end
			end
		end
		index += 1
	end
	emit_utf8_runtime(output)
	emit_fixed_string_concat_runtime("trbn_string_concat", 2, output)
	if needs.concat_three
		emit_fixed_string_concat_runtime("trbn_string_concat_three", 3, output)
	end
	if needs.concat_many
		emit_string_concat_runtime(output)
	end
	if needs.queries
		emit_string_query_runtime(output)
	end
	if needs.sequences
		emit_string_sequence_runtime(output)
	end
	if needs.slices
		emit_string_slice_runtime(output)
	end
	if needs.trimming
		emit_string_trim_runtime(output)
	end
	if needs.transforms
		emit_string_transform_runtime(output)
	end
	if needs.case_mapping
		emit_string_case_runtime(output)
	end
	if needs.copies
		emit_array_copy_runtime(output)
	end
	if needs.join
		emit_array_join_runtime(output)
	end
	if needs.mutations
		emit_array_mutation_runtime(output)
	end
	emit_string_literal_runtime(output)
	emit_managed_runtime(output)
	return
end

# Append an already validated managed pointer. Runtime allocation establishes
# that precondition itself; arbitrary inputs still use the generic guards.
# Growth owns realloc/failure policy, and no buffer address survives its call.
def emit_gc_temp_append(value: String, mut output: QbeOutput)
	qbe_output_line(output, "\t%root_count =l loadl $trbn_gc_temp_count\n\t%root_capacity =l loadl $trbn_gc_temp_capacity\n\t%root_full =w ceql %root_count, %root_capacity\n\tjnz %root_full, @root_grow, @root_store\n@root_grow\n\tcall $trbn_gc_temp_grow(l " + value + ", l %root_count, l %root_capacity)\n\tjmp @root_finish\n@root_store\n\t%root_data =l loadl $trbn_gc_temp_data\n\t%root_offset =l shl %root_count, 3\n\t%root_slot =l add %root_data, %root_offset\n\tstorel " + value + ", %root_slot\n\t%root_next =l add %root_count, 1\n\tstorel %root_next, $trbn_gc_temp_count\n@root_finish")
end

def emit_managed_runtime(mut output: QbeOutput)
	emit_gc_mark_runtime(output)
	emit_managed_storage_runtime(output)
	emit_global_roots_runtime(output)
	qbe_output_line(output, "data $trbn_gc_heap = align 8 { l 0 }\ndata $trbn_gc_global_roots = align 8 { z 96 }\ndata $trbn_gc_temp_data = align 8 { l 0 }\ndata $trbn_gc_temp_count = align 8 { l 0 }\ndata $trbn_gc_temp_capacity = align 8 { l 0 }\ndata $trbn_gc_heap_bytes = align 8 { l 0 }\ndata $trbn_gc_heap_target = align 8 { l 1048576 }\ndata $trbn_gc_collection_count = align 8 { l 0 }\ndata $trbn_gc_automatic_collection_count = align 8 { l 0 }\ndata $trbn_gc_allocated_bytes = align 8 { l 0 }\ndata $trbn_gc_reclaimed_bytes = align 8 { l 0 }\ndata $trbn_gc_peak_heap_bytes = align 8 { l 0 }\ndata $trbn_gc_trace_enabled = align 8 { l 0 }\ndata $trbn_desc_string = align 8 { l 0 }\ndata $trbn_desc_array_scalar = align 8 { l 2, l 0 }\ndata $trbn_desc_array_managed = align 8 { l 2, l 1 }\ndata $trbn_desc_project_sources = align 8 { l 1, l 3, l 24, l 8, l 16, l 24 }\ndata $trbn_gc_stats_environment = { b \"TYPE_RB_NATIVE_RUNTIME_STATS\", b 0 }\ndata $trbn_gc_trace_environment = { b \"TYPE_RB_NATIVE_RUNTIME_TRACE\", b 0 }\ndata $trbn_gc_trace_collection = { b \"type-rb-native-gc-trace-v1,collection,\" }\ndata $trbn_gc_trace_automatic = { b \"type-rb-native-gc-trace-v1,automatic,\" }\ndata $trbn_gc_trace_live = { b \"type-rb-native-gc-trace-v1,live-bytes,\" }\ndata $trbn_gc_trace_target = { b \"type-rb-native-gc-trace-v1,next-target-bytes,\" }\ndata $trbn_gc_trace_roots = { b \"type-rb-native-gc-trace-v1,root-count,\" }\ndata $trbn_gc_trace_capacity = { b \"type-rb-native-gc-trace-v1,root-capacity,\" }\ndata $trbn_gc_report_collections = { b \"type-rb-native-gc-stat-v1,collections,\" }\ndata $trbn_gc_report_automatic = { b \"type-rb-native-gc-stat-v1,automatic-collections,\" }\ndata $trbn_gc_report_allocated = { b \"type-rb-native-gc-stat-v1,allocated-bytes,\" }\ndata $trbn_gc_report_reclaimed = { b \"type-rb-native-gc-stat-v1,reclaimed-bytes,\" }\ndata $trbn_gc_report_live = { b \"type-rb-native-gc-stat-v1,live-bytes,\" }\ndata $trbn_gc_report_peak = { b \"type-rb-native-gc-stat-v1,peak-heap-bytes,\" }\n\nfunction $trbn_gc_update_peak(l %candidate) {\n@start\n\t%peak =l loadl $trbn_gc_peak_heap_bytes\n\t%greater =w csgtl %candidate, %peak\n\tjnz %greater, @store, @finish\n@store\n\tstorel %candidate, $trbn_gc_peak_heap_bytes\n\tret\n@finish\n\tret\n}\n\nfunction $trbn_gc_maybe_collect(l %additional) {\n@start\n\t%before =l loadl $trbn_gc_heap_bytes\n\t%projected =l add %before, %additional\n\t%target =l loadl $trbn_gc_heap_target\n\t%over =w csgtl %projected, %target\n\tjnz %over, @collect, @finish\n@collect\n\tcall $trbn_gc_collect(w 1)\n@finish\n\tret\n}\n\nfunction $trbn_gc_temp_push(l %value) {\n@start\n\t%nil =w ceql %value, 0\n\tjnz %nil, @root_finish, @descriptor\n@descriptor\n\t%descriptor_mark =l loadl %value\n\t%static =w ceql %descriptor_mark, 0\n\tjnz %static, @root_finish, @root_append\n@root_append\n")
	emit_gc_temp_append("%value", output)
	qbe_output_line(output, "\tret\n}\n\nfunction $trbn_gc_temp_grow(l %value, l %count, l %capacity) {\n@start\n\t%empty =w ceql %capacity, 0\n\tjnz %empty, @minimum, @double\n@minimum\n\t%minimum =l copy 64\n\tjmp @allocate\n@double\n\t%doubled =l mul %capacity, 2\n\tjmp @allocate\n@allocate\n\t%next_capacity =l phi @minimum %minimum, @double %doubled\n\t%bytes =l mul %next_capacity, 8\n\t%data =l loadl $trbn_gc_temp_data\n\t%new_data =l call $realloc(l %data, l %bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@grown\n\tstorel %new_data, $trbn_gc_temp_data\n\tstorel %next_capacity, $trbn_gc_temp_capacity\n\t%offset =l mul %count, 8\n\t%slot =l add %new_data, %offset\n\tstorel %value, %slot\n\t%next_count =l add %count, 1\n\tstorel %next_count, $trbn_gc_temp_count\n\tret\n}\n\nfunction $trbn_gc_temp_reset(l %base) {\n@start\n\tstorel %base, $trbn_gc_temp_count\n\tret\n}\n\nfunction l $trbn_gc_alloc(l %descriptor, l %payload_size, l %reserved_size) {\n@start\n\t%total =l add %payload_size, 16\n\t%projected =l add %total, %reserved_size\n\tcall $trbn_gc_maybe_collect(l %projected)\n\t%base =l call $trbn_storage_alloc(l %total)\n\t%failed =w ceql %base, 0\n\tjnz %failed, @fail, @initialize\n@fail\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@initialize\n\t%head =l loadl $trbn_gc_heap\n\tstorel %head, %base\n\t%object =l add %base, 8\n\tstorel %descriptor, %object\n\t%payload =l add %object, 8\n\t%string =w ceql %descriptor, $trbn_desc_string\n\tjnz %string, @string_header, @zero_payload\n@string_header\n\tstorel 0, %payload\n\t%points =l add %payload, 8\n\tstorel 0, %points\n\tjmp @account\n@zero_payload\n\tcall $memset(l %payload, w 0, l %payload_size)\n\tjmp @account\n@account\n\t%bytes =l loadl $trbn_gc_heap_bytes\n\t%updated =l add %bytes, %total\n\tstorel %updated, $trbn_gc_heap_bytes\n\t%allocated =l loadl $trbn_gc_allocated_bytes\n\t%new_allocated =l add %allocated, %total\n\tstorel %new_allocated, $trbn_gc_allocated_bytes\n\tcall $trbn_gc_update_peak(l %updated)\n\tstorel %base, $trbn_gc_heap\n")
	emit_gc_temp_append("%object", output)
	qbe_output_line(output, "\tret %object\n}\n\nfunction $trbn_gc_mark_roots() {\n@start\n\t%temp_count =l loadl $trbn_gc_temp_count\n\t%temp_data =l loadl $trbn_gc_temp_data\n\tjmp @temp_loop\n@temp_loop\n\t%temp_index =l phi @start 0, @temp %next_temp\n\t%temps_done =w cslel %temp_count, %temp_index\n\tjnz %temps_done, @globals, @temp\n@temp\n\t%temp_scaled =l mul %temp_index, 8\n\t%temp_slot =l add %temp_data, %temp_scaled\n\t%temp_reference =l loadl %temp_slot\n\tcall $trbn_gc_mark(l %temp_reference)\n\t%next_temp =l add %temp_index, 1\n\tjmp @temp_loop\n@globals\n\tjmp @global_loop\n@global_loop\n\t%global_index =l phi @globals 0, @global %next_global\n\t%globals_done =w cslel 12, %global_index\n\tjnz %globals_done, @finish, @global\n@global\n\t%global_scaled =l mul %global_index, 8\n\t%global_slot =l add $trbn_gc_global_roots, %global_scaled\n\t%global_reference =l loadl %global_slot\n\tcall $trbn_gc_mark(l %global_reference)\n\t%next_global =l add %global_index, 1\n\tjmp @global_loop\n@finish\n\tret\n}\n\nfunction $trbn_gc_sweep() {\n@start\n\t%head =l loadl $trbn_gc_heap\n\tjmp @loop\n@loop\n\t%current =l phi @start %head, @advance %next\n\t%previous =l phi @start 0, @advance %next_previous\n\t%done =w ceql %current, 0\n\tjnz %done, @finish, @object\n@object\n\t%next =l loadl %current\n\t%descriptor_address =l add %current, 8\n\t%descriptor_mark =l loadl %descriptor_address\n\t%mark =l and %descriptor_mark, 1\n\t%live =w cnel %mark, 0\n\tjnz %live, @keep, @release\n@keep\n\t%descriptor =l and %descriptor_mark, -2\n\tstorel %descriptor, %descriptor_address\n\tjmp @advance\n@release\n\t%released_descriptor =l and %descriptor_mark, -2\n\t%kind =l loadl %released_descriptor\n\t%array =w ceql %kind, 2\n\tjnz %array, @release_array, @check_fixed\n@release_array\n\t%data_address =l add %current, 32\n\t%data =l loadl %data_address\n\t%capacity_address =l add %current, 24\n\t%capacity =l loadl %capacity_address\n\t%backing_bytes =l mul %capacity, 8\n\t%heap_with_backing =l loadl $trbn_gc_heap_bytes\n\t%heap_without_backing =l sub %heap_with_backing, %backing_bytes\n\tstorel %heap_without_backing, $trbn_gc_heap_bytes\n\t%reclaimed_before_backing =l loadl $trbn_gc_reclaimed_bytes\n\t%reclaimed_with_backing =l add %reclaimed_before_backing, %backing_bytes\n\tstorel %reclaimed_with_backing, $trbn_gc_reclaimed_bytes\n\t%has_data =w cnel %data, 0\n\tjnz %has_data, @free_data, @array_ready\n@free_data\n\tcall $trbn_array_backing_release(l %data, l %capacity)\n\tjmp @array_ready\n@array_ready\n\t%array_size =l copy 40\n\tjmp @unlink\n@check_fixed\n\t%fixed =w ceql %kind, 1\n\tjnz %fixed, @fixed_size, @string_size\n@fixed_size\n\t%payload_size_address =l add %released_descriptor, 16\n\t%payload_size =l loadl %payload_size_address\n\t%fixed_size =l add %payload_size, 16\n\tjmp @unlink\n@string_size\n\t%length_address =l add %current, 16\n\t%length =l loadl %length_address\n\t%string_size =l add %length, 33\n\tjmp @unlink\n@unlink\n\t%size =l phi @array_ready %array_size, @fixed_size %fixed_size, @string_size %string_size\n\t%at_head =w ceql %previous, 0\n\tjnz %at_head, @unlink_head, @unlink_after\n@unlink_head\n\tstorel %next, $trbn_gc_heap\n\tjmp @account\n@unlink_after\n\tstorel %next, %previous\n@account\n\t%bytes =l loadl $trbn_gc_heap_bytes\n\t%remaining =l sub %bytes, %size\n\tstorel %remaining, $trbn_gc_heap_bytes\n\t%reclaimed =l loadl $trbn_gc_reclaimed_bytes\n\t%new_reclaimed =l add %reclaimed, %size\n\tstorel %new_reclaimed, $trbn_gc_reclaimed_bytes\n\tcall $trbn_storage_free(l %current, l %size)\n\tjmp @advance\n@advance\n\t%next_previous =l phi @keep %current, @account %previous\n\tjmp @loop\n@finish\n\tret\n}\n\nfunction $trbn_gc_collect(w %automatic) {\n@start\n\tcall $trbn_gc_mark_constants()\n\tcall $trbn_gc_mark_roots()\n\tcall $trbn_gc_sweep()\n\t%count =l loadl $trbn_gc_collection_count\n\t%next_count =l add %count, 1\n\tstorel %next_count, $trbn_gc_collection_count\n\tjnz %automatic, @automatic, @pace\n@automatic\n\t%automatic_count =l loadl $trbn_gc_automatic_collection_count\n\t%next_automatic =l add %automatic_count, 1\n\tstorel %next_automatic, $trbn_gc_automatic_collection_count\n\tjmp @pace\n@pace\n\t%live =l loadl $trbn_gc_heap_bytes\n\t%doubled =l mul %live, 2\n\t%candidate =l add %doubled, 65536\n\t%small =w csltl %candidate, 1048576\n\tjnz %small, @minimum, @candidate\n@minimum\n\tstorel 1048576, $trbn_gc_heap_target\n\tjmp @trace\n@candidate\n\tstorel %candidate, $trbn_gc_heap_target\n\tjmp @trace\n@trace\n\tcall $trbn_gc_trace(w %automatic, l %next_count)\n\tret\n}\n\nfunction $trbn_gc_trace_initialize() {\n@start\n\t%enabled =l call $getenv(l $trbn_gc_trace_environment)\n\tstorel %enabled, $trbn_gc_trace_enabled\n\tret\n}\n\nfunction $trbn_gc_trace(w %automatic, l %collection) {\n@start\n\t%enabled =l loadl $trbn_gc_trace_enabled\n\t%disabled =w ceql %enabled, 0\n\tjnz %disabled, @finish, @select\n@select\n\t%manual =w ceqw %automatic, 0\n\tjnz %manual, @emit, @interval\n@interval\n\t%remainder =l rem %collection, 64\n\t%sampled =w ceql %remainder, 0\n\tjnz %sampled, @emit, @finish\n@emit\n\tcall $trbn_gc_report(l $trbn_gc_trace_collection, l 38, l %collection)\n\t%automatic_value =l extuw %automatic\n\tcall $trbn_gc_report(l $trbn_gc_trace_automatic, l 37, l %automatic_value)\n\t%live =l loadl $trbn_gc_heap_bytes\n\tcall $trbn_gc_report(l $trbn_gc_trace_live, l 38, l %live)\n\t%target =l loadl $trbn_gc_heap_target\n\tcall $trbn_gc_report(l $trbn_gc_trace_target, l 45, l %target)\n\t%roots =l loadl $trbn_gc_temp_count\n\tcall $trbn_gc_report(l $trbn_gc_trace_roots, l 38, l %roots)\n\t%capacity =l loadl $trbn_gc_temp_capacity\n\tcall $trbn_gc_report(l $trbn_gc_trace_capacity, l 41, l %capacity)\n@finish\n\tret\n}\n\nfunction $trbn_gc_report(l %label, l %label_size, l %value) {\n@start\n\tcall $write(w 2, l %label, l %label_size)\n\t%buffer =l alloc8 32\n\t%end =l add %buffer, 32\n\t%cursor_slot =l alloc8 8\n\t%value_slot =l alloc8 8\n\tstorel %end, %cursor_slot\n\tstorel %value, %value_slot\n\t%zero =w ceql %value, 0\n\tjnz %zero, @zero, @loop\n@zero\n\t%zero_cursor =l sub %end, 1\n\tstoreb 48, %zero_cursor\n\tstorel %zero_cursor, %cursor_slot\n\tjmp @write\n@loop\n\t%current =l loadl %value_slot\n\t%done =w ceql %current, 0\n\tjnz %done, @write, @digit\n@digit\n\t%remainder =l rem %current, 10\n\t%digit =l add %remainder, 48\n\t%digit_byte =w copy %digit\n\t%cursor =l loadl %cursor_slot\n\t%next_cursor =l sub %cursor, 1\n\tstoreb %digit_byte, %next_cursor\n\tstorel %next_cursor, %cursor_slot\n\t%remaining =l div %current, 10\n\tstorel %remaining, %value_slot\n\tjmp @loop\n@write\n\t%start =l loadl %cursor_slot\n\t%size =l sub %end, %start\n\tcall $write(w 2, l %start, l %size)\n\tcall $write(w 2, l $trbn_newline, l 1)\n\tret\n}\n\nfunction $trbn_gc_finish() {\n@start\n\t%stats_enabled =l call $getenv(l $trbn_gc_stats_environment)\n\t%trace_enabled =l loadl $trbn_gc_trace_enabled\n\t%stats_disabled =w ceql %stats_enabled, 0\n\t%trace_disabled =w ceql %trace_enabled, 0\n\t%disabled =w and %stats_disabled, %trace_disabled\n\tjnz %disabled, @finish, @collect\n@collect\n\tstorel 0, $trbn_gc_temp_count\n\tstorel 0, $trbn_gc_global_storage_root_count\n\tstorel 0, $trbn_gc_global_storage_roots\n\tcall $memset(l $trbn_gc_global_roots, w 0, l 96)\n\tcall $trbn_gc_collect(w 0)\n\tcall $trbn_array_backing_flush()\n\tjnz %stats_disabled, @finish, @report\n@report\n\t%collections =l loadl $trbn_gc_collection_count\n\tcall $trbn_gc_report(l $trbn_gc_report_collections, l 38, l %collections)\n\t%automatic =l loadl $trbn_gc_automatic_collection_count\n\tcall $trbn_gc_report(l $trbn_gc_report_automatic, l 48, l %automatic)\n\t%allocated =l loadl $trbn_gc_allocated_bytes\n\tcall $trbn_gc_report(l $trbn_gc_report_allocated, l 42, l %allocated)\n\t%reclaimed =l loadl $trbn_gc_reclaimed_bytes\n\tcall $trbn_gc_report(l $trbn_gc_report_reclaimed, l 42, l %reclaimed)\n\t%live =l loadl $trbn_gc_heap_bytes\n\tcall $trbn_gc_report(l $trbn_gc_report_live, l 37, l %live)\n\t%peak =l loadl $trbn_gc_peak_heap_bytes\n\tcall $trbn_gc_report(l $trbn_gc_report_peak, l 42, l %peak)\n@finish\n\tret\n}\n")
	qbe_output_line(output, "\nfunction $trbn_gc_temp_reserve(l %required) {\n@start\n\t%capacity =l loadl $trbn_gc_temp_capacity\n\t%enough =w cslel %required, %capacity\n\tjnz %enough, @finish, @initial\n@initial\n\t%empty =w ceql %capacity, 0\n\tjnz %empty, @minimum, @existing\n@minimum\n\t%minimum =l copy 64\n\tjmp @grow\n@existing\n\t%existing =l copy %capacity\n\tjmp @grow\n@grow\n\t%current =l phi @minimum %minimum, @existing %existing, @double %doubled\n\t%large_enough =w cslel %required, %current\n\tjnz %large_enough, @allocate, @double\n@double\n\t%doubled =l mul %current, 2\n\tjmp @grow\n@allocate\n\t%bytes =l mul %current, 8\n\t%data =l loadl $trbn_gc_temp_data\n\t%new_data =l call $realloc(l %data, l %bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @ready\n@fail\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@ready\n\tstorel %new_data, $trbn_gc_temp_data\n\tstorel %current, $trbn_gc_temp_capacity\n@finish\n\tret\n}\n")
	# Traced non-Float Arrays share paced growth and a compact push ABI.
	qbe_output_line(output, "\nfunction $trbn_array_push_paced(l %array, l %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $trbn_array_grow_paced(l %array, l %value, l %length, l %capacity)\n\tret\n@store\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%offset =l shl %length, 3\n\t%target =l add %data, %offset\n\tstorel %value, %target\n\tret\n}\n\nfunction $trbn_array_grow_paced(l %array, l %value, l %length, l %capacity) {\n@start\n\t%new_capacity =l shl %capacity, 2\n\t%new_bytes =l shl %new_capacity, 3\n\t%old_bytes =l shl %capacity, 3\n\t%growth =l sub %new_bytes, %old_bytes\n\tcall $trbn_gc_maybe_collect(l %growth)\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $trbn_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $trbn_gc_heap_bytes\n\t%allocated_before =l loadl $trbn_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $trbn_gc_allocated_bytes\n\tcall $trbn_gc_update_peak(l %heap_after)\n\t%capacity_slot =l add %array, 16\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\t%offset =l shl %length, 3\n\t%target =l add %new_data, %offset\n\tstorel %value, %target\n\t%new_length =l add %length, 1\n\t%length_slot =l add %array, 8\n\tstorel %new_length, %length_slot\n\tret\n}\n")
	return
end

def emit_float_array_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction $trbn_array_push_d(l %array, d %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\t%new_capacity =l mul %capacity, 2\n\t%new_bytes =l mul %new_capacity, 8\n\t%old_bytes =l mul %capacity, 8\n\t%growth =l sub %new_bytes, %old_bytes\n\tcall $trbn_gc_maybe_collect(l %growth)\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $trbn_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $trbn_gc_heap_bytes\n\t%allocated_before =l loadl $trbn_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $trbn_gc_allocated_bytes\n\tcall $trbn_gc_update_peak(l %heap_after)\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\tjmp @store\n@store\n\t%current_data_slot =l add %array, 24\n\t%current_data =l loadl %current_data_slot\n\t%offset =l mul %length, 8\n\t%target =l add %current_data, %offset\n\tstored %value, %target\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\tret\n}")
	return
end

def emit_process_runtime(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\ndata $trbn_process_argc = align 8 { l 0 }\ndata $trbn_process_argv_pointer = align 8 { l 0 }\n\nfunction l $trbn_process_argv() {\n@start\n\t%array =l call $trbn_array_new(l $trbn_desc_array_managed)\n\t%argc =l loadl $trbn_process_argc\n\t%argv =l loadl $trbn_process_argv_pointer\n\tjmp @loop\n@loop\n\t%index =l phi @start 1, @append %next\n\t%done =w cslel %argc, %index\n\tjnz %done, @finish, @load\n@load\n\t%offset =l mul %index, 8\n\t%cell =l add %argv, %offset\n\t%source =l loadl %cell\n\t%string =l call $trbn_string_from_c(l %source)\n\tcall $trbn_array_push_paced(l %array, l %string)\n\tjmp @append\n@append\n\t%next =l add %index, 1\n\tjmp @loop\n@finish\n\tret %array\n}",
	)
	return
end

def emit_float_to_integer_runtime(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\ndata $trbn_float_integer_error = { b \"panic: Float cannot be converted to Integer\", b 10 }\n\nfunction l $trbn_float_to_integer(d %value) {\n@start\n\t%self_difference =d sub %value, %value\n\t%finite =w ceqd %self_difference, %self_difference\n\tjnz %finite, @range, @nonfinite\n@range\n\t%too_high =w cgtd %value, d_9007199254740991.0\n\t%too_low =w cltd %value, d_-9007199254740991.0\n\t%outside =w or %too_high, %too_low\n\tjnz %outside, @outside, @convert\n@convert\n\t%result =l dtosi %value\n\tret %result\n@nonfinite\n\tcall $trbn_fail(l $trbn_float_integer_error, l 44)\n\thlt\n@outside\n\tcall $trbn_fail(l $trbn_integer_range_error, l 45)\n\thlt\n}",
	)
	return
end

# Output conversion is a builtin operation, not user-defined to_s dispatch.
def emit_boolean_puts_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function l $trbn_boolean_to_string(l %value) {\n@start\n %value_nonzero =w cnel %value, 0\n jnz %value_nonzero, @true, @false\n@true\n ret $trbn_true_text\n@false\n ret $trbn_false_text\n}\n")
	qbe_output_line(
		output,
		"\ndata $trbn_true_text = align 8 { l 0, l 4, l 4, b \"true\", b 0 }\ndata $trbn_false_text = align 8 { l 0, l 5, l 5, b \"false\", b 0 }\nfunction $trbn_puts_boolean(l %value) {\n@start\n\t%value_nonzero =w cnel %value, 0\n\tjnz %value_nonzero, @true, @false\n@true\n\tcall $trbn_puts(l $trbn_true_text)\n\tret\n@false\n\tcall $trbn_puts(l $trbn_false_text)\n\tret\n}",
	)
end
