import { emit_sqlite_link_runtime } from backend/qbe/runtime/sqlite_link
import { emit_gc_mark_runtime } from backend/qbe/runtime/gc_mark
import { emit_oidc_link_runtime } from backend/qbe/runtime/oidc_link
import { emit_crypto_link_runtime } from backend/qbe/runtime/crypto_link
import { emit_compression_link_runtime } from backend/qbe/runtime/compression_link
import { emit_network_link_runtime } from backend/qbe/runtime/network_link
import { emit_failure_recovery_runtime } from backend/qbe/runtime/failure_recovery
import { array_construction_qbe } from backend/qbe/runtime/array_construction
import { QbeRuntimeNeeds } from backend/qbe/runtime/requirements
import { emit_managed_storage_runtime } from backend/qbe/runtime/managed_storage
import { emit_global_roots_runtime } from backend/qbe/emit/globals
import { emit_array_join_runtime } from backend/qbe/runtime/array_join
import { emit_array_copy_runtime } from backend/qbe/runtime/array_copies
import { emit_array_mutation_runtime } from backend/qbe/runtime/array_mutations
import { emit_string_literal_runtime } from backend/qbe/runtime/string_literals
import { emit_string_slice_runtime } from backend/qbe/runtime/string_slices
import { emit_string_trim_runtime } from backend/qbe/runtime/string_trimming
import { emit_fixed_string_concat_runtime, emit_string_concat_runtime, emit_string_transform_runtime } from backend/qbe/runtime/string_transforms
import { emit_string_case_runtime } from backend/qbe/runtime/string_case
import { emit_string_sequence_runtime } from backend/qbe/runtime/string_sequences
import { emit_string_query_runtime } from backend/qbe/runtime/string_queries
import { emit_utf8_runtime } from backend/qbe/emit/strings
import { string_starts_with } from support/path
import { QbeOutput, qbe_output_line } from backend/qbe/output

def project_runtime_qbe_line(value: String): Boolean
	if string_starts_with(value, "data $trbn_project_")
		return true
	end
	if string_starts_with(value, "function l $trbn_source_slice")
		return true
	end
	if string_starts_with(value, "function w $trbn_c_")
		return true
	end
	if string_starts_with(value, "function w $trbn_project_")
		return true
	end
	return string_starts_with(value, "function l $trbn_collect_project_sources")
end

# String constructors fill every byte and terminator before returning, without
# allocating after string_alloc. The allocator initializes their two header words
# but leaves byte storage unwritten; all other managed payloads are zeroed.
def emit_qbe_runtime_selected(mut output: QbeOutput, project_runtime: Boolean, needs: QbeRuntimeNeeds, deadlines: Boolean)
	if project_runtime
		emit_network_link_runtime(output)
		emit_compression_link_runtime(output)
		emit_crypto_link_runtime(output)
		emit_sqlite_link_runtime(output)
		emit_oidc_link_runtime(output)
	end
	# Runtime.fail never returns. Its String operand has already been evaluated
	# and rooted by verified MIR; reporting cannot allocate or run a collector.
	qbe_output_line(output, "data $trbn_runtime_fail_prefix = { b \"panic: \" }")
	emit_failure_recovery_runtime(output, deadlines)
	qbe_output_line(output, "function $trbn_runtime_fail(l %message) {\n@start\n\tcall $trbn_gc_temp_push(l %message)\n\t%length_address =l add %message, 8\n\t%length =l loadl %length_address\n\t%data =l add %message, 24\n\tcall $trbn_failure_notice(l %data, l %length, l 0, l 0, l 0, l 0)\n\tcall $trbn_unwind()\n\tcall $write(w 2, l $trbn_runtime_fail_prefix, l 7)\n\tcall $write(w 2, l %data, l %length)\n\tcall $write(w 2, l $trbn_newline, l 1)\n\tcall $exit(w 2)\n\thlt\n}\n")
	qbe_output_line(output, "data $trbn_clamp_error = { b \"panic: clamp minimum exceeds maximum\", b 10 }")
	qbe_output_line(output, "data $trbn_concurrent_limit_error = { b \"panic: concurrent_map limit must be greater than zero\", b 10 }")
	qbe_output_line(output, "data $trbn_slice_size_error = { b \"panic: each_slice size must be greater than zero\", b 10 }")
	# Indexed ASCII characters use fixed static String slots in the single-mutator runtime.
	# Each access stores the same length/payload; descriptor and terminator stay
	# zero, so collection never traces or frees these bounded immutable values.
	# The multiply helper's 26-bit fast entry proves the direct product is below
	# the portable limit; every other pair continues through its exact checks.
	lines := [
		"data $trbn_newline = { b 10 }\ndata $string_byte_values = align 8 { z 4096 }\ndata $trbn_string_storage = align 8 { l 0, l 0, l 0 }\ndata $trbn_temporary_storage = align 8 { l 0, l 0 }\ndata $trbn_allocation_error = { b 112 97 110 105 99 58 32 97 108 108 111 99 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $trbn_bounds_error = { b 112 97 110 105 99 58 32 105 110 100 101 120 32 105 115 32 111 117 116 32 111 102 32 98 111 117 110 100 115 10 }\ndata $trbn_integer_error = { b 112 97 110 105 99 58 32 73 110 116 101 103 101 114 32 111 112 101 114 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $trbn_integer_range_error = { b \"panic: Integer is outside the portable range\", b 10 }\ndata $trbn_division_error = { b \"panic: division by zero\", b 10 }\ndata $trbn_usage_error = { b \"usage: compiler {check|emit-qbe} SOURCE\", b 10, b \"       compiler build SOURCE --output OUTPUT --qbe QBE --cc CC\", b 10 }\ndata $trbn_file_error = { b \"compiler: cannot read source file: \" }\ndata $trbn_check = { b \"check\", b 0 }\ndata $trbn_emit = { b \"emit-qbe\", b 0 }\ndata $trbn_build = { b \"build\", b 0 }\ndata $trbn_output_flag = { b \"--output\", b 0 }\ndata $trbn_qbe_flag = { b \"--qbe\", b 0 }\ndata $trbn_cc_flag = { b \"--cc\", b 0 }\ndata $trbn_target_option = { b \"--target\", b 0 }\ndata $trbn_source_arg = { b \"--source-content\", b 0 }\ndata $trbn_source_file_arg = { b \"--source-file\", b 0 }\ndata $trbn_rb = { b \"rb\", b 0 }\ndata $trbn_wb = { b \"wb\", b 0 }\ndata $trbn_ssa_suffix = { b \".trbn.ssa\", b 0 }\ndata $trbn_asm_suffix = { b \".trbn.s\", b 0 }\ndata $trbn_temp_suffix = { b \".trbn.XXXXXX\", b 0 }\ndata $trbn_slash = { b \"/\", b 0 }\ndata $trbn_target_flag = { b \"-t\", b 0 }\ndata $trbn_profile_darwin_arm64 = { b \"darwin-arm64-v0\", b 0 }\ndata $trbn_profile_linux_arm64 = { b \"linux-arm64-v0\", b 0 }\ndata $trbn_profile_linux_amd64 = { b \"linux-amd64-v0\", b 0 }\ndata $trbn_qbe_darwin_arm64 = { b \"arm64_apple\", b 0 }\ndata $trbn_qbe_linux_arm64 = { b \"arm64\", b 0 }\ndata $trbn_qbe_linux_amd64 = { b \"amd64_sysv\", b 0 }\ndata $trbn_o_flag = { b \"-o\", b 0 }\ndata $trbn_math_library = { b \"-lm\", b 0 }",
		"data $trbn_project_assembler_input = { b \"-xassembler\", b 0 }",
		"data $trbn_project_linker_lld = { b \"-fuse-ld=lld\", b 0 }",
		"data $trbn_dead_strip_darwin = { b \"-Wl,-dead_strip,-x\", b 0 }",
		"data $trbn_dead_strip_linux = { b \"-Wl,--gc-sections,--strip-all,--no-eh-frame-hdr\", b 0 }",
		"data $trbn_selected_qbe_target = align 8 { l $trbn_qbe_darwin_arm64 }",
		"data $trbn_selected_dead_strip = align 8 { l $trbn_dead_strip_darwin }",
		"data $trbn_project_selected_linker = align 8 { l 0 }",
		"data $trbn_project_paths = align 8 { l 0 }\ndata $trbn_project_error = align 8 { l 0 }\ndata $trbn_project_source_root = align 8 { l 0 }\ndata $trbn_project_out_root = align 8 { l 0 }\ndata $trbn_project_empty_string = align 8 { l 0, l 0, l 0, b 0 }\ndata $trbn_project_trb_suffix = { b \".trb\", b 0 }\ndata $trbn_project_test_suffix = { b \"_test.trb\", b 0 }\ndata $trbn_project_git_component = { b \"/.git\", b 0 }\ndata $trbn_project_trb_component = { b \"/.trb\", b 0 }\ndata $trbn_project_node_modules_component = { b \"/node_modules\", b 0 }",
		"data $trbn_target_error = { b \"compiler: unsupported target profile\", b 10 }\ndata $trbn_intermediate_error = { b \"compiler: cannot create intermediate file\", b 10 }\ndata $trbn_qbe_error = { b \"compiler: qbe failed\", b 10 }\ndata $trbn_cc_error = { b \"compiler: cc failed\", b 10 }\ndata $trbn_publish_error = { b \"compiler: cannot publish output\", b 10 }\n\nfunction $trbn_fatal(l %message, l %size) {\n@start\n\tcall $write(w 2, l %message, l %size)\n\tcall $exit(w 2)\n\thlt\n}\n\nfunction l $trbn_alloc(l %size) {\n@start\n\t%pointer =l call $calloc(l 1, l %size)\n\t%failed =w ceql %pointer, 0\n\tjnz %failed, @fail, @ok\n@fail\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@ok\n\tret %pointer\n}\n\nfunction l $trbn_string_alloc(l %size) {\n@start\n\t%result =l call $trbn_gc_alloc(l $trbn_desc_string, l %size, l 0)\n\tret %result\n}\n\nfunction l $trbn_temp_alloc(l %size) {\n@start\n\t%storage =l loadl $trbn_temporary_storage\n\t%missing =w ceql %storage, 0\n\tjnz %missing, @initialize, @allocate\n@initialize\n\t%allocated =l call $calloc(l 1, l 1048576)\n\t%failed =w ceql %allocated, 0\n\tjnz %failed, @allocation_failed, @initialized\n@allocation_failed\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@initialized\n\tstorel %allocated, $trbn_temporary_storage\n\tjmp @allocate\n@allocate\n\t%base =l loadl $trbn_temporary_storage\n\t%used_address =l add $trbn_temporary_storage, 8\n\t%used =l loadl %used_address\n\t%with_padding =l add %size, 7\n\t%aligned =l and %with_padding, -8\n\t%next =l add %used, %aligned\n\t%overflow =w csltl 1048576, %next\n\tjnz %overflow, @capacity_failed, @ready\n@capacity_failed\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@ready\n\t%result =l add %base, %used\n\tstorel %next, %used_address\n\tret %result\n}\n\nfunction $trbn_temp_reset() {\n@start\n\t%used_address =l add $trbn_temporary_storage, 8\n\tstorel 0, %used_address\n\tret\n}\n\nfunction l $trbn_string_from_bytes(l %source, l %length) {\n@start\n\t%size =l add %length, 17\n\t%string =l call $trbn_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 24\n\tcall $memcpy(l %data, l %source, l %length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\t%points =l call $trbn_utf8_count(l %data, l %length)\n\t%points_address =l add %string, 16\n\tstorel %points, %points_address\n\tret %string\n}\n\nfunction l $trbn_string_from_c(l %source) {\n@start\n %length =l call $strlen(l %source)\n %result =l call $trbn_string_from_bytes(l %source, l %length)\n ret %result\n}\n\nfunction l $trbn_read_file(l %p) {\n@start\n\t%f =l call $fopen(l %p, l $trbn_rb)\n\t%fm =w ceql %f, 0\n\tjnz %fm, @fail, @seek\n@seek\n\t%es =w call $fseek(l %f, l 0, w 2)\n\t%ef =w cnew %es, 0\n\tjnz %ef, @close, @len\n@len\n\t%n =l call $ftell(l %f)\n\t%neg =w csltl %n, 0\n\tjnz %neg, @close, @rewind\n@rewind\n\t%rs =w call $fseek(l %f, l 0, w 0)\n\t%rf =w cnew %rs, 0\n\tjnz %rf, @close, @alloc\n@alloc\n\t%sz =l add %n, 17\n\t%s =l call $trbn_string_alloc(l %sz)\n\t%length_address =l add %s, 8\n\tstorel %n, %length_address\n\t%d =l add %s, 24\n\t%got =l call $fread(l %d, l 1, l %n, l %f)\n\t%cs =w call $fclose(l %f)\n\t%rfe =w cnel %got, %n\n\t%cfe =w cnew %cs, 0\n\t%bad =w or %rfe, %cfe\n\tjnz %bad, @fail, @done\n@done\n\t%e =l add %d, %n\n\tstoreb 0, %e\n\t%points =l call $trbn_utf8_count(l %d, l %n)\n\t%points_address =l add %s, 16\n\tstorel %points, %points_address\n\t%file_root =l add $trbn_gc_global_roots, 8\n\tstorel %s, %file_root\n\tret %s\n@close\n\t%ignored =w call $fclose(l %f)\n\tjmp @fail\n@fail\n\tret 0\n}\n",
		"function l $trbn_file_exists(l %path) {\n@start\n\t%data =l add %path, 24\n\t%status =w call $access(l %data, w 0)\n\t%ok =w ceqw %status, 0\n\t%result =l extuw %ok\n\tret %result\n}\n",
		"function l $trbn_read_source(l %path) {\n@start\n\t%data =l add %path, 24\n\t%source =l call $trbn_read_file(l %data)\n\tret %source\n}\n",
		"function l $trbn_source_slice(l %source, l %start, l %finish) {\n@start\n %from_offset =l call $trbn_string_offset(l %source, l %start)\n %to_offset =l call $trbn_string_offset(l %source, l %finish)\n %length =l sub %to_offset, %from_offset\n %points =l sub %finish, %start\n %size =l add %length, 17\n %result =l call $trbn_string_alloc(l %size)\n %length_address =l add %result, 8\n storel %length, %length_address\n %points_address =l add %result, 16\n storel %points, %points_address\n %source_data =l add %source, 24\n %from =l add %source_data, %from_offset\n %data =l add %result, 24\n call $memcpy(l %data, l %from, l %length)\n %end =l add %data, %length\n storeb 0, %end\n ret %result\n}\n\nfunction w $trbn_c_ends_with(l %value, l %suffix) {\n@start\n\t%value_length =l call $strlen(l %value)\n\t%suffix_length =l call $strlen(l %suffix)\n\t%short =w csltl %value_length, %suffix_length\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %value_length, %suffix_length\n\t%start =l add %value, %offset\n\t%comparison =w call $memcmp(l %start, l %suffix, l %suffix_length)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $trbn_c_is_test_source(l %path) {\n@start\n\t%length =l call $strlen(l %path)\n\t%short =w csltl %length, 9\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %length, 9\n\t%start =l add %path, %offset\n\t%comparison =w call $strncasecmp(l %start, l $trbn_project_test_suffix, l 9)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $trbn_c_has_directory_component(l %path, l %component) {\n@start\n\t%component_length =l call $strlen(l %component)\n\tjmp @search\n@search\n\t%cursor =l phi @start %path, @advance %advanced\n\t%match =l call $strstr(l %cursor, l %component)\n\t%missing =w ceql %match, 0\n\tjnz %missing, @no, @boundary\n@boundary\n\t%after =l add %match, %component_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tjnz %matched, @yes, @advance\n@advance\n\t%advanced =l add %match, 1\n\tjmp @search\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $trbn_c_path_has_prefix(l %path, l %prefix) {\n@start\n\t%path_length =l call $strlen(l %path)\n\t%prefix_length =l call $strlen(l %prefix)\n\t%short =w csltl %path_length, %prefix_length\n\tjnz %short, @no, @compare\n@compare\n\t%comparison =w call $memcmp(l %path, l %prefix, l %prefix_length)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @no, @boundary\n@boundary\n\t%after =l add %path, %prefix_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tret %matched\n@no\n\tret 0\n}\n\nfunction w $trbn_project_path_excluded(l %path) {\n@start\n\t%source_root =l loadl $trbn_project_source_root\n\t%source_comparison =w call $strcmp(l %path, l %source_root)\n\t%source =w ceqw %source_comparison, 0\n\tjnz %source, @no, @out_root\n@out_root\n\t%out_root =l loadl $trbn_project_out_root\n\t%roots_comparison =w call $strcmp(l %source_root, l %out_root)\n\t%same_roots =w ceqw %roots_comparison, 0\n\tjnz %same_roots, @components, @out_prefix\n@out_prefix\n\t%inside_out =w call $trbn_c_path_has_prefix(l %path, l %out_root)\n\tjnz %inside_out, @yes, @components\n@components\n\t%source_length =l call $strlen(l %source_root)\n\t%empty_root =w ceql %source_length, 0\n\tjnz %empty_root, @component_start, @component_offset\n@component_offset\n\t%last_index =l sub %source_length, 1\n\t%last_pointer =l add %source_root, %last_index\n\t%last_byte =w loadub %last_pointer\n\t%root_slash =w ceqw %last_byte, 47\n\t%slash_offset =l extuw %root_slash\n\t%offset =l sub %source_length, %slash_offset\n\tjmp @component_start\n@component_start\n\t%relative_offset =l phi @components 0, @component_offset %offset\n\t%relative =l add %path, %relative_offset\n\t%git =w call $trbn_c_has_directory_component(l %relative, l $trbn_project_git_component)\n\tjnz %git, @yes, @trb\n@trb\n\t%hidden =w call $trbn_c_has_directory_component(l %relative, l $trbn_project_trb_component)\n\tjnz %hidden, @yes, @node_modules\n@node_modules\n\t%node =w call $trbn_c_has_directory_component(l %relative, l $trbn_project_node_modules_component)\n\tjnz %node, @yes, @no\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $trbn_project_path_compare(l %left_cell, l %right_cell) {\n@start\n\t%left =l loadl %left_cell\n\t%right =l loadl %right_cell\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%left_shorter =w csltl %left_length, %right_length\n\tjnz %left_shorter, @left_minimum, @right_minimum\n@left_minimum\n\t%left_min =l copy %left_length\n\tjmp @compare\n@right_minimum\n\t%right_min =l copy %right_length\n\tjmp @compare\n@compare\n\t%minimum =l phi @left_minimum %left_min, @right_minimum %right_min\n\t%left_data =l add %left, 24\n\t%right_data =l add %right, 24\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %minimum)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @compared, @lengths\n@compared\n\tret %comparison\n@lengths\n\t%shorter =w csltl %left_length, %right_length\n\tjnz %shorter, @less, @longer\n@longer\n\t%greater =w csgtl %left_length, %right_length\n\tjnz %greater, @more, @equal\n@less\n\tret -1\n@more\n\tret 1\n@equal\n\tret 0\n}\n\nfunction w $trbn_project_walk_callback(l %path, l %stat, w %type, l %walk) {\n@start\n\t%excluded =w call $trbn_project_path_excluded(l %path)\n\tjnz %excluded, @ignore, @classify\n@classify\n\t%regular =w ceqw %type, 0\n\tjnz %regular, @regular, @directory\n@directory\n\t%directory =w ceqw %type, 1\n\tjnz %directory, @ignore, @walk_error\n@walk_error\n\t%denied =w ceqw %type, 2\n\t%unknown =w ceqw %type, 4\n\t%unreadable =w or %denied, %unknown\n\tjnz %unreadable, @error, @special\n@special\n\t%source_kind =w call $trbn_c_ends_with(l %path, l $trbn_project_trb_suffix)\n\tjnz %source_kind, @error, @ignore\n@regular\n\t%source =w call $trbn_c_ends_with(l %path, l $trbn_project_trb_suffix)\n\tjnz %source, @test, @ignore\n@test\n\t%test_source =w call $trbn_c_is_test_source(l %path)\n\tjnz %test_source, @ignore, @collect\n@collect\n\t%owned =l call $trbn_string_from_c(l %path)\n\t%paths =l loadl $trbn_project_paths\n\tcall $trbn_array_push(l %paths, l %owned)\n\tret 0\n@error\n\t%error =l call $trbn_string_from_c(l %path)\n\tstorel %error, $trbn_project_error\n\t%error_root =l add $trbn_gc_global_roots, 88\n\tstorel %error, %error_root\n\tret 1\n@ignore\n\tret 0\n}\n\nfunction l $trbn_collect_project_sources(l %source_root, l %out_root) {\n@start\n\t%paths =l call $trbn_array_new(l $trbn_desc_array_managed)\n\t%paths_root =l add $trbn_gc_global_roots, 64\n\tstorel %paths, %paths_root\n\t%sources =l call $trbn_array_new(l $trbn_desc_array_managed)\n\t%sources_root =l add $trbn_gc_global_roots, 72\n\tstorel %sources, %sources_root\n\t%result =l call $trbn_gc_alloc(l $trbn_desc_project_sources, l 24, l 0)\n\t%result_root =l add $trbn_gc_global_roots, 80\n\tstorel %result, %result_root\n\t%paths_slot =l add %result, 8\n\tstorel %paths, %paths_slot\n\t%sources_slot =l add %result, 16\n\tstorel %sources, %sources_slot\n\t%error_slot =l add %result, 24\n\tstorel $trbn_project_empty_string, %error_slot\n\tstorel %paths, $trbn_project_paths\n\tstorel 0, $trbn_project_error\n\t%error_root =l add $trbn_gc_global_roots, 88\n\tstorel 0, %error_root\n\t%source_data =l add %source_root, 24\n\t%out_data =l add %out_root, 24\n\tstorel %source_data, $trbn_project_source_root\n\tstorel %out_data, $trbn_project_out_root\n\t%walk_status =w call $nftw(l %source_data, l $trbn_project_walk_callback, w 32, w 1)\n\t%walk_error =l loadl $trbn_project_error\n\t%callback_failed =w cnel %walk_error, 0\n\tjnz %callback_failed, @failed, @walk_result\n@walk_result\n\t%walk_failed =w cnew %walk_status, 0\n\tjnz %walk_failed, @root_failed, @sort\n@root_failed\n\tstorel %source_root, %error_slot\n\tret %result\n@failed\n\tstorel %walk_error, %error_slot\n\tret %result\n@sort\n\t%path_count_address =l add %paths, 8\n\t%path_count =l loadl %path_count_address\n\t%multiple =w csltl 1, %path_count\n\tjnz %multiple, @sort_paths, @read_start\n@sort_paths\n\t%paths_data_slot =l add %paths, 24\n\t%paths_data =l loadl %paths_data_slot\n\tcall $qsort(l %paths_data, l %path_count, l 8, l $trbn_project_path_compare)\n\tjmp @read_start\n@read_start\n\t%read_data_slot =l add %paths, 24\n\t%read_data =l loadl %read_data_slot\n\tjmp @read_loop\n@read_loop\n\t%index =l phi @read_start 0, @read_next %next_index\n\t%finished =w cslel %path_count, %index\n\tjnz %finished, @success, @read\n@read\n\t%offset =l mul %index, 8\n\t%path_slot =l add %read_data, %offset\n\t%path =l loadl %path_slot\n\t%path_data =l add %path, 24\n\t%source =l call $trbn_read_file(l %path_data)\n\t%read_failed =w ceql %source, 0\n\tjnz %read_failed, @source_failed, @source_ready\n@source_failed\n\tstorel %path, %error_slot\n\tret %result\n@source_ready\n\tcall $trbn_array_push(l %sources, l %source)\n\tjmp @read_next\n@read_next\n\t%next_index =l add %index, 1\n\tjmp @read_loop\n@success\n\tret %result\n}\n\nfunction l $trbn_c_concat(l %a, l %b) {\n@start\n\t%an =l call $strlen(l %a)\n\t%bn =l call $strlen(l %b)\n\t%n =l add %an, %bn\n\t%sz =l add %n, 1\n\t%r =l call $trbn_alloc(l %sz)\n\tcall $memcpy(l %r, l %a, l %an)\n\t%p =l add %r, %an\n\tcall $memcpy(l %p, l %b, l %bn)\n\tret %r\n}\n\nfunction l $trbn_c_basename(l %path) {\n@start\n\t%slash =l call $strrchr(l %path, w 47)\n\t%missing =w ceql %slash, 0\n\tjnz %missing, @whole, @suffix\n@whole\n\tret %path\n@suffix\n\t%base =l add %slash, 1\n\tret %base\n}\n",
		"function w $trbn_run(l %program, l %args) {\n@start\n\t%pid =w call $fork()\n\t%ff =w csltw %pid, 0\n\tjnz %ff, @fail, @child_check\n@child_check\n\t%child =w ceqw %pid, 0\n\tjnz %child, @child, @parent\n@child\n\t%ignored =w call $execv(l %program, l %args)\n\tcall $exit(w 127)\n\thlt\n@parent\n\t%sp =l alloc8 8\n\tstorew 0, %sp\n\t%waited =w call $waitpid(w %pid, l %sp, w 0)\n\t%wf =w csltw %waited, 0\n\tjnz %wf, @fail, @status\n@status\n\t%st =w loadw %sp\n\t%sig =w and %st, 127\n\t%signaled =w cnew %sig, 0\n\tjnz %signaled, @signal, @exited\n@signal\n\t%sr =w add %sig, 128\n\tret %sr\n@exited\n\t%shifted =w shr %st, 8\n\t%code =w and %shifted, 255\n\tret %code\n@fail\n\tret 127\n}\n",
		"function w $trbn_run_qbe(l %qbe, l %ssa, l %assembly) {\n@start\n\t%target =l loadl $trbn_selected_qbe_target\n\t%a =l alloc8 56\n\tstorel %qbe, %a\n\t%a1 =l add %a, 8\n\tstorel $trbn_target_flag, %a1\n\t%a2 =l add %a, 16\n\tstorel %target, %a2\n\t%a3 =l add %a, 24\n\tstorel $trbn_o_flag, %a3\n\t%a4 =l add %a, 32\n\tstorel %assembly, %a4\n\t%a5 =l add %a, 40\n\tstorel %ssa, %a5\n\t%a6 =l add %a, 48\n\tstorel 0, %a6\n\t%r =w call $trbn_run(l %qbe, l %a)\n\tret %r\n}\n",
		"function w $trbn_project_run_cc(l %cc, l %assembly, l %output, l %qbe) {\n@start\n\t%dead_strip =l loadl $trbn_selected_dead_strip\n\t%linker =l loadl $trbn_project_selected_linker\n\t%a =l alloc8 384\n\tstorel %cc, %a\n\t%a1 =l add %a, 8\n\tstorel $trbn_project_assembler_input, %a1\n\t%a2 =l add %a, 16\n\tstorel %assembly, %a2\n\t%has_linker =w cnel %linker, 0\n\tjnz %has_linker, @linker, @default\n@linker\n\t%linker_slot =l add %a, 24\n\tstorel %linker, %linker_slot\n\t%linker_tail =l add %a, 32\n\tjmp @tail\n@default\n\t%default_tail =l add %a, 24\n\tjmp @tail\n@tail\n\t%tail =l phi @linker %linker_tail, @default %default_tail\n\tstorel %dead_strip, %tail\n\t%math_slot =l add %tail, 8\n\tstorel $trbn_math_library, %math_slot\n\t%extra =l add %tail, 16\n\t%network_tail =l call $trbn_network_link_arguments(l %extra, l %qbe)\n\t%network_tail_nonzero =w cnel %network_tail, 0\n\tjnz %network_tail_nonzero, @compression, @missing\n@missing\n\tret 78\n@compression\n\t%crypto_tail =l call $trbn_compression_link_arguments(l %network_tail, l %qbe)\n\t%crypto_tail_nonzero =w cnel %crypto_tail, 0\n\tjnz %crypto_tail_nonzero, @oidc, @missing_compression\n@missing_compression\n\tcall $trbn_network_link_cleanup(l %extra)\n\tret 78\n@oidc\n\t%oidc_tail =l call $trbn_oidc_link_arguments(l %crypto_tail, l %qbe)\n\t%oidc_tail_nonzero =w cnel %oidc_tail, 0\n\tjnz %oidc_tail_nonzero, @crypto, @missing_oidc\n@missing_oidc\n\tcall $trbn_compression_link_cleanup(l %network_tail)\n\tcall $trbn_network_link_cleanup(l %extra)\n\tret 78\n@crypto\n\t%sqlite_tail =l call $trbn_crypto_link_arguments(l %oidc_tail, l %qbe)\n\t%sqlite_tail_nonzero =w cnel %sqlite_tail, 0\n\tjnz %sqlite_tail_nonzero, @sqlite, @missing_crypto\n@missing_crypto\n\tcall $trbn_oidc_link_cleanup(l %crypto_tail)\n\tcall $trbn_compression_link_cleanup(l %network_tail)\n\tcall $trbn_network_link_cleanup(l %extra)\n\tret 78\n@sqlite\n\t%output_flag_slot =l call $trbn_sqlite_link_arguments(l %sqlite_tail, l %qbe)\n\t%output_flag_slot_nonzero =w cnel %output_flag_slot, 0\n\tjnz %output_flag_slot_nonzero, @invoke, @missing_sqlite\n@missing_sqlite\n\tcall $trbn_crypto_link_cleanup(l %oidc_tail)\n\tcall $trbn_oidc_link_cleanup(l %crypto_tail)\n\tcall $trbn_compression_link_cleanup(l %network_tail)\n\tcall $trbn_network_link_cleanup(l %extra)\n\tret 78\n@invoke\n\tstorel $trbn_o_flag, %output_flag_slot\n\t%output_slot =l add %output_flag_slot, 8\n\tstorel %output, %output_slot\n\t%end_slot =l add %output_slot, 8\n\tstorel 0, %end_slot\n\t%r =w call $trbn_run(l %cc, l %a)\n\tcall $trbn_sqlite_link_cleanup(l %sqlite_tail)\n\tcall $trbn_crypto_link_cleanup(l %oidc_tail)\n\tcall $trbn_oidc_link_cleanup(l %crypto_tail)\n\tcall $trbn_compression_link_cleanup(l %network_tail)\n\tcall $trbn_network_link_cleanup(l %extra)\n\tret %r\n}\n",
		"function $trbn_cleanup(l %ssa, l %assembly) {\n@start\n\t%i0 =w call $unlink(l %ssa)\n\t%i1 =w call $unlink(l %assembly)\n\tret\n}\n\nfunction $trbn_cleanup_output(l %output, l %directory) {\n@start\n\t%i0 =w call $unlink(l %output)\n\t%i1 =w call $rmdir(l %directory)\n\tret\n}\n\n\n\nfunction l $trbn_string_equal(l %left, l %right) {\n@start\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%same_length =w ceql %left_length, %right_length\n\tjnz %same_length, @compare, @different\n@compare\n\t%left_data =l add %left, 24\n\t%right_data =l add %right, 24\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %left_length)\n\t%equal =w ceqw %comparison, 0\n\t%result =l extuw %equal\n\tret %result\n@different\n\tret 0\n}\n\nfunction l $trbn_string_index(l %string, l %requested) {\n@start\n %points_address =l add %string, 16\n %points =l loadl %points_address\n %negative =w csltl %requested, 0\n jnz %negative, @negative, @check\n@negative\n %adjusted =l add %points, %requested\n jmp @bounds\n@check\n jmp @bounds\n@bounds\n %index =l phi @negative %adjusted, @check %requested\n %below =w csltl %index, 0\n %above =w cslel %points, %index\n %invalid =w or %below, %above\n jnz %invalid, @fail, @load\n@fail\n call $trbn_string_bounds_fail()\n hlt\n@load\n %offset =l call $trbn_string_offset(l %string, l %index)\n %data =l add %string, 24\n %address =l add %data, %offset\n %character =w loadub %address\n %ascii =w cultw %character, 128\n jnz %ascii, @cached, @unicode\n@cached\n %byte_index =l extuw %character\n %slot_offset =l mul %byte_index, 32\n %cached_result =l add $string_byte_values, %slot_offset\n %cached_length =l add %cached_result, 8\n storel 1, %cached_length\n %cached_points =l add %cached_result, 16\n storel 1, %cached_points\n %cached_data =l add %cached_result, 24\n storeb %character, %cached_data\n ret %cached_result\n@unicode\n %length_address =l add %string, 8\n %length =l loadl %length_address\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %valid =w csgtl %width, 1\n jnz %valid, @copy, @replacement\n@replacement\n %replacement =l call $trbn_string_from_codepoint(l 65533)\n ret %replacement\n@copy\n %size =l add %width, 17\n %result =l call $trbn_string_alloc(l %size)\n %result_length =l add %result, 8\n storel %width, %result_length\n %result_points =l add %result, 16\n storel 1, %result_points\n %result_data =l add %result, 24\n call $memcpy(l %result_data, l %address, l %width)\n %end =l add %result_data, %width\n storeb 0, %end\n ret %result\n}\n\nfunction $trbn_puts(l %string) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%data =l add %string, 24\n\t%vectors =l alloc8 32\n\t%vector_length =l add %vectors, 8\n\t%newline_vector =l add %vectors, 16\n\t%newline_length =l add %vectors, 24\n\tstorel %data, %vectors\n\tstorel %length, %vector_length\n\tstorel $trbn_newline, %newline_vector\n\tstorel 1, %newline_length\n\tjmp @write\n@write\n\t%active =l phi @start %vectors, @partial %active, @newline %newline_vector\n\t%count =w phi @start 2, @partial %count, @newline 1\n\t%written =l call $writev(w 1, l %active, w %count)\n\t%stopped =w cslel %written, 0\n\tjnz %stopped, @finish, @progress\n@progress\n\t%active_length_address =l add %active, 8\n\t%active_length =l loadl %active_length_address\n\t%completed =w csgel %written, %active_length\n\tjnz %completed, @completed, @partial\n@partial\n\t%active_data =l loadl %active\n\t%next_data =l add %active_data, %written\n\t%remaining =l sub %active_length, %written\n\tstorel %next_data, %active\n\tstorel %remaining, %active_length_address\n\tjmp @write\n@completed\n\t%last =w ceqw %count, 1\n\t%with_newline =w csgtl %written, %active_length\n\t%finished =w or %last, %with_newline\n\tjnz %finished, @finish, @newline\n@newline\n\tjmp @write\n@finish\n\tret\n}\n\nfunction $trbn_eputs(l %string) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%data =l add %string, 24\n\tcall $write(w 2, l %data, l %length)\n\tcall $write(w 2, l $trbn_newline, l 1)\n\tret\n}\n\n" + array_construction_qbe(false) + "\nfunction $trbn_array_push(l %array, l %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\t%new_capacity =l mul %capacity, 2\n\t%new_bytes =l mul %new_capacity, 8\n\t%old_bytes =l mul %capacity, 8\n\t%growth =l sub %new_bytes, %old_bytes\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $trbn_fatal(l $trbn_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $trbn_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $trbn_gc_heap_bytes\n\t%allocated_before =l loadl $trbn_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $trbn_gc_allocated_bytes\n\tcall $trbn_gc_update_peak(l %heap_after)\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\tjmp @store\n@store\n\t%current_data_slot =l add %array, 24\n\t%current_data =l loadl %current_data_slot\n\t%offset =l mul %length, 8\n\t%target =l add %current_data, %offset\n\tstorel %value, %target\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\tret\n}\n\nfunction l $trbn_integer_add(l %left, l %right) {\n@start\n\t%result =l add %left, %right\n\t%too_high =w csgtl %result, 9007199254740991\n\tjnz %too_high, @fail, @check_low\n@check_low\n\t%too_low =w csltl %result, -9007199254740991\n\tjnz %too_low, @fail, @ok\n@fail\n\tcall $trbn_fail(l $trbn_integer_range_error, l 45)\n\thlt\n@ok\n\tret %result\n}\n\nfunction l $trbn_integer_subtract(l %left, l %right) {\n@start\n\t%result =l sub %left, %right\n\t%too_high =w csgtl %result, 9007199254740991\n\tjnz %too_high, @fail, @check_low\n@check_low\n\t%too_low =w csltl %result, -9007199254740991\n\tjnz %too_low, @fail, @ok\n@fail\n\tcall $trbn_fail(l $trbn_integer_range_error, l 45)\n\thlt\n@ok\n\tret %result\n}\n\nfunction l $trbn_integer_mul(l %left, l %right) {\n@start\n\t%c =l or %left, %right\n\t%u =l shr %c, 26\n\t%u_nonzero =w cnel %u, 0\n\tjnz %u_nonzero, @left_sign, @multiply\n@left_sign\n\t%right_zero =w ceql %right, 0\n\tjnz %right_zero, @zero, @left_nonzero\n@left_nonzero\n\t%left_positive =w csgtl %left, 0\n\tjnz %left_positive, @left_positive, @left_negative\n@left_positive\n\t%right_positive =w csgtl %right, 0\n\tjnz %right_positive, @positive_positive, @positive_negative\n@positive_positive\n\t%positive_limit =l div 9007199254740991, %right\n\t%positive_overflow =w csgtl %left, %positive_limit\n\tjnz %positive_overflow, @fail, @multiply\n@positive_negative\n\t%negative_limit =l div -9007199254740991, %left\n\t%negative_overflow =w csltl %right, %negative_limit\n\tjnz %negative_overflow, @fail, @multiply\n@left_negative\n\t%right_positive_two =w csgtl %right, 0\n\tjnz %right_positive_two, @negative_positive, @negative_negative\n@negative_positive\n\t%negative_limit_two =l div -9007199254740991, %right\n\t%negative_overflow_two =w csltl %left, %negative_limit_two\n\tjnz %negative_overflow_two, @fail, @multiply\n@negative_negative\n\t%positive_limit_two =l div 9007199254740991, %right\n\t%positive_overflow_two =w csltl %left, %positive_limit_two\n\tjnz %positive_overflow_two, @fail, @multiply\n@multiply\n\t%result =l mul %left, %right\n\tret %result\n@zero\n\tret 0\n@fail\n\tcall $trbn_fail(l $trbn_integer_range_error, l 45)\n\thlt\n}\n\nfunction l $trbn_integer_divide(l %left, l %right) {\n@start\n\t%zero =w ceql %right, 0\n\tjnz %zero, @fail, @ok\n@fail\n\tcall $trbn_fail(l $trbn_division_error, l 24)\n\thlt\n@ok\n\t%result =l div %left, %right\n\tret %result\n}\n\nfunction l $trbn_integer_remainder(l %left, l %right) {\n@start\n\t%zero =w ceql %right, 0\n\tjnz %zero, @fail, @ok\n@fail\n\tcall $trbn_fail(l $trbn_division_error, l 24)\n\thlt\n@ok\n\t%result =l rem %left, %right\n\tret %result\n}\n",
		array_construction_qbe(true),
