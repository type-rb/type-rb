import { QbeOutput, qbe_output_line } from backend/qbe/output
import { process_kind } from mir/model/process_contract
import { mir_signature_standard } from mir/model/call_kinds
import { mir_deadlines_enabled } from mir/model/deadlines
import { MirModule } from mir/model/module

def emit_process_host_runtime(native_module: MirModule, mut output: QbeOutput)
	mut cli := false
	if native_module.program.size() == 1 && native_module.program[0].cli_function >= 0
		cli = true
	end
	mut requested := cli
	mut capture := cli
	native_module.signatures.each do |signature|
		if signature.kind == mir_signature_standard()
			operation := process_kind(signature.adapter)
			if operation > 0
				requested = true
			end
			if operation == 3
				capture = true
			end
		end
	end
	if !requested
		return
	end
	emit_process_values_runtime(output)
	if capture
		emit_process_spawn_runtime(output)
		emit_process_collect_runtime(output)
		emit_process_capture_runtime(output)
		emit_process_poll_budget_runtime(output, mir_deadlines_enabled(native_module))
	end
	if cli
		qbe_output_line(output, "function l $native_cli_process_environment(l %name, l %output) {\n@start\n %value =l call $trbn_process_lookup_environment(l %name, l %output)\n ret %value\n}\nfunction l $native_cli_process_cwd(l %path) {\n@start\n %status =l call $trbn_process_cwd(l %path)\n ret %status\n}\nfunction l $native_cli_process_capture(l %command, l %args, l %streams, l %status) {\n@start\n %result =l call $trbn_process_capture_owned(l %command, l %args, l %streams, l %status, l $trbn_interrupted)\n ret %result\n}\nfunction l $native_cli_process_error_message(l %status) {\n@start\n %value =l call $trbn_process_error_message(l %status)\n ret %value\n}\n")
	end
end

def emit_process_poll_budget_runtime(mut output: QbeOutput, deadlines: Boolean)
	qbe_output_line(output, "# Polling checks the interpreter flag as well as the enclosing compiled\n# deadline. A pending interrupt never unwinds through a libc operation.\nfunction l $trbn_process_poll_budget(l %interrupt) {\n@start\n %interactive =w cnel %interrupt, 0\n jnz %interactive, @interrupted, @deadline\n@interrupted\n %pending =l loadl %interrupt\n %requested =w cnel %pending, 0\n jnz %requested, @expired, @deadline\n@deadline\n")
	if deadlines
		qbe_output_line(output, " %remaining =l call $trbn_deadline_remaining_millis()")
	else
		qbe_output_line(output, " %remaining =l copy -1")
	end
	qbe_output_line(output, " %elapsed =w ceql %remaining, 0\n jnz %elapsed, @expired, @check_slice\n@check_slice\n jnz %interactive, @interactive_slice, @max_poll\n@interactive_slice\n %unbounded =w csltl %remaining, 0\n %long =w csgtl %remaining, 50\n %regular =w or %unbounded, %long\n jnz %regular, @slice, @return\n@slice\n ret 50\n@max_poll\n %large =w csgtl %remaining, 2147483647\n jnz %large, @bounded, @return\n@bounded\n ret 2147483647\n@return\n ret %remaining\n@expired\n ret 0\n}\n")
end

# Shared POSIX process boundary for compiled programs and the retained REPL.
def emit_process_values_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_process_darwin = { b \"Darwin\", b 0 }\ndata $trbn_process_darwin_errno = { b \"__error\", b 0 }\ndata $trbn_process_linux_errno = { b \"__errno_location\", b 0 }\ndata $trbn_process_errno_function = align 8 { l 0 }\ndata $trbn_process_empty = { b 0 }\ndata $trbn_process_path_name = { b \"PATH\", b 0 }\ndata $trbn_process_null = { b \"/dev/null\", b 0 }\ndata $trbn_process_interrupted = { b \"process interrupted\", b 0 }\ndata $trbn_process_environ = { b \"environ\", b 0 }\ndata $trbn_process_env_pointer = align 8 { l 0 }\n")
	qbe_output_line(output, "function w $trbn_process_initialize() {\n@start\n %known =l loadl $trbn_process_errno_function\n %initialized =w cnel %known, 0\n jnz %initialized, @done, @identify\n@identify\n %host =l alloc16 2048\n %result =w call $uname(l %host)\n jnz %result, @failed, @profile\n@profile\n %compare =w call $memcmp(l %host, l $trbn_process_darwin, l 7)\n jnz %compare, @linux, @darwin\n@linux\n %linux_fn =l call $dlsym(l 0, l $trbn_process_linux_errno)\n %linux_env =l call $dlsym(l 0, l $trbn_process_environ)\n jmp @save\n@darwin\n %darwin_fn =l call $dlsym(l -2, l $trbn_process_darwin_errno)\n %darwin_env =l call $dlsym(l -2, l $trbn_process_environ)\n jmp @save\n@save\n %fn =l phi @linux %linux_fn, @darwin %darwin_fn\n %env =l phi @linux %linux_env, @darwin %darwin_env\n %no_errno =w ceql %fn, 0\n %no_env =w ceql %env, 0\n %missing =w or %no_errno, %no_env\n jnz %missing, @failed, @ready\n@ready\n storel %fn, $trbn_process_errno_function\n storel %env, $trbn_process_env_pointer\n jmp @done\n@failed\n ret 22\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $trbn_process_errno() {\n@start\n %fn =l loadl $trbn_process_errno_function\n %address =l call %fn()\n %error =w loadw %address\n ret %error\n}\n")
	qbe_output_line(output, "function l $trbn_process_lookup_environment(l %name, l %output) {\n@start\n %countp =l add %output, 8\n %count =l loadl %countp\n %valid =w ceql %count, 1\n jnz %valid, @name, @missing\n@name\n %lengthp =l add %name, 8\n %length =l loadl %lengthp\n %text =l add %name, 24\n %nul =l call $memchr(l %text, w 0, l %length)\n %equals =l call $memchr(l %text, w 61, l %length)\n %has_nul =w cnel %nul, 0\n %has_equals =w cnel %equals, 0\n %invalid =w or %has_nul, %has_equals\n jnz %invalid, @missing, @lookup\n@lookup\n %value =l call $getenv(l %text)\n %present =w cnel %value, 0\n jnz %present, @present, @missing\n@present\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %output)\n %copy =l call $trbn_string_from_c(l %value)\n %outputp =l add %output, 24\n %storage =l loadl %outputp\n storel %copy, %storage\n storel %roots, $trbn_gc_temp_count\n ret 1\n@missing\n ret 0\n}\n")
	qbe_output_line(output, "data $trbn_process_pwd = { b \"PWD\", b 0 }\n\n# Preserve a valid absolute PWD alias, as in the reference. An unset, stale\n# or relative value cannot override the directory reported by the kernel.\nfunction l $trbn_process_display_cwd(l %physical) {\n@start\n %pwd =l call $getenv(l $trbn_process_pwd)\n %present =w cnel %pwd, 0\n jnz %present, @absolute, @physical\n@absolute\n %first =w loadub %pwd\n %is_absolute =w ceqw %first, 47\n jnz %is_absolute, @resolve, @physical\n@resolve\n %resolved =l call $realpath(l %pwd, l 0)\n %valid =w cnel %resolved, 0\n jnz %valid, @compare, @physical\n@compare\n %same =w call $strcmp(l %resolved, l %physical)\n call $free(l %resolved)\n jnz %same, @physical, @alias\n@alias\n ret %pwd\n@physical\n ret %physical\n}\n")
	qbe_output_line(output, "function l $trbn_process_cwd(l %output) {\n@start\n %countp =l add %output, 8\n %count =l loadl %countp\n %valid =w ceql %count, 1\n jnz %valid, @setup, @invalid\n@setup\n %initialized =w call $trbn_process_initialize()\n jnz %initialized, @invalid, @getcwd\n@getcwd\n %raw =l call $getcwd(l 0, l 0)\n %found =w cnel %raw, 0\n jnz %found, @pwd, @failed\n@pwd\n %preferred =l call $trbn_process_display_cwd(l %raw)\n jmp @copy\n@copy\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %output)\n %value =l call $trbn_string_from_c(l %preferred)\n call $free(l %raw)\n %slot =l add %output, 24\n %storage =l loadl %slot\n storel %value, %storage\n storel %roots, $trbn_gc_temp_count\n ret 0\n@failed\n %error =w call $trbn_process_errno()\n %status =l extsw %error\n ret %status\n@invalid\n ret 22\n}\n")
	qbe_output_line(output, "function l $trbn_process_error_message(l %status) {\n@start\n %cancelled =w ceql %status, -1\n jnz %cancelled, @interrupted, @system\n@interrupted\n %message =l call $trbn_string_from_c(l $trbn_process_interrupted)\n ret %message\n@system\n %code =w copy %status\n %raw =l call $strerror(w %code)\n %copy =l call $trbn_string_from_c(l %raw)\n ret %copy\n}\n")
end

def emit_process_collect_runtime(mut output: QbeOutput)
	qbe_output_line(output, "# Each 24-byte buffer owns its raw backing until the joined operation publishes\n# both managed Bytes values. Capacity grows geometrically on demand.\nfunction w $trbn_process_append(l %buffer, l %source, l %count) {\n@start\n %sizep =l add %buffer, 8\n %size =l loadl %sizep\n %next =l add %size, %count\n %in_range =w culel %next, 9007199254740991\n jnz %in_range, @capacity, @failed\n@capacity\n %capp =l add %buffer, 16\n %cap =l loadl %capp\n %fits =w culel %next, %cap\n jnz %fits, @copy, @grow\n@grow\n %base =l add %cap, 8192\n %bigger =l add %cap, %base\n %backing =l loadl %buffer\n %resized =l call $realloc(l %backing, l %bigger)\n %allocated =w cnel %resized, 0\n jnz %allocated, @save, @failed\n@save\n storel %resized, %buffer\n storel %bigger, %capp\n jmp @copy\n@copy\n %target =l loadl %buffer\n %at =l add %target, %size\n call $memcpy(l %at, l %source, l %count)\n storel %next, %sizep\n ret 0\n@failed\n ret 12\n}\n")
	qbe_output_line(output, "# There is exactly one reader for each blocking pipe. poll readiness allows\n# one bounded read without ever waiting on an unready sibling.\nfunction w $trbn_process_read_ready(l %pollfd, l %buffer, l %scratch) {\n@start\n %reventsp =l add %pollfd, 6\n %events =w loaduh %reventsp\n %ready =w cnew %events, 0\n jnz %ready, @read, @done\n@read\n %fd =w loadw %pollfd\n %count =l call $read(w %fd, l %scratch, l 8192)\n %got =w csgtl %count, 0\n jnz %got, @append, @end_or_error\n@append\n %appended =w call $trbn_process_append(l %buffer, l %scratch, l %count)\n ret %appended\n@end_or_error\n %closed =w ceql %count, 0\n jnz %closed, @close, @failed\n@close\n call $trbn_process_close(l %pollfd)\n jmp @done\n@failed\n %error =w call $trbn_process_errno()\n %retry =w ceqw %error, 4\n jnz %retry, @done, @return_error\n@return_error\n ret %error\n@done\n ret 0\n}\n")
	qbe_output_line(output, "# Keep the PID until waitpid consumes it. The cancellation path closes pipes\n# and reaps this PID before returning to managed code.\nfunction w $trbn_process_collect(l %state, l %interrupted) {\n@start\n %errfd =l add %state, 8\n %outbuf =l add %state, 24\n %errbuf =l add %state, 48\n %pidp =l add %state, 72\n %statusp =l add %state, 76\n %scratch =l alloc16 8192\n jmp @check\n@check\n %remaining =l call $trbn_process_poll_budget(l %interrupted)\n %expired =w ceql %remaining, 0\n jnz %expired, @cancelled, @descriptors\n@descriptors\n %out =w loadw %state\n %err =w loadw %errfd\n %out_open =w csgew %out, 0\n %err_open =w csgew %err, 0\n %open =w or %out_open, %err_open\n %budget =w copy %remaining\n jnz %open, @poll, @wait\n@poll\n %count =w call $poll(l %state, l 2, w %budget)\n %negative =w csltw %count, 0\n jnz %negative, @syscall_error, @ready\n@ready\n jnz %count, @read_out, @check\n@read_out\n %out_error =w call $trbn_process_read_ready(l %state, l %outbuf, l %scratch)\n jnz %out_error, @failed_out, @read_err\n@read_err\n %err_error =w call $trbn_process_read_ready(l %errfd, l %errbuf, l %scratch)\n jnz %err_error, @failed_err, @check\n@wait\n %pid =w loadw %pidp\n %bounded =w csgew %budget, 0\n %waited =w call $waitpid(w %pid, l %statusp, w %bounded)\n %joined =w ceqw %waited, %pid\n jnz %joined, @joined, @wait_result\n@wait_result\n %pending =w ceqw %waited, 0\n jnz %pending, @wait_pause, @wait_error\n@wait_pause\n %long =w csgtw %budget, 40\n jnz %long, @wait_slice, @wait_budget\n@wait_slice\n jmp @pause\n@wait_budget\n jmp @pause\n@pause\n %slice =w phi @wait_slice 40, @wait_budget %budget\n %ignored =w call $poll(l 0, l 0, w %slice)\n jmp @check\n@joined\n storew 0, %pidp\n ret 0\n@wait_error\n %wait_errno =w call $trbn_process_errno()\n %retry_wait =w ceqw %wait_errno, 4\n jnz %retry_wait, @check, @no_child\n@no_child\n storew 0, %pidp\n ret %wait_errno\n@syscall_error\n %poll_errno =w call $trbn_process_errno()\n %retry_poll =w ceqw %poll_errno, 4\n jnz %retry_poll, @check, @failed_poll\n@failed_poll\n ret %poll_errno\n@failed_out\n ret %out_error\n@failed_err\n ret %err_error\n@cancelled\n ret -1\n}\n")
	qbe_output_line(output, "function $trbn_process_abort_child(l %state) {\n@start\n %pidp =l add %state, 72\n %pid =w loadw %pidp\n %present =w csgtw %pid, 0\n jnz %present, @terminate, @done\n@terminate\n storew 0, %pidp\n call $kill(w %pid, w 9)\n jmp @wait\n@wait\n %waited =w call $waitpid(w %pid, l 0, w 0)\n %negative =w csltw %waited, 0\n jnz %negative, @failure, @done\n@failure\n %error =w call $trbn_process_errno()\n %again =w ceqw %error, 4\n jnz %again, @wait, @done\n@done\n ret\n}\n")
end

def emit_process_capture_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function l $trbn_process_raw_bytes(l %buffer) {\n@start\n %sizep =l add %buffer, 8\n %size =l loadl %sizep\n %empty =w ceql %size, 0\n jnz %empty, @empty, @data\n@empty\n %blank =l call $trbn_string_from_bytes(l $trbn_process_empty, l 0)\n ret %blank\n@data\n %raw =l loadl %buffer\n %value =l call $trbn_string_from_bytes(l %raw, l %size)\n ret %value\n}\n")
	qbe_output_line(output, "function $trbn_process_publish(l %state, l %streams, l %status_out) {\n@start\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %streams)\n call $trbn_gc_temp_push(l %status_out)\n %stdout =l add %state, 24\n %stderr =l add %state, 48\n %streamsp =l add %streams, 24\n %other =l call $trbn_process_raw_bytes(l %stdout)\n %storage =l loadl %streamsp\n storel %other, %storage\n %error =l call $trbn_process_raw_bytes(l %stderr)\n %second =l add %storage, 8\n storel %error, %second\n %rawp =l add %state, 76\n %raw =w loadw %rawp\n %signal =w and %raw, 127\n jnz %signal, @signalled, @exited\n@signalled\n jmp @status\n@exited\n %shift =w shr %raw, 8\n %byte =w and %shift, 255\n %code =l extuw %byte\n jmp @status\n@status\n %value =l phi @signalled -1, @exited %code\n %statusp =l add %status_out, 24\n %status =l loadl %statusp\n storel %value, %status\n storel %roots, $trbn_gc_temp_count\n ret\n}\n")
	qbe_output_line(output, "# State: two 8-byte pollfd records, two write descriptors, two host byte\n# buffers, then the owned PID and its wait status. No foreign call reenters\n# managed code; every exit releases the state owned by the invocation.\nfunction l $trbn_process_capture_owned(l %command, l %args, l %streams, l %status, l %interrupted) {\n@start\n %scountp =l add %streams, 8\n %scount =l loadl %scountp\n %strings_ok =w ceql %scount, 2\n %rcountp =l add %status, 8\n %rcount =l loadl %rcountp\n %status_ok =w ceql %rcount, 1\n %sized =w and %strings_ok, %status_ok\n jnz %sized, @command, @invalid\n@command\n %path =l call $trbn_process_c_arg(l %command)\n %not_null =w cnel %path, 0\n jnz %not_null, @nonempty, @invalid\n@nonempty\n %first =w loadub %path\n jnz %first, @initialize, @invalid\n@initialize\n %initialized =w call $trbn_process_initialize()\n jnz %initialized, @invalid, @arguments\n@arguments\n %arg_error =l alloc8 8\n %argv =l call $trbn_process_argv_buffer(l %path, l %args, l %arg_error)\n %valid_argv =w cnel %argv, 0\n jnz %valid_argv, @setup, @failed_args\n@setup\n %state =l alloc16 80\n call $memset(l %state, w 0, l 80)\n %outerr =l add %state, 8\n %outwrite =l add %state, 16\n %errwrite =l add %state, 20\n %pid =l add %state, 72\n %events_out =l add %state, 4\n %events_err =l add %state, 12\n storeh 1, %events_out\n storeh 1, %events_err\n storew -1, %state\n storew -1, %outerr\n storew -1, %outwrite\n storew -1, %errwrite\n %outpipe =w call $trbn_process_pipe(l %state, l %outwrite)\n jnz %outpipe, @cleanup, @second_pipe\n@second_pipe\n %errpipe =w call $trbn_process_pipe(l %outerr, l %errwrite)\n jnz %errpipe, @cleanup, @spawn\n@spawn\n %ofd =w loadw %outwrite\n %efd =w loadw %errwrite\n %launched =w call $trbn_process_spawn(l %pid, l %path, l %argv, w %ofd, w %efd)\n jnz %launched, @cleanup, @collect\n@collect\n call $trbn_process_close(l %outwrite)\n call $trbn_process_close(l %errwrite)\n %collected =w call $trbn_process_collect(l %state, l %interrupted)\n jnz %collected, @cleanup, @publish\n@publish\n call $trbn_process_publish(l %state, l %streams, l %status)\n jmp @cleanup\n@cleanup\n %result =w phi @setup %outpipe, @second_pipe %errpipe, @spawn %launched, @collect %collected, @publish 0\n call $trbn_process_close(l %state)\n call $trbn_process_close(l %outerr)\n call $trbn_process_close(l %outwrite)\n call $trbn_process_close(l %errwrite)\n call $trbn_process_abort_child(l %state)\n %outp =l add %state, 24\n %errp =l add %state, 48\n %out =l loadl %outp\n %err =l loadl %errp\n call $free(l %out)\n call $free(l %err)\n call $free(l %argv)\n %failure =l extsw %result\n ret %failure\n@failed_args\n %code =w loadw %arg_error\n %reason =l extsw %code\n ret %reason\n@invalid\n ret 22\n}\n")
	qbe_output_line(output, "function l $trbn_process_capture(l %command, l %args, l %streams, l %status) {\n@start\n %result =l call $trbn_process_capture_owned(l %command, l %args, l %streams, l %status, l 0)\n ret %result\n}\n")
end

def emit_process_spawn_runtime(mut output: QbeOutput)
	qbe_output_line(output, "# All descriptors are tracked from the instant pipe() succeeds. Move any of\n# 0/1/2 to a safe slot before wiring a possibly closed standard stream.\nfunction w $trbn_process_prepare_fd(l %slot) {\n@start\n %fd =w loadw %slot\n %low =w csltw %fd, 3\n jnz %low, @duplicate, @flags\n@duplicate\n %replacement =w call $fcntl(w %fd, w 0, ..., w 3)\n %ok =w csgew %replacement, 0\n jnz %ok, @replace, @failed\n@replace\n storew %replacement, %slot\n call $close(w %fd)\n jmp @flags\n@flags\n %actual =w loadw %slot\n %changed =w call $fcntl(w %actual, w 2, ..., w 1)\n jnz %changed, @failed, @done\n@failed\n %error =w call $trbn_process_errno()\n ret %error\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $trbn_process_pipe(l %read, l %write) {\n@start\n %pair =l alloc8 8\n %result =w call $pipe(l %pair)\n jnz %result, @failed, @track\n@track\n %right =l add %pair, 4\n %from =w loadw %pair\n %to =w loadw %right\n storew %from, %read\n storew %to, %write\n %a =w call $trbn_process_prepare_fd(l %read)\n jnz %a, @return_first, @second\n@return_first\n ret %a\n@second\n %b =w call $trbn_process_prepare_fd(l %write)\n ret %b\n@failed\n %error =w call $trbn_process_errno()\n ret %error\n}\n")
	qbe_output_line(output, "function $trbn_process_close(l %slot) {\n@start\n %fd =w loadw %slot\n %open =w csgew %fd, 0\n jnz %open, @close, @done\n@close\n storew -1, %slot\n call $close(w %fd)\n jmp @done\n@done\n ret\n}\n")
	qbe_output_line(output, "# Borrow the existing immutable string bytes. The caller publishes no output\n# and allocates no managed value until after the child is joined.\nfunction l $trbn_process_c_arg(l %string) {\n@start\n %lengthp =l add %string, 8\n %length =l loadl %lengthp\n %text =l add %string, 24\n %nul =l call $memchr(l %text, w 0, l %length)\n %valid =w ceql %nul, 0\n jnz %valid, @valid, @invalid\n@valid\n ret %text\n@invalid\n ret 0\n}\n")
	qbe_output_line(output, "function l $trbn_process_argv_buffer(l %command, l %args, l %error) {\n@start\n %countp =l add %args, 8\n %count =l loadl %countp\n %slots =l add %count, 2\n %bytes =l mul %slots, 8\n %storage =l call $malloc(l %bytes)\n %present =w cnel %storage, 0\n jnz %present, @setup, @nomemory\n@setup\n storel %command, %storage\n %valuesp =l add %args, 24\n %values =l loadl %valuesp\n jmp @next\n@next\n %i =l phi @setup 0, @accepted %next_i\n %offset =l mul %i, 8\n %first =l add %storage, 8\n %destination =l add %first, %offset\n %last =w ceql %i, %count\n jnz %last, @finish, @argument\n@argument\n %cell =l add %values, %offset\n %value =l loadl %cell\n %arg =l call $trbn_process_c_arg(l %value)\n %valid =w cnel %arg, 0\n jnz %valid, @accepted, @invalid\n@accepted\n storel %arg, %destination\n %next_i =l add %i, 1\n jmp @next\n@finish\n storel 0, %destination\n ret %storage\n@invalid\n call $free(l %storage)\n storew 22, %error\n ret 0\n@nomemory\n storew 12, %error\n ret 0\n}\n")
	qbe_output_line(output, "function w $trbn_process_spawn_at(l %pid, l %path, l %actions, l %argv) {\n@start\n %address =l loadl $trbn_process_env_pointer\n %environment =l loadl %address\n %status =w call $posix_spawn(l %pid, l %path, l %actions, l 0, l %argv, l %environment)\n ret %status\n}\n")
	qbe_output_line(output, "# A filename is resolved through PATH. An explicit relative path with a slash\n# is accepted. Resolve one executable and then launch it; a launch failure\n# must not silently select a later executable. Reject relative PATH hits.\nfunction w $trbn_process_spawn_path(l %pid, l %command, l %actions, l %argv) {\n@start\n %slash =l call $strchr(l %command, w 47)\n %direct =w cnel %slash, 0\n jnz %direct, @explicit, @path\n@explicit\n %direct_error =w call $trbn_process_spawn_at(l %pid, l %command, l %actions, l %argv)\n ret %direct_error\n@path\n %path =l call $getenv(l $trbn_process_path_name)\n %found =w cnel %path, 0\n jnz %found, @nonempty, @missing\n@nonempty\n %total =l call $strlen(l %path)\n %nonempty =w cnel %total, 0\n jnz %nonempty, @allocate, @missing\n@allocate\n %name =l call $strlen(l %command)\n %namez =l add %name, 1\n %combined =l add %total, %namez\n %needed =l add %combined, 2\n %buffer =l call $malloc(l %needed)\n %allocated =w cnel %buffer, 0\n jnz %allocated, @scan, @memory\n@scan\n %piece =l phi @allocate %path, @advance %following\n %separator =l call $strchr(l %piece, w 58)\n %end =l add %path, %total\n %last =w ceql %separator, 0\n jnz %last, @tail, @segment\n@tail\n jmp @prefix\n@segment\n jmp @prefix\n@prefix\n %finish =l phi @tail %end, @segment %separator\n %length =l sub %finish, %piece\n %empty =w ceql %length, 0\n jnz %empty, @dot, @copy\n@dot\n storeb 46, %buffer\n jmp @join\n@copy\n call $memcpy(l %buffer, l %piece, l %length)\n jmp @join\n@join\n %prefix_length =l phi @dot 1, @copy %length\n %first =w loadub %buffer\n %slashp =l add %buffer, %prefix_length\n storeb 47, %slashp\n %namep =l add %slashp, 1\n call $memcpy(l %namep, l %command, l %namez)\n %access =w call $access(l %buffer, w 1)\n jnz %access, @skip, @directory_check\n@directory_check\n # A trailing slash requires a directory and needs no read permission.\n %terminator =l add %namep, %name\n %directory_end =l add %terminator, 1\n storeb 47, %terminator\n storeb 0, %directory_end\n %directory =w call $access(l %buffer, w 0)\n storeb 0, %terminator\n jnz %directory, @selected, @skip\n@selected\n %absolute =w ceqw %first, 47\n jnz %absolute, @start_child, @unsafe\n@unsafe\n call $free(l %buffer)\n ret 13\n@start_child\n %status =w call $trbn_process_spawn_at(l %pid, l %buffer, l %actions, l %argv)\n call $free(l %buffer)\n ret %status\n@skip\n jnz %last, @exhausted, @advance\n@advance\n %following =l add %separator, 1\n jmp @scan\n@exhausted\n call $free(l %buffer)\n ret 2\n@missing\n ret 2\n@memory\n ret 12\n}\n")
	qbe_output_line(output, "# The initialized actions are opaque and owned locally. Both qualified LP64\n# layouts fit in this aligned slot. posix_spawn receives an explicit path.\nfunction w $trbn_process_spawn(l %pid, l %command, l %argv, w %stdout, w %stderr) {\n@start\n %actions =l alloc16 128\n %init =w call $posix_spawn_file_actions_init(l %actions)\n jnz %init, @init_failed, @input\n@input\n %open =w call $posix_spawn_file_actions_addopen(l %actions, w 0, l $trbn_process_null, w 0, w 0)\n jnz %open, @release, @output\n@output\n %out =w call $posix_spawn_file_actions_adddup2(l %actions, w %stdout, w 1)\n jnz %out, @release, @error\n@error\n %err =w call $posix_spawn_file_actions_adddup2(l %actions, w %stderr, w 2)\n jnz %err, @release, @exec\n@exec\n %spawn =w call $trbn_process_spawn_path(l %pid, l %command, l %actions, l %argv)\n jmp @release\n@release\n %result =w phi @input %open, @output %out, @error %err, @exec %spawn\n call $posix_spawn_file_actions_destroy(l %actions)\n ret %result\n@init_failed\n ret %init\n}\n")
end
