def jobs_worker_runtime(darwin: Boolean): String
	mut clock := "1"
	if darwin
		clock = "6"
	end
	mut unblock := "1"
	if darwin
		unblock = "2"
	end
	mut errno := "__errno_location"
	if darwin
		errno = "__error"
	end
	mut source := "data $trbn_jobs_int = align 4 { w 0 }\ndata $trbn_jobs_term = align 4 { w 0 }\n\nfunction $trbn_jobs_signal(w %signal) {\n@start\n    %interrupt =w ceqw %signal, 2\n    jnz %interrupt, @int, @term\n@int\n    %int_count =w loadw $trbn_jobs_int\n    %int_more =w csltw %int_count, 2\n    jnz %int_more, @int_save, @return\n@int_save\n    %int_next =w add %int_count, 1\n    storew %int_next, $trbn_jobs_int\n    jmp @return\n@term\n    %term_count =w loadw $trbn_jobs_term\n    %term_more =w csltw %term_count, 2\n    jnz %term_more, @term_save, @return\n@term_save\n    %term_next =w add %term_count, 1\n    storew %term_next, $trbn_jobs_term\n    jmp @return\n@return\n    ret\n}\n\nfunction l $trbn_sqlite_worker_log(l %message) {\n@start\n    %sizep =l add %message, 8\n    %size =l loadl %sizep\n    %bytes =l add %message, 24\n    %written =l call $write(w 2, l %bytes, l %size)\n    ret %written\n}\n\nfunction l $trbn_jobs_wait(w %child, w %flags) {\n@start\n    %status =l alloc4 4\n    jmp @wait\n@wait\n    %pid =w call $waitpid(w %child, l %status, w %flags)\n    %pending =w ceqw %pid, 0\n    jnz %pending, @running, @check\n@running\n    ret -1\n@check\n    %reaped =w ceqw %pid, %child\n    jnz %reaped, @result, @error\n@error\n    %errno_p =l call $"
	source += errno
	source += "()\n    %errno =w loadw %errno_p\n    %interrupted =w ceqw %errno, 4\n    jnz %interrupted, @wait, @lost\n@lost\n    ret -2\n@result\n    %word =w loadw %status\n    %signal =w and %word, 127\n    jnz %signal, @signaled, @exited\n@signaled\n    %code =w add %signal, 128\n    %signal_status =l extuw %code\n    ret %signal_status\n@exited\n    %exit =w shr %word, 8\n    %exit_status =l extuw %exit\n    ret %exit_status\n}\n\nfunction l $trbn_sqlite_worker_control(l %operation, l %value) {\n@start\n    %initialize =w ceql %operation, 0\n    jnz %initialize, @initialize, @is_pid\n@initialize\n    %sigint =l call $signal(w 2, l $trbn_jobs_signal)\n    %sigterm =l call $signal(w 15, l $trbn_jobs_signal)\n    %bad_int =w ceql %sigint, -1\n    %bad_term =w ceql %sigterm, -1\n    %bad =w or %bad_int, %bad_term\n    jnz %bad, @invalid, @unblock\n@unblock\n    %mask =l alloc16 128\n    call $sigemptyset(l %mask)\n    call $sigaddset(l %mask, w 2)\n    call $sigaddset(l %mask, w 15)\n    %restored =w call $sigprocmask(w "
	source += unblock
	source += ", l %mask, l 0)\n    %restored_long =l extsw %restored\n    ret %restored_long\n@is_pid\n    %pid_op =w ceql %operation, 1\n    jnz %pid_op, @pid, @is_signal\n@pid\n    %pid =w call $getpid()\n    %owner =l extsw %pid\n    ret %owner\n@is_signal\n    %signal_op =w ceql %operation, 2\n    jnz %signal_op, @signal, @is_clock\n@signal\n    %i =w loadw $trbn_jobs_int\n    %t =w loadw $trbn_jobs_term\n    %count =w add %i, %t\n    %count_long =l extuw %count\n    ret %count_long\n@is_clock\n    %clock_op =w ceql %operation, 3\n    jnz %clock_op, @clock, @is_sleep\n@clock\n    %time =l alloc8 16\n    %clock_status =w call $clock_gettime(w "
	source += clock
	source += ", l %time)\n    jnz %clock_status, @invalid, @milliseconds\n@milliseconds\n    %seconds =l loadl %time\n    %nanos_p =l add %time, 8\n    %nanos =l loadl %nanos_p\n    %seconds_ms =l mul %seconds, 1000\n    %nanos_ms =l div %nanos, 1000000\n    %elapsed =l add %seconds_ms, %nanos_ms\n    ret %elapsed\n@is_sleep\n    %sleep_op =w ceql %operation, 4\n    jnz %sleep_op, @sleep, @is_fork\n@sleep\n    call $usleep(w 20000)\n    ret 0\n@is_fork\n    %fork_op =w ceql %operation, 5\n    jnz %fork_op, @fork, @is_wait\n@fork\n    %child =w call $fork()\n    %handler =w ceqw %child, 0\n    jnz %handler, @handler, @worker\n@handler\n    %group =w call $setpgid(w 0, w 0)\n    jnz %group, @handler_failed, @handler_ready\n@handler_failed\n    call $_exit(w 125)\n    hlt\n@handler_ready\n    ret 0\n@worker\n    %spawned =w csgtw %child, 0\n    jnz %spawned, @group_child, @child_status\n@group_child\n    call $setpgid(w %child, w %child)\n    jmp @child_status\n@child_status\n    %child_long =l extsw %child\n    ret %child_long\n@is_wait\n    %wait_op =w ceql %operation, 6\n    jnz %wait_op, @poll, @is_kill\n@poll\n    %valid_poll =w csgtl %value, 0\n    jnz %valid_poll, @poll_child, @invalid\n@poll_child\n    %status =l call $trbn_jobs_wait(w %value, w 1)\n    ret %status\n@is_kill\n    %kill_op =w ceql %operation, 7\n    jnz %kill_op, @kill, @is_exit\n@kill\n    %valid_kill =w csgtl %value, 0\n    jnz %valid_kill, @kill_group, @invalid\n@kill_group\n    %group_id =w sub 0, %value\n    call $kill(w %group_id, w 9)\n    call $kill(w %value, w 9)\n    %joined =l call $trbn_jobs_wait(w %value, w 0)\n    ret %joined\n@is_exit\n    %exit_op =w ceql %operation, 8\n    jnz %exit_op, @exit, @invalid\n@exit\n    call $_exit(w %value)\n    hlt\n@invalid\n    ret -2\n}\n"
	return source
end
