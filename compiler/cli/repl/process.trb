import { native_cli_process_capture, native_cli_process_cwd, native_cli_process_environment, native_cli_process_error_message } from host
import { ReplStore, repl_boolean, repl_value, repl_integer, repl_string } from repl/model

def repl_process_call(mut store: ReplStore, operation: Integer, arguments: Array<Integer>): Integer
	if operation == 0
		return repl_value(store, "Array<String>", 0, 0.0, "", [])
	elsif operation == 1
		mut output := [""]
		present := native_cli_process_environment(store.texts[arguments[0]], output)
		if present
			store.children[arguments[1]][0] = repl_string(store, output[0])
		end
		return repl_boolean(store, present)
	elsif operation == 2
		mut path := [""]
		status := native_cli_process_cwd(path)
		if status == 0
			store.children[arguments[0]][0] = repl_string(store, path[0])
		end
		return repl_integer(store, status)
	elsif operation == 3
		mut args: Array<String> := []
		store.children[arguments[1]].each do |argument|
			args.push(store.texts[argument])
		end
		mut streams := ["", ""]
		mut status := [0]
		failure := native_cli_process_capture(store.texts[arguments[0]], args, streams, status)
		if failure == 0
			store.children[arguments[2]][0] = repl_value(store, "Bytes", 0, 0.0, streams[0], [])
			store.children[arguments[2]][1] = repl_value(store, "Bytes", 0, 0.0, streams[1], [])
			store.children[arguments[3]][0] = repl_integer(store, status[0])
		end
		return repl_integer(store, failure)
	end
	return repl_string(store, native_cli_process_error_message(store.integers[arguments[0]]))
end
