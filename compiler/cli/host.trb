trbn_empty)\n ret %blank\n}\nfunction l $native_cli_execute(l %arguments, l %internal) {\n@start\n %lenp =l add %arguments, 8\n %length =l loadl %lenp\n %datap =l add %arguments, 24\n %data =l loadl %datap\n %cells =l add %length, 1\n %size =l mul %cells, 8\n %argv =l call $malloc(l %size)\n jmp @copy\n@copy\n %index =l phi @start 0, @next %next\n %done =w ceql %index, %length\n %offset =l mul %index, 8\n %cell =l add %argv, %offset\n jnz %done, @dispatch, @item\n@item\n %source =l add %data, %offset\n %string =l loadl %source\n %cstring =l add %string, 24\n storel %cstring, %cell\n jmp @next\n@next\n %next =l add %index, 1\n jmp @copy\n@dispatch\n storel 0, %cell\n %internal_nonzero =w cnel %internal, 0\n jnz %internal_nonzero, @internal, @fork\n@internal\n %compile =w call $trbn_compiler_dispatch(w %length, l %argv)\n call $free(l %argv)\n %cr =l extsw %compile\n ret %cr\n@fork\n %pid =w call $fork()\n %failure =w csltw %pid, 0\n jnz %failure, @fail, @forked\n@forked\n jnz %pid, @parent, @child\n@child\n call $signal(w 2, l 0)\n call $signal(w 15, l 0)\n %command =l loadl %argv\n call $execv(l %command, l %argv)\n call $_exit(w 127)\n hlt\n@parent\n %pidlong =l extsw %pid\n storel %pidlong, $trbn_child\n %status =l alloc8 8\n jmp @wait\n@wait\n %waited =w call $waitpid(w %pid, l %status, w 0)\n %retry =w csltw %waited, 0\n jnz %retry, @wait, @finished\n@finished\n storel 0, $trbn_child\n %value =w loadw %status\n call $free(l %argv)\n %signal =w and %value, 127\n jnz %signal, @signaled, @normal\n@signaled\n %code =w add %signal, 128\n %sr =l extuw %code\n ret %sr\n@normal\n %exit =w shr %value, 8\n %nr =l extuw %exit\n ret %nr\n@fail\n call $free(l %argv)\n ret 127\n}\nfunction l $native_cli_eof() {\n@start\n %result =l loadl $trbn_eof\n ret %result\n}\ndata $trbn_darwin = { b \"Darwin\", b 0 }\ndata $trbn_linux = { b \"Linux\", b 0 }\ndata $trbn_amd64 = { b \"x86_64\", b 0 }\ndata $trbn_arm64 = { b \"aarch64\", b 0 }\nfunction l $native_cli_target() {\n@start\n %buffer =l alloc8 2048\n %status =w call $uname(l %buffer)\n %bad =w cnew %status, 0\n jnz %bad, @fail, @darwin\n@darwin\n %d =w call $strcmp(l %buffer, l $trbn_darwin)\n jnz %d, @linux, @apple\n@apple\n storel $trbn_qbe_darwin_arm64, $trbn_selected_qbe_target\n storel $trbn_dead_strip_darwin, $trbn_selected_dead_strip\n %dr =l call $trbn_string_from_c(l $trbn_profile_darwin_arm64)\n ret %dr\n@linux\n %l =w call $strcmp(l %buffer, l $trbn_linux)\n jnz %l, @fail, @machine\n@machine\n %machine =l add %buffer, 260\n %a =w call $strcmp(l %machine, l $trbn_amd64)\n jnz %a, @arm64, @amd64\n@amd64\n storel $trbn_qbe_linux_amd64, $trbn_selected_qbe_target\n jmp @linux_common\n@arm64\n %arm =w call $strcmp(l %machine, l $trbn_arm64)\n jnz %arm, @fail, @arm\n@arm\n storel $trbn_qbe_linux_arm64, $trbn_selected_qbe_target\n jmp @linux_common\n@linux_common\n %profile =l phi @amd64 $trbn_profile_linux_amd64, @arm $trbn_profile_linux_arm64\n storel $trbn_dead_strip_linux, $trbn_selected_dead_strip\n storel $trbn_project_linker_lld, $trbn_project_selected_linker\n %lr =l call $trbn_string_from_c(l %profile)\n ret %lr\n@fail\n %empty =l call $trbn_string_from_c(l $trbn_empty)\n ret %empty\n}\n\nfunction l $native_cli_rename(l %source, l %target) {\n@start\n %from =l add %source, 24\n %to =l add %target, 24\n %status =w call $rename(l %from, l %to)\n %result =l extsw %status\n ret %result\n}\n\nfunction l $native_cli_chmod(l %path, l %mode) {\n@start\n %name =l add %path, 24\n %status =w call $chmod(l %name, w %mode)\n %result =l extsw %status\n ret %result\n}\nfunction l $native_cli_tempfile(l %prefix) {\n@start\n %data =l add %prefix, 24\n %path =l call $trbn_c_concat(l %data, l $trbn_suffix)\n %fd =w call $mkstemp(l %path)\n %bad =w csltw %fd, 0\n jnz %bad, @fail, @ok\n@ok\n call $close(w %fd)\n %result =l call $trbn_string_from_c(l %path)\n call $free(l %path)\n ret %result\n@fail\n call $free(l %path)\n %empty =l call $trbn_string_from_c(l $trbn_empty)\n ret %empty\n}\ndata $trbn_suffix = { b \".XXXXXX\", b 0 }\nfunction l $native_cli_emit(l %source, l %destination) {\n@start\n %path =l add %destination, 24\n %file =l call $fopen(l %path, l $trbn_wb)\n %file_nonzero =w cnel %file, 0\n jnz %file_nonzero, @opened, @fail\n@opened\n %fd =w call $fileno(l %file)\n %saved =w call $dup(w 1)\n %bad =w csltw %saved, 0\n jnz %bad, @close, @redirect\n@redirect\n %redirected =w call $dup2(w %fd, w 1)\n %failed =w csltw %redirected, 0\n jnz %failed, @restore_error, @emit\n@emit\n %argv =l alloc8 32\n storel $trbn_empty, %argv\n %cmdp =l add %argv, 8\n storel $trbn_emit, %cmdp\n %sourcep =l add %argv, 16\n %text =l add %source, 24\n storel %text, %sourcep\n %endp =l add %argv, 24\n storel 0, %endp\n %status =w call $trbn_compiler_dispatch(w 3, l %argv)\n %restored =w call $dup2(w %saved, w 1)\n call $close(w %saved)\n %closed =w call $fclose(l %file)\n %rb =w csltw %restored, 0\n %cb =w cnew %closed, 0\n %iofail =w or %rb, %cb\n jnz %iofail, @fail, @done\n@done\n %result =l extsw %status\n ret %result\n@restore_error\n call $close(w %saved)\n jmp @close\n@close\n call $fclose(l %file)\n@fail\n ret 73\n}\n\n\n# POSIX terminal ABI only. Editing and rendering are implemented in TypeRB.\ndata $trbn_term_reset = { b \"\\033[0m\\033[?2004l\", b 0 }\ndata $trbn_term_saved = align 8 { z 256 }\ndata $trbn_term_active = align 8 { l 0 }\ndata $trbn_winsize_request = align 8 { l 0 }\ndata $trbn_locale = { b \"\", b 0 }\nfunction l $native_cli_terminal_start() {\n@start\n %saved =w call $tcgetattr(w 0, l $trbn_term_saved)\n jnz %saved, @fail, @raw\n@raw\n %raw =l alloc8 256\n %again =w call $tcgetattr(w 0, l %raw)\n jnz %again, @fail, @configure\n@configure\n call $cfmakeraw(l %raw)\n %status =w call $tcsetattr(w 0, w 0, l %raw)\n jnz %status, @fail, @ready\n@ready\n storel 1, $trbn_term_active\n %buffer =l alloc8 2048\n call $uname(l %buffer)\n %darwin =w call $strcmp(l %buffer, l $trbn_darwin)\n jnz %darwin, @linux, @apple\n@apple\n storel 1074295912, $trbn_winsize_request\n call $setlocale(w 2, l $trbn_locale)\n storel 4, $trbn_nonblock\n storel 35, $trbn_wouldblock\n %apple_errno =l call $dlsym(l -2, l $trbn_errno_darwin)\n storel %apple_errno, $trbn_errno_function\n %apple_errno_nonzero =w cnel %apple_errno, 0\n jnz %apple_errno_nonzero, @done, @errno_fail\n@linux\n storel 21523, $trbn_winsize_request\n call $setlocale(w 0, l $trbn_locale)\n storel 2048, $trbn_nonblock\n storel 11, $trbn_wouldblock\n %linux_errno =l call $dlsym(l 0, l $trbn_errno_linux)\n storel %linux_errno, $trbn_errno_function\n %linux_errno_nonzero =w cnel %linux_errno, 0\n jnz %linux_errno_nonzero, @done, @errno_fail\n@errno_fail\n call $native_cli_terminal_end()\n jmp @fail\n@done\n ret 0\n@fail\n ret 1\n}\nfunction l $native_cli_terminal_end() {\n@start\n %key_active =l loadl $trbn_key_flags_active\n %key_active_nonzero =w cnel %key_active, 0\n jnz %key_active_nonzero, @key_restore, @terminal\n@key_restore\n call $trbn_key_restore()\n jmp @terminal\n@terminal\n %active =l loadl $trbn_term_active\n %active_nonzero =w cnel %active, 0\n jnz %active_nonzero, @restore, @done\n@restore\n call $write(w 1, l $trbn_term_reset, l 12)\n call $tcsetattr(w 0, w 0, l $trbn_term_saved)\n storel 0, $trbn_term_active\n@done\n ret 0\n}\nfunction l $native_cli_terminal_size(l %axis) {\n@start\n %size =l alloc8 8\n storel 0, %size\n %request =l loadl $trbn_winsize_request\n %status =w call $ioctl(w 0, l %request, ..., l %size)\n %offset =l mul %axis, 2\n %cell =l add %size, %offset\n %value =w loaduh %cell\n %result =l extuw %value\n ret %result\n}\nfunction l $native_cli_key(l %timeout) {\n@start\n %pending =l loadl $trbn_interrupted\n %pending_nonzero =w cnel %pending, 0\n jnz %pending_nonzero, @interrupt, @poll\n@poll\n %fds =l alloc8 8\n storel 0, %fds\n %events =l add %fds, 4\n storeh 1, %events\n %ready =w call $poll(l %fds, l 1, w %timeout)\n %signal =l loadl $trbn_interrupted\n %signal_nonzero =w cnel %signal, 0\n jnz %signal_nonzero, @interrupt, @check\n@chec