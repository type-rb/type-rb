rom_c(l $trbn_cli_float_positive_infinity)\n ret %positive_text\n@prepare\n %buffer =l alloc8 128\n jmp @precision\n@precision\n %places =w phi @prepare 1, @more %next_places\n %written =w call $snprintf(l %buffer, l 128, l $trbn_cli_float_format, ..., w %places, d %value)\n %parsed =d call $strtod(l %buffer, l 0)\n %same =w ceqd %parsed, %value\n jnz %same, @done, @more\n@more\n %next_places =w add %places, 1\n %limit =w csgtw %next_places, 17\n jnz %limit, @done, @precision\n@done\n %result =l call $trbn_string_from_c(l %buffer)\n ret %result\n}\nfunction l $native_cli_entropy(l %length) {\n@start\n %data =l call $trbn_entropy_read(l %length)\n ret %data\n}\nfunction l $native_cli_time_clock(l %parts) {\n@start\n %ok =l call $trbn_time_clock(l %parts)\n ret %ok\n}\nfunction l $native_cli_time_zone_data(l %path, l %start, l %length, l %parts) {\n@start\n %status =l call $trbn_time_zone_data(l %path, l %start, l %length, l %parts)\n ret %status\n}\nfunction l $native_cli_time_zone_environment(l %parts) {\n@start\n %present =l call $trbn_time_zone_environment(l %parts)\n ret %present\n}\n\nfunction l $native_cli_capture(l %arguments, l %output) {\n@start\n %lenp =l add %arguments, 8\n %length =l loadl %lenp\n %datap =l add %arguments, 24\n %data =l loadl %datap\n %cells =l add %length, 1\n %size =l mul %cells, 8\n %argv =l call $malloc(l %size)\n jmp @copy\n@copy\n %index =l phi @start 0, @next %next\n %done =w ceql %index, %length\n %offset =l mul %index, 8\n %cell =l add %argv, %offset\n jnz %done, @dispatch, @item\n@item\n %source =l add %data, %offset\n %string =l loadl %source\n %cstring =l add %string, 24\n storel %cstring, %cell\n jmp @next\n@next\n %next =l add %index, 1\n jmp @copy\n@dispatch\n storel 0, %cell\n %output_data =l add %output, 24\n %fd =w call $open(l %output_data, w 1)\n %open_failed =w csltw %fd, 0\n jnz %open_failed, @fail, @fork\n@fork\n %pid =w call $fork()\n %failure =w csltw %pid, 0\n jnz %failure, @fork_fail, @forked\n@forked\n jnz %pid