127\n}\n\n\nfunction l $native_cli_tempdir(l %prefix) {\n@start\n %data =l add %prefix, 24\n %path =l call $trbn_c_concat(l %data, l $trbn_suffix)\n %created =l call $mkdtemp(l %path)\n %bad =w ceql %created, 0\n jnz %bad, @fail, @ok\n@ok\n %result =l call $trbn_string_from_c(l %path)\n call $free(l %path)\n ret %result\n@fail\n call $free(l %path)\n %empty =l call $trbn_string_from_c(l $trbn_empty)\n ret %empty\n}\nfunction w $trbn_cli_remove_callback(l %path, l %stat, w %type, l %walk) {\n@start\n %status =w call $remove(l %path)\n ret %status\n}\nfunction l $native_cli_remove_tree(l %path, l %flags) {\n@start\n %data =l add %path, 24\n %status =w call $nftw(l %data, l $trbn_cli_remove_callback, w 32, w %flags)\n %result =l extsw %status\n ret %result\n}\n\ndata $trbn_capture_group_error = { b \"create Git process group\", b 0 }\ndata $trbn_capture_exec_error = { b \"execute Git\", b 0 }\n\n# This is the CLI interpreter's synchronous host boundary, never an authored API.\nfunction l $native_cli_file_scope(l %path, l %mode, l %body, l %phase) {\n@start\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %path)\n call $trbn_gc_temp_push(l %body)\n call $trbn_gc_temp_push(l %phase)\n %scope =l alloc8 16\n %lengthp =l add %path, 8\n %length =l loadl %lengthp\n %data =l add %path, 24\n %status =l call $trbn_file_acquire(l %scope, l %data, l %length, l %mode)\n %failed =w cnel %status, 0\n jnz %failed, @open_failed, @invoke\n@open_failed\n jmp @finish\n@invoke\n %fdp =l add %scope, 8\n %fd =w loadw %fdp\n %descriptor =l extsw %fd\n %entryp =l add %body, 8\n %entry =l loadl %entryp\n %value =l call %entry(l %body, l %descriptor)\n %closed =l call $trbn_file_release(l %scope)\n jmp @finish\n@finish\n %result =l phi @open_failed 0, @invoke %value\n %operation =l phi @open_failed 0, @invoke 1\n %error =l phi @open_failed %status, @invoke %closed\n %storagep =l add %phase, 24\n %storage =l loadl %storagep\n storel %operation, %storage\n %errorp =l add %storage, 8\n storel %error, %errorp\n storel %roots, $trbn_gc_temp_count\n ret %result\n}\nfunction l $native_cli_file_read(l %descriptor, l %maximum, l %text, l %output) {\n@start\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %output)\n %file =l alloc8 24\n %fdp =l add %file, 16\n storew %descriptor, %fdp\n %out =l alloc8 8\n %status =l call $trbn_file_read_value(l %file, l %maximum, l %text, l %out)\n %failed =w cnel %status, 0\n jnz %failed, @finish, @store\n@store\n %value =l loadl %out\n %storagep =l add %output, 24\n %storage =l loadl %storagep\n storel %value, %storage\n jmp @finish\n@finish\n storel %roots, $trbn_gc_temp_count\n ret %status\n}\nfunction l $native_cli_file_write(l %descriptor, l %value) {\n@start\n %lengthp =l add %value, 8\n %length =l loadl %lengthp\n %data =l add %value, 24\n %status =l call $trbn_file_write_all(w %descriptor, l %data, l %length)\n ret %status\n}\nfunction l $native_cli_filesystem_kind(l %status) {\n@start\n %kind =l call $trbn_filesystem_error_kind(l %status)\n ret %kind\n}\nfunction l $native_cli_filesystem_message(l %status) {\n@start\n %message =l call $trbn_filesystem_error_message(l %status)\n ret %message\n}\nfunction l $native_cli_directory_children(l %path, l %prefix, l %maximum, l %names, l %kinds, l %error_path) {\n@start\n %status =l call $trbn_directory_children(l %path, l %prefix, l %maximum, l %names, l %kinds, l %error_path, w 1)\n ret %status\n}\nfunction l $native_cli_directory_stat(l %path, l %follow, l %output) {\n@start\n %status =l call $trbn_filesystem_stat_kind(l %path, l %follow, l %output)\n ret %status\n}\nfunction l $native_cli_directory_mkdir(l %path) {\n@start\n %status =l call $trbn_filesystem_mkdir(l %path)\n ret %status\n}\n\nfunction l $native_cli_link_qbe(l %source, l %destination, l %qbe, l %cc) {\n@start\n %input =l add %source, 24\n %output =l add %destination, 24\n %backend =l add %qbe, 24\n %toolchain =l add %cc, 24\n %assembly =l call $trbn_c_concat(l %output, l $trbn_as