{
  // TypeScript target owns package.json and uses npm.
  "name": "type-rb-typescript-example",
  "version": "0.1.0",
  "mode": "typescript",
  "sourceDir": "src",
  "outDir": "build",
  "entrypoint": "main",
  "copyFiles": true,
  "typescript": {
    "packageManager": "npm",
    "moduleType": "module",
    "scripts": {
      "start": "node --experimental-strip-types build/main.ts",
    },
  },
  "devDependencies": {
    "typescript": "^5.9.0",
  },
}
