import trb/std/io
import trb/std/strings
import { Result } from trb/std/result

# The same portable source runs in Ruby, Go, and TypeScript.
class Greeter
	readonly @message: String := "Hello"

	def greet(name: String): String
		return @message + ", " + name
	end
end

def identity<T>(value: T): T
	return value
end

def recipient_name(result: Result<String, String>): String
	case result
	when Result::Ok(value)
		return value
	when Result::Err(error)
		return error
	end
end

def main()
	greeter := Greeter.new()
	recipient := Result<String, String>::Ok(identity<String>("TypeRB"))
	io.puts(strings.uppercase(greeter.greet(recipient_name(recipient)))) # trb fmt keeps this comment.
	return
end
