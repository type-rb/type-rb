import trb/std/io
import trb/std/strings

# The same portable source runs in Ruby, Go, and TypeScript.
class Greeter
	readonly @message: String := "Hello"

	def greet(name: String): String
		return @message + ", " + name
	end
end

enum GreetingResult<T, E>
	Ok(value: T)
	Err(error: E)
end

def identity<T>(value: T): T
	return value
end

def recipient_name(result: GreetingResult<String, String>): String
	case result
	when GreetingResult::Ok(value)
		return value
	when GreetingResult::Err(error)
		return error
	end
end

def main()
	greeter := Greeter.new()
	recipient := GreetingResult<String, String>::Ok(identity<String>("TypeRB"))
	io.puts(strings.uppercase(greeter.greet(recipient_name(recipient)))) # trb fmt keeps this comment.
	return
end
