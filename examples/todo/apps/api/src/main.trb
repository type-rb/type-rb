import trb/std/io
import trb/platform/go/gorm
import trb/platform/go/http
import { TodoRepository } from repositories/todo_repository
import { TodoHandler } from transport/todo_handler

def main()
  db := gorm.open_sqlite("todo.db")
  repository := TodoRepository.new(db)
  repository.ensure_seed()
  handler := TodoHandler.new(repository)

  router := http.router()
  http.handle(router, "GET /api/board", handler.board)
  http.handle(router, "POST /api/lists/{list_id}/items", handler.create_item)
  http.handle(router, "PATCH /api/items/{id}", handler.update_item)

  app := http.cors(router, "http://localhost:5173")
  io.println("TypeRB Todo API: http://localhost:8080")
  http.serve(":8080", app)
  return
end
