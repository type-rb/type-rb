import trb/std/arrays
import trb/std/numbers
import trb/platform/typescript/react
import { CreateTodoRequest, Tag, TodoBoard, TodoItem, TodoList, UpdateTodoRequest } from todo/contracts
import { TodoAPI } from api/todo_api

class TodoApp < ReactComponent
  readonly @api: TodoAPI := TodoAPI.new("http://localhost:8080")
  @board: TodoBoard := TodoBoard.new(lists: [], tags: [])
  @title: String := ""
  @selected_tag_id: Integer := 0

  def component_did_mount()
    _reload()
    return
  end

  def _reload()
    @api.board(_receive_board)
    return
  end

  def _receive_board(board: TodoBoard)
    @board = board
    if @selected_tag_id == 0 && arrays.length(board.tags) > 0
      @selected_tag_id = board.tags[0].id
    end
    react.refresh(self)
    return
  end

  def _after_write(value: Any)
    @title = ""
    _reload()
    return
  end

  def _change_title(event: ReactEvent)
    @title = react.input_value(event)
    react.refresh(self)
    return
  end

  def _select_tag(event: ReactEvent)
    @selected_tag_id = numbers.parse_integer(react.input_value(event))
    react.refresh(self)
    return
  end

  def _create(event: ReactEvent)
    react.prevent_default(event)
    if @title == "" || arrays.length(@board.lists) == 0
      return
    end
    input := CreateTodoRequest.new(title: @title, tag_ids: [@selected_tag_id])
    @api.create_item(numbers.to_string(@board.lists[0].id), input, _after_write)
    return
  end

  def _toggle(event: ReactEvent)
    id := react.data_integer(event, "todoId")
    completed := react.data_boolean(event, "completed")
    input := UpdateTodoRequest.new(completed: !completed)
    @api.update_item(numbers.to_string(id), input, _after_write)
    return
  end

  def _tag_view(tag: Tag): ReactNode
    return react.element("span", { className: "tag" }, [tag.name])
  end

  def _item_view(item: TodoItem): ReactNode
    mut tag_nodes: Array<ReactNode> := []
    mut tag_index := 0
    while tag_index < arrays.length(item.tags)
      arrays.push(tag_nodes, _tag_view(item.tags[tag_index]))
      tag_index += 1
    end

    mut button_label := "Complete"
    if item.completed
      button_label = "Reopen"
    end
    return react.element(
      "li",
      { className: "todoItem" },
      [
        react.element("button", { className: "checkButton", onClick: _toggle, "data-todo-id": item.id, "data-completed": item.completed }, [button_label]),
        react.element("div", { className: "todoCopy" }, [
            react.element("strong", { className: "todoTitle" }, [item.title]),
            react.element("div", { className: "tags" }, tag_nodes),
          ]),
      ],
    )
  end

  def _list_view(list: TodoList): ReactNode
    mut item_nodes: Array<ReactNode> := []
    mut item_index := 0
    while item_index < arrays.length(list.items)
      arrays.push(item_nodes, _item_view(list.items[item_index]))
      item_index += 1
    end
    return react.element("section", { className: "todoList" }, [
        react.element("div", { className: "listHeading" }, [
            react.element("h2", {}, [list.name]),
            react.element("span", { className: "count" }, [numbers.to_string(arrays.length(list.items)) + " tasks"]),
          ]),
        react.element("ul", {}, item_nodes),
      ])
  end

  def _tag_options(): Array<ReactNode>
    mut options: Array<ReactNode> := []
    mut index := 0
    while index < arrays.length(@board.tags)
      tag := @board.tags[index]
      arrays.push(options, react.element("option", { value: tag.id }, [tag.name]))
      index += 1
    end
    return options
  end

  def render(): ReactNode
    mut list_nodes: Array<ReactNode> := []
    mut index := 0
    while index < arrays.length(@board.lists)
      arrays.push(list_nodes, _list_view(@board.lists[index]))
      index += 1
    end

    return react.element("main", { className: "shell" }, [
        react.element("header", { className: "hero" }, [
            react.element("p", { className: "eyebrow" }, ["TypeRB v0.1 · Go + React"]),
            react.element("h1", {}, ["One contract. Two targets."]),
            react.element("p", { className: "lede" }, ["Todo lists are 1:N; todo tags are N:M. Both sides consume the same TypeRB records."]),
          ]),
        react.element("form", { className: "composer", onSubmit: _create }, [
            react.element("input", { value: @title, onChange: _change_title, placeholder: "What should ship next?" }, []),
            react.element("select", { value: @selected_tag_id, onChange: _select_tag }, _tag_options()),
            react.element("button", { type: "submit" }, ["Add task"]),
          ]),
        react.element("div", { className: "lists" }, list_nodes),
      ])
  end
end
