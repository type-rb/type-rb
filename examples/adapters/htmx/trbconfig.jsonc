{
  "name": "htmx-attribute-conformance",
  "version": "0.1.0",
  "mode": "typescript",
  "sourceDir": "src",
  "outDir": "build",
  "copyFiles": true,
  "packageManagement": "managed",
  "dependencies": {
    "htmx.org": "4.0.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  },
  "typescript": {
    "packageManager": "bun",
    "moduleType": "module",
    "runtime": "browser",
    "scripts": {
      "check": "tsc -p tsconfig.json && bun scripts/conformance.mjs"
    }
  }
}
