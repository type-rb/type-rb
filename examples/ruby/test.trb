import trb/std/io
import trb/std/strings

# The same portable source runs in Ruby, Go, and TypeScript.
class Greeter
	readonly @message: String := "Hello"

	def greet(name: String): String
		return @message + ", " + name
	end
end

enum Recipient
	Named(name: String)
	Anonymous
end

def recipient_name(recipient: Recipient): String
	case recipient
	when Recipient::Named(name)
		return name
	when Recipient::Anonymous
		return "friend"
	end
end

def main()
	greeter := Greeter.new()
	recipient := Recipient::Named("TypeRB")
	io.puts(strings.uppercase(greeter.greet(recipient_name(recipient)))) # trb fmt keeps this comment.
	return
end
