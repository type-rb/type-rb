	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"]
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"]
	],
	"wordPattern": "(-?\\d*\\.\\d+)\\b|([^`~!@#%^&*()=+[{\\]}\\\\|;:'\\\",.<>/?\\s]+[!?]?)"
}
