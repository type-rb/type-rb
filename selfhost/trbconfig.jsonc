{
  // Stage 1 is generated by the Go bootstrap compiler. Later stages replace
  // bootstrap-owned packages one at a time while keeping this output stable.
  "name": "type-rb-selfhost",
  "version": "0.1.0",
  "mode": "go",
  "sourceDir": "src",
  "outDir": "generated",
  "copyFiles": false,
  "packageManagement": "external",
  "go": {
    "module": "github.com/type-rb/type-rb",
    "version": "1.26",
    "rootPackage": "selfhost"
  }
}
