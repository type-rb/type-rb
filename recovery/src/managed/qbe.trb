import { recovery_bootstrap_file_runtime } from compiler/io
import { emit_recovery_hash_runtime } from managed/hash_runtime
import { Diagnostic, boundary_diagnostic } from support/diagnostic
import { ComparisonOperator, FloatBinaryOperator, IntegerBinaryOperator, RecoveryScalarInstruction, ScalarType } from scalar/mir
import { RecoveryManagedFieldLayout, RecoveryManagedLayout, RecoveryManagedTypeDefinition, RecoveryManagedValueType, RecoveryManagedVariantLayout, compute_recovery_managed_layout, recovery_managed_type_definition, recovery_managed_value_is_managed } from managed/layout
import { emit_recovery_managed_runtime, emit_recovery_managed_runtime_report_support } from managed/runtime
import { RecoveryManagedBlock, RecoveryManagedFunction, RecoveryManagedInstruction, RecoveryManagedModule, RecoveryManagedParameter, RecoveryManagedResultType, RecoveryManagedRuntimeStatistic, RecoveryManagedTerminator, recovery_managed_block, recovery_managed_function, recovery_managed_instruction_result, verify_recovery_managed_mir } from managed/mir
import { QbeStaticData, qbe_comparison, qbe_emit_checked_add, qbe_emit_checked_divide, qbe_emit_checked_multiply, qbe_emit_checked_power, qbe_emit_checked_remainder, qbe_emit_checked_subtract, qbe_emit_integer_binary, qbe_emit_static_data, qbe_float_operator, qbe_line, qbe_scalar_type, qbe_static_symbol } from scalar/qbe
import { SourceOrigin } from snapshot/schema
import trb/std/result
import trb/std/string_builder

record RecoveryManagedQbeContext
	values: Hash<String, String>
	value_types: Hash<String, RecoveryManagedValueType>
	known_static_strings: Hash<String, String>
	transfer_slots: Hash<String, String>
	storage_slots: Hash<String, String>
	root_slots: Hash<String, String>
	aliased_parameters: Hash<String, Boolean>
	root_count: Integer
end

record RecoveryManagedKnownClosure
	function_id: String
	captures: Array<String>
end

def _qbe_line(mut writer: StringBuilder, value: String)
	qbe_line(writer, value)
	return
end

def _qbe_emit_static_data(static_data: Array<QbeStaticData>, mut writer: StringBuilder)
	qbe_emit_static_data(static_data, writer)
	return
end

def _qbe_emit_checked_add(mut writer: StringBuilder)
	qbe_emit_checked_add(writer)
	return
end

def _qbe_emit_checked_subtract(mut writer: StringBuilder)
	qbe_emit_checked_subtract(writer)
	return
end

def _qbe_emit_checked_multiply(mut writer: StringBuilder)
	qbe_emit_checked_multiply(writer)
	return
end

def _qbe_emit_checked_divide(mut writer: StringBuilder)
	qbe_emit_checked_divide(writer)
	return
end

def _qbe_emit_checked_remainder(mut writer: StringBuilder)
	qbe_emit_checked_remainder(writer)
	return
end

def _qbe_emit_checked_power(mut writer: StringBuilder)
	qbe_emit_checked_power(writer)
	return
end

def _qbe_emit_integer_binary(
		operator: IntegerBinaryOperator,
		result: String,
		left: String,
		right: String,
		block_index: Integer,
		instruction_index: Integer,
		mut writer: StringBuilder,
	)
	qbe_emit_integer_binary(operator, result, left, right, block_index, instruction_index, writer)
	return
end

def _qbe_float_operator(operator: FloatBinaryOperator): String
	return qbe_float_operator(operator)
end

def _qbe_comparison(operator: ComparisonOperator, suffix: String): String
	return qbe_comparison(operator, suffix)
end

def _qbe_type(value_type: ScalarType): String
	return qbe_scalar_type(value_type)
end

def _qbe_static_symbol(static_data: Array<QbeStaticData>, value: String): String
	return qbe_static_symbol(static_data, value)
end

def _recovery_managed_qbe_static_string_symbol(static_data: Array<QbeStaticData>, value: String): String
	mut index := 0
	while static_data[index].value != value
		index += 1
	end
	return "$trbn_managed_string_" + index.to_s()
end

def emit_recovery_managed_qbe(native_module: RecoveryManagedModule): Result<String, Diagnostic>
	return _emit_recovery_managed_qbe(native_module, false, false)
end

def emit_recovery_managed_qbe_with_runtime_report(native_module: RecoveryManagedModule): Result<String, Diagnostic>
	return _emit_recovery_managed_qbe(native_module, true, false)
end

def emit_bootstrap_qbe(native_module: RecoveryManagedModule): Result<String, Diagnostic>
	return _emit_recovery_managed_qbe(native_module, false, true)
end

def _emit_recovery_managed_qbe(
		native_module: RecoveryManagedModule,
		report_runtime: Boolean,
		bootstrap: Boolean,
	): Result<String, Diagnostic>
	try verify_recovery_managed_mir(native_module)
	mut bootstrap_index := -1
	if bootstrap
		bootstrap_index = try _recovery_managed_qbe_bootstrap_function_index(native_module)
	end
	static_data := _recovery_managed_qbe_collect_static_data(native_module)
	mut writer := StringBuilder.new()
	_qbe_emit_static_data(static_data, writer)
	_recovery_managed_qbe_emit_static_strings(static_data, writer)
	_recovery_managed_qbe_emit_projection_data(writer)
	if bootstrap
		_recovery_managed_qbe_emit_bootstrap_data(writer)
	end
	try _recovery_managed_qbe_emit_descriptors(native_module, writer)
	_recovery_managed_qbe_emit_runtime(writer)
	emit_recovery_managed_runtime(writer)
	if recovery_managed_type_definition(native_module.types, "Hash<String, Integer>") != nil
		emit_recovery_hash_runtime(writer)
	end
	if bootstrap
		_recovery_managed_qbe_emit_bootstrap_runtime(writer)
	end
	if report_runtime
		emit_recovery_managed_runtime_report_support(writer)
	end
	mut function_index := 0
	while function_index < native_module.functions.size()
		try _recovery_managed_qbe_emit_function(
			native_module,
			native_module.functions[function_index],
			function_index,
			static_data,
			writer,
		)
		function_index += 1
	end
	if bootstrap
		_recovery_managed_qbe_emit_bootstrap_entry(bootstrap_index, writer)
	else
		_recovery_managed_qbe_emit_entry(native_module, report_runtime, writer)
	end
	return Result<String, Diagnostic>::Ok(writer.to_s())
end

def _recovery_managed_qbe_bootstrap_function_index(native_module: RecoveryManagedModule): Result<Integer, Diagnostic>
	mut match_index := -1
	mut index := 0
	while index < native_module.functions.size()
		if native_module.functions[index].name == "compiler_main"
			if match_index != -1
				return Result<Integer, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", "/functions", "Native bootstrap compiler_main is ambiguous")
				)
			end
			match_index = index
		end
		index += 1
	end
	if match_index == -1
		return Result<Integer, Diagnostic>::Err(
			boundary_diagnostic("TRBN0004", "/functions", "Native bootstrap requires compiler_main")
		)
	end
	function := native_module.functions[match_index]
	if function.parameters.size() != 3 || !function.captures.empty?()
		return Result<Integer, Diagnostic>::Err(
			boundary_diagnostic(
				"TRBN0004",
				"/functions/" + match_index.to_s(),
				"Native bootstrap compiler_main must take String, String, Boolean without captures",
			)
		)
	end
	mut parameters_valid := true
	index = 0
	while index < 2
		case function.parameters[index].value_type
		when RecoveryManagedValueType::Aggregate(type_id)
			if type_id != "String"
				parameters_valid = false
			end
		else
			parameters_valid = false
		end
		index += 1
	end
	case function.parameters[2].value_type
	when RecoveryManagedValueType::Scalar(scalar)
		if scalar != ScalarType::Boolean
			parameters_valid = false
		end
	else
		parameters_valid = false
	end
	if !parameters_valid
		return Result<Integer, Diagnostic>::Err(
			boundary_diagnostic(
				"TRBN0004",
				"/functions/" + match_index.to_s() + "/parameters",
				"Native bootstrap compiler_main parameters must be String, String, Boolean",
			)
		)
	end
	mut result_valid := false
	case function.result_type
	when RecoveryManagedResultType::Void
	when RecoveryManagedResultType::Value(value_type)
		case value_type
		when RecoveryManagedValueType::Scalar(scalar)
			if scalar == ScalarType::Integer
				result_valid = true
			end
		else
		end
	end
	if !result_valid
		return Result<Integer, Diagnostic>::Err(
			boundary_diagnostic(
				"TRBN0004",
				"/functions/" + match_index.to_s() + "/result",
				"Native bootstrap compiler_main must return Integer",
			)
		)
	end
	if _recovery_managed_qbe_function_uses_closure_abi(native_module, function.id)
		return Result<Integer, Diagnostic>::Err(
			boundary_diagnostic(
				"TRBN0004",
				"/functions/" + match_index.to_s(),
				"Native bootstrap compiler_main must use the direct-call ABI",
			)
		)
	end
	return Result<Integer, Diagnostic>::Ok(match_index)
end

def _recovery_compiler_usage(): String
	return "usage: compiler {--source-content MODE SOURCE|--source-file MODE FILE}\n"
end

def _recovery_managed_qbe_emit_bootstrap_data(mut writer: StringBuilder)
	usage := _recovery_compiler_usage()
	bytes := usage.to_bytes()
	mut values: Array<String> := []
	mut index := 0
	while index < bytes.size()
		values.push(bytes.at(index).to_s())
		index += 1
	end
	_qbe_line(writer, "data $trbn_bootstrap_usage = { b " + values.join(" ") + " }")
	_qbe_line(writer, "data $trbn_bootstrap_source_file = { b \"--source-file\", b 0 }")
	_qbe_line(writer, "data $trbn_bootstrap_rb = { b \"rb\", b 0 }")
	_qbe_line(writer, "data $trbn_bootstrap_file_error = { b \"compiler: cannot read source file: \" }")
	_qbe_line(writer, "data $trbn_bootstrap_newline = { b 10 }")
	_qbe_line(
		writer,
		"data $trbn_bootstrap_source_content = { b 45 45 115 111 117 114 99 101 45 99 111 110 116 101 110 116 0 }",
	)
	_qbe_line(writer, "")
	return
end

def _recovery_managed_qbe_emit_bootstrap_runtime(mut writer: StringBuilder)
	_qbe_line(writer, recovery_bootstrap_file_runtime())
	_qbe_line(writer, "function l $trbn_bootstrap_string_from_c(l %source) {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\t%length =l call $strlen(l %source)")
	_qbe_line(writer, "\t%points =l call $trbn_utf8_count(l %source, l %length)")
	_qbe_line(writer, "\t%string =l call $trbn_string_new(l %source, l %length, l %points)")
	_qbe_line(writer, "\tret %string")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	return
end

def _recovery_managed_qbe_emit_static_strings(static_data: Array<QbeStaticData>, mut writer: StringBuilder)
	mut index := 0
	while index < static_data.size()
		item := static_data[index]
		bytes := item.value.to_bytes()
		mut tail := ""
		if bytes.size() != 0
			mut values: Array<String> := []
			mut byte_index := 0
			while byte_index < bytes.size()
				values.push(bytes.at(byte_index).to_s())
				byte_index += 1
			end
			tail = ", b " + values.join(" ")
		end
		_qbe_line(
			writer,
			"data $trbn_managed_string_" + index.to_s() + " = align 8 { l 0, l $trbn_desc_string, l 0, l 1, l " +
			bytes.size().to_s() + ", l " + item.value.size().to_s() + tail + " }",
		)
		index += 1
	end
	_qbe_line(writer, "")
	return
end

def _recovery_managed_qbe_collect_static_data(native_module: RecoveryManagedModule): Array<QbeStaticData>
	mut static_data: Array<QbeStaticData> := []
	mut symbols: Hash<String, String> := {}
	mut function_index := 0
	while function_index < native_module.functions.size()
		function := native_module.functions[function_index]
		mut known_static_strings: Hash<String, String> := {}
		mut block_index := 0
		while block_index < function.blocks.size()
			block := function.blocks[block_index]
			mut instruction_index := 0
			while instruction_index < block.instructions.size()
				case block.instructions[instruction_index]
				when RecoveryManagedInstruction::Scalar(scalar)
					case scalar
					when RecoveryScalarInstruction::WriteStatic(value, _origin)
						if !symbols.key?(value)
							symbol := "$trbn_data_" + static_data.size().to_s()
							symbols[value] = symbol
							static_data.push(QbeStaticData.new(symbol: symbol, value: value))
						end
					else
					end
				when RecoveryManagedInstruction::StringLiteral(result, value, _origin)
					known_static_strings[result] = value
					if !symbols.key?(value)
						symbol := "$trbn_data_" + static_data.size().to_s()
						symbols[value] = symbol
						static_data.push(QbeStaticData.new(symbol: symbol, value: value))
					end
				when RecoveryManagedInstruction::StringConcat(result, left, right, _origin)
					if known_static_strings.key?(left) && known_static_strings.key?(right)
						value := known_static_strings.fetch(left) + known_static_strings.fetch(right)
						known_static_strings[result] = value
						if !symbols.key?(value)
							symbol := "$trbn_data_" + static_data.size().to_s()
							symbols[value] = symbol
							static_data.push(QbeStaticData.new(symbol: symbol, value: value))
						end
					end
				else
				end
				instruction_index += 1
			end
			block_index += 1
		end
		function_index += 1
	end
	return static_data
end

def _recovery_managed_qbe_emit_projection_data(mut writer: StringBuilder)
	_qbe_line(writer, "data $trbn_variant_projection_error = { b 112 97 110 105 99 58 32 105 110 118 97 108 105 100 32 101 110 117 109 32 112 114 111 106 101 99 116 105 111 110 10 }")
	_qbe_line(writer, "")
	return
end

def _recovery_managed_qbe_emit_descriptors(
		native_module: RecoveryManagedModule,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut index := 0
	while index < native_module.types.size()
		definition := native_module.types[index]
		symbol := _recovery_managed_qbe_type_descriptor(index)
		case definition
		when RecoveryManagedTypeDefinition::Hash(_type_id)
		when RecoveryManagedTypeDefinition::String(_type_id)
		when RecoveryManagedTypeDefinition::Array(_type_id, element_type)
			mut managed := "0"
			if try recovery_managed_value_is_managed(native_module.types, element_type)
				managed = "1"
			end
			_qbe_line(writer, "data " + symbol + " = align 8 { l 2, l " + managed + " }")
		when RecoveryManagedTypeDefinition::Function(_type_id, _parameter_types, _result_type)
		when RecoveryManagedTypeDefinition::Record(type_id, _fields)
			layout := try compute_recovery_managed_layout(native_module.types, type_id)
			if layout.managed
				mut offsets: Array<String> := []
				mut field_index := 0
				while field_index < layout.fields.size()
					field := layout.fields[field_index]
					if field.managed
						offsets.push("l " + (field.offset + 32).to_s())
					end
					field_index += 1
				end
				_recovery_managed_qbe_emit_fixed_descriptor(symbol, offsets, writer)
			else
				_qbe_line(writer, "data " + symbol + " = align 8 { l 0 }")
			end
		when RecoveryManagedTypeDefinition::Tagged(type_id, _variants)
			layout := try compute_recovery_managed_layout(native_module.types, type_id)
			if layout.managed
				mut variant_symbols: Array<String> := []
				mut variant_index := 0
				while variant_index < layout.variants.size()
					variant := layout.variants[variant_index]
					variant_symbol := symbol + "_v" + variant_index.to_s()
					variant_symbols.push("l " + variant_symbol)
					mut offsets: Array<String> := []
					mut field_index := 0
					while field_index < variant.fields.size()
						field := variant.fields[field_index]
						if field.managed
							offsets.push("l " + (field.offset + 32).to_s())
						end
						field_index += 1
					end
					_qbe_line(
						writer,
						"data " + variant_symbol + " = align 8 { l " + offsets.size().to_s() +
						_recovery_managed_descriptor_tail(offsets) + " }",
					)
					variant_index += 1
				end
				table := symbol + "_table"
				_qbe_line(writer, "data " + table + " = align 8 { " + variant_symbols.join(", ") + " }")
				_qbe_line(
					writer,
					"data " + symbol + " = align 8 { l 3, l " + layout.variants.size().to_s() + ", l " + table + " }",
				)
			else
				_qbe_line(writer, "data " + symbol + " = align 8 { l 0 }")
			end
		end
		index += 1
	end
	index = 0
	while index < native_module.functions.size()
		function := native_module.functions[index]
		mut offsets: Array<String> := []
		mut capture_index := 0
		mut capture_offset := 0
		while capture_index < function.captures.size()
			capture := function.captures[capture_index]
			if try recovery_managed_value_is_managed(native_module.types, capture.value_type)
				offsets.push("l " + (32 + capture_offset).to_s())
			end
			capture_offset += try _recovery_managed_qbe_capture_storage_size(native_module, capture.value_type)
			capture_index += 1
		end
		_recovery_managed_qbe_emit_fixed_descriptor(_recovery_managed_qbe_environment_descriptor(index), offsets, writer)
		index += 1
	end
	_qbe_line(writer, "")
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_fixed_descriptor(
		symbol: String,
		offsets: Array<String>,
		mut writer: StringBuilder,
	)
	_qbe_line(
		writer,
		"data " + symbol + " = align 8 { l 1, l " + offsets.size().to_s() + _recovery_managed_descriptor_tail(offsets) + " }",
	)
	return
end

def _recovery_managed_descriptor_tail(values: Array<String>): String
	if values.empty?()
		return ""
	end
	return ", " + values.join(", ")
end

def _recovery_managed_qbe_type_descriptor(index: Integer): String
	return "$trbn_managed_desc_t" + index.to_s()
end

def _recovery_managed_qbe_environment_descriptor(index: Integer): String
	return "$trbn_managed_env_f" + index.to_s()
end

def _recovery_managed_qbe_emit_runtime(mut writer: StringBuilder)
	_qbe_line(writer, "function $trbn_integer_range_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_integer_range_error, l 45)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_line(writer, "function $trbn_division_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_division_error, l 24)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_line(writer, "function $trbn_negative_exponent_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_negative_exponent_error, l 33)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_line(writer, "function $trbn_variant_projection_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_variant_projection_error, l 31)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_emit_checked_add(writer)
	_qbe_emit_checked_subtract(writer)
	_qbe_emit_checked_multiply(writer)
	_qbe_emit_checked_divide(writer)
	_qbe_emit_checked_remainder(writer)
	_qbe_emit_checked_power(writer)
	return
end

def _recovery_managed_qbe_emit_function(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		function_index: Integer,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	context := try _recovery_managed_qbe_context(native_module, function)
	mut parameters: Array<String> := []
	case function.result_type
	when RecoveryManagedResultType::Void
	when RecoveryManagedResultType::Value(value_type)
		case value_type
		when RecoveryManagedValueType::Scalar(_scalar)
		when RecoveryManagedValueType::Aggregate(_type_id)
			if !(try recovery_managed_value_is_managed(native_module.types, value_type))
				parameters.push("l %return")
			end
		end
	end
	if _recovery_managed_qbe_function_uses_closure_abi(native_module, function.id)
		parameters.push("l %environment")
	end
	mut parameter_index := 0
	while parameter_index < function.parameters.size()
		parameter := function.parameters[parameter_index]
		parameters.push(_recovery_managed_qbe_abi_type(parameter.value_type) + " " + context.values.fetch(parameter.id))
		parameter_index += 1
	end
	mut result_prefix := ""
	case function.result_type
	when RecoveryManagedResultType::Void
	when RecoveryManagedResultType::Value(value_type)
		case value_type
		when RecoveryManagedValueType::Scalar(scalar)
			result_prefix = _qbe_type(scalar) + " "
		when RecoveryManagedValueType::Aggregate(_type_id)
			if try recovery_managed_value_is_managed(native_module.types, value_type)
				result_prefix = "l "
			end
		end
	end
	_qbe_line(writer, "function " + result_prefix + "$trbn_managed_f" + function_index.to_s() + "(" + parameters.join(", ") + ") {")
	entry_index := _recovery_managed_qbe_block_index(function.blocks, function.entry)
	try _recovery_managed_qbe_emit_block(native_module, function, entry_index, context, static_data, writer)
	mut block_index := 0
	while block_index < function.blocks.size()
		if block_index != entry_index
			try _recovery_managed_qbe_emit_block(native_module, function, block_index, context, static_data, writer)
		end
		block_index += 1
	end
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_context(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
	): Result<RecoveryManagedQbeContext, Diagnostic>
	mut values: Hash<String, String> := {}
	mut value_types: Hash<String, RecoveryManagedValueType> := {}
	mut known_static_strings: Hash<String, String> := {}
	mut transfer_slots: Hash<String, String> := {}
	mut storage_slots: Hash<String, String> := {}
	mut root_slots: Hash<String, String> := {}
	mut aliased_parameters: Hash<String, Boolean> := {}
	mut next_value := 0
	mut next_transfer := 0
	mut next_storage := 0
	mut next_root := 0
	mut parameter_index := 0
	while parameter_index < function.captures.size()
		capture := function.captures[parameter_index]
		values[capture.id] = "%v" + next_value.to_s()
		value_types[capture.id] = capture.value_type
		next_value += 1
		if try recovery_managed_value_is_managed(native_module.types, capture.value_type)
			root_slots[capture.id] = "%root" + next_root.to_s()
			next_root += 1
		end
		parameter_index += 1
	end
	parameter_index = 0
	while parameter_index < function.parameters.size()
		parameter := function.parameters[parameter_index]
		values[parameter.id] = "%v" + next_value.to_s()
		value_types[parameter.id] = parameter.value_type
		next_value += 1
		if try recovery_managed_value_is_managed(native_module.types, parameter.value_type)
			root_slots[parameter.id] = "%root" + next_root.to_s()
			next_root += 1
		end
		parameter_index += 1
	end
	mut block_index := 0
	while block_index < function.blocks.size()
		block := function.blocks[block_index]
		parameter_index = 0
		while parameter_index < block.parameters.size()
			parameter := block.parameters[parameter_index]
			transfer_slots[parameter.id] = "%transfer" + next_transfer.to_s()
			next_transfer += 1
			value_types[parameter.id] = parameter.value_type
			case parameter.value_type
			when RecoveryManagedValueType::Scalar(_scalar)
				values[parameter.id] = "%v" + next_value.to_s()
				next_value += 1
			when RecoveryManagedValueType::Aggregate(_type_id)
				if try recovery_managed_value_is_managed(native_module.types, parameter.value_type)
					values[parameter.id] = "%v" + next_value.to_s()
					next_value += 1
					root_slots[parameter.id] = "%root" + next_root.to_s()
					next_root += 1
				else
					storage_slots[parameter.id] = "%storage" + next_storage.to_s()
					values[parameter.id] = transfer_slots.fetch(parameter.id)
					next_storage += 1
				end
			end
			parameter_index += 1
		end
		mut instruction_index := 0
		while instruction_index < block.instructions.size()
			instruction := block.instructions[instruction_index]
			case instruction
			when RecoveryManagedInstruction::StringLiteral(result, value, _origin)
				known_static_strings[result] = value
			when RecoveryManagedInstruction::StringConcat(result, left, right, _origin)
				if known_static_strings.key?(left) && known_static_strings.key?(right)
					known_static_strings[result] = known_static_strings.fetch(left) + known_static_strings.fetch(right)
				end
			else
			end
			result := recovery_managed_instruction_result(instruction)
			if result != nil
				value_type := try _recovery_managed_qbe_instruction_type(native_module, instruction)
				value_types[result] = value_type
				case value_type
				when RecoveryManagedValueType::Scalar(_scalar)
					values[result] = "%v" + next_value.to_s()
					next_value += 1
				when RecoveryManagedValueType::Aggregate(_type_id)
					if try recovery_managed_value_is_managed(native_module.types, value_type)
						values[result] = "%v" + next_value.to_s()
						next_value += 1
						root_slots[result] = "%root" + next_root.to_s()
						next_root += 1
					else
						storage_slots[result] = "%storage" + next_storage.to_s()
						values[result] = storage_slots.fetch(result)
						next_storage += 1
					end
				end
			end
			instruction_index += 1
		end
		block_index += 1
	end
	# Resolve each parameter once and redirect every alias to the removed
	# definition. Later passes only consider unresolved block parameters.
	mut alias_pass := 0
	mut changed := true
	while alias_pass < function.blocks.size() && changed
		changed = false
		block_index = 0
		while block_index < function.blocks.size()
			block := function.blocks[block_index]
			parameter_index = 0
			while parameter_index < block.parameters.size()
				parameter := block.parameters[parameter_index]
				if !aliased_parameters.key?(parameter.id)
					incoming := _recovery_managed_qbe_common_incoming_value(
						function,
						block.id,
						parameter_index,
						values.fetch(parameter.id),
						values,
					)
					if !incoming.empty?()
						case parameter.value_type
						when RecoveryManagedValueType::Scalar(_scalar)
							_recovery_managed_qbe_redirect_alias(values, values.fetch(parameter.id), incoming)
							aliased_parameters[parameter.id] = true
							changed = true
						when RecoveryManagedValueType::Aggregate(_type_id)
							if try recovery_managed_value_is_managed(native_module.types, parameter.value_type)
								incoming_root := _recovery_managed_qbe_common_incoming_root(
									function,
									block.id,
									parameter_index,
									root_slots.fetch(parameter.id),
									root_slots,
								)
								if !incoming_root.empty?()
									_recovery_managed_qbe_redirect_alias(values, values.fetch(parameter.id), incoming)
									_recovery_managed_qbe_redirect_alias(root_slots, root_slots.fetch(parameter.id), incoming_root)
									aliased_parameters[parameter.id] = true
									changed = true
								end
							else
								_recovery_managed_qbe_redirect_alias(values, values.fetch(parameter.id), incoming)
								aliased_parameters[parameter.id] = true
								changed = true
							end
						end
					end
				end
				parameter_index += 1
			end
			block_index += 1
		end
		alias_pass += 1
	end
	root_count := _recovery_managed_qbe_compact_roots(root_slots)
	return Result<RecoveryManagedQbeContext, Diagnostic>::Ok(
		RecoveryManagedQbeContext.new(
			values: values,
			value_types: value_types,
			known_static_strings: known_static_strings,
			transfer_slots: transfer_slots,
			storage_slots: storage_slots,
			root_slots: root_slots,
			aliased_parameters: aliased_parameters,
			root_count: root_count,
		)
	)
end

# Aliases already share their original definition's root. Remove the holes left
# by their discarded slots before allocating and initializing the root frame.
# Rewrite from a separate map so a new dense name cannot redirect another root.
def _recovery_managed_qbe_compact_roots(mut root_slots: Hash<String, String>): Integer
	mut compacted: Hash<String, String> := {}
	keys := root_slots.keys().sort()
	mut index := 0
	while index < keys.size()
		key := keys[index]
		previous := root_slots.fetch(key)
		if !compacted.key?(previous)
			compacted[previous] = "%root" + compacted.size().to_s()
		end
		root_slots[key] = compacted.fetch(previous)
		index += 1
	end
	return compacted.size()
end

# Operand strings are shared by earlier aliases. Replacing only the current
# parameter would leave references to a definition whose load is now omitted.
def _recovery_managed_qbe_redirect_alias(mut values: Hash<String, String>, previous: String, replacement: String)
	keys := values.keys()
	mut index := 0
	while index < keys.size()
		key := keys[index]
		if values.fetch(key) == previous
			values[key] = replacement
		end
		index += 1
	end
	return
end

def _recovery_managed_qbe_common_incoming_value(
		function: RecoveryManagedFunction,
		target: String,
		parameter_index: Integer,
		current: String,
		values: Hash<String, String>,
	): String
	mut common := ""
	mut block_index := 0
	while block_index < function.blocks.size()
		case function.blocks[block_index].terminator
		when RecoveryManagedTerminator::Jump(edge_target, arguments, _origin)
			if edge_target == target
				candidate := values.fetch(arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when RecoveryManagedTerminator::Branch(
				_condition,
				when_true,
				true_arguments,
				when_false,
				false_arguments,
				_origin,
			)
			if when_true == target
				candidate := values.fetch(true_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
			if when_false == target
				candidate := values.fetch(false_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when RecoveryManagedTerminator::Return(_value, _origin)
		end
		block_index += 1
	end
	return common
end

def _recovery_managed_qbe_common_incoming_root(
		function: RecoveryManagedFunction,
		target: String,
		parameter_index: Integer,
		current: String,
		root_slots: Hash<String, String>,
	): String
	mut common := ""
	mut block_index := 0
	while block_index < function.blocks.size()
		case function.blocks[block_index].terminator
		when RecoveryManagedTerminator::Jump(edge_target, arguments, _origin)
			if edge_target == target
				candidate := root_slots.fetch(arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when RecoveryManagedTerminator::Branch(
				_condition,
				when_true,
				true_arguments,
				when_false,
				false_arguments,
				_origin,
			)
			if when_true == target
				candidate := root_slots.fetch(true_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
			if when_false == target
				candidate := root_slots.fetch(false_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when RecoveryManagedTerminator::Return(_value, _origin)
		end
		block_index += 1
	end
	return common
end

def _recovery_managed_qbe_instruction_type(
		native_module: RecoveryManagedModule,
		instruction: RecoveryManagedInstruction,
	): Result<RecoveryManagedValueType, Diagnostic>
	case instruction
	when RecoveryManagedInstruction::Scalar(scalar)
		case scalar
		when RecoveryScalarInstruction::BooleanLiteral(_result, _value, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Boolean))
		when RecoveryScalarInstruction::IntegerLiteral(_result, _value, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Integer))
		when RecoveryScalarInstruction::FloatLiteral(_result, _value, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Float))
		when RecoveryScalarInstruction::IntegerBinary(_result, _operator, _left, _right, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Integer))
		when RecoveryScalarInstruction::FloatBinary(_result, _operator, _left, _right, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Float))
		when RecoveryScalarInstruction::IntegerCompare(_result, _operator, _left, _right, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Boolean))
		when RecoveryScalarInstruction::FloatCompare(_result, _operator, _left, _right, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Boolean))
		when RecoveryScalarInstruction::BooleanNot(_result, _value, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Boolean))
		when RecoveryScalarInstruction::Call(_result, _function_id, _arguments, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
		when RecoveryScalarInstruction::WriteStatic(_value, _origin)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
		end
	when RecoveryManagedInstruction::StringLiteral(_result, _value, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate("String"))
	when RecoveryManagedInstruction::StringConcat(_result, _left, _right, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate("String"))
	when RecoveryManagedInstruction::StringEqual(_result, _left, _right, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Boolean))
	when RecoveryManagedInstruction::StringSize(_result, _value, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Integer))
	when RecoveryManagedInstruction::StringIndex(_result, _value, _index, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate("String"))
	when RecoveryManagedInstruction::WriteString(_value, _newline, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
	when RecoveryManagedInstruction::HashConstruct(_result, type_id, _keys, _values, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate(type_id))
	when RecoveryManagedInstruction::HashGet(_result, _type_id, _hash, _key, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Integer))
	when RecoveryManagedInstruction::HashContains(_result, _type_id, _hash, _key, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Boolean))
	when RecoveryManagedInstruction::HashSet(_type_id, _hash, _key, _value, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
	when RecoveryManagedInstruction::ArrayConstruct(_result, type_id, _arguments, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate(type_id))
	when RecoveryManagedInstruction::ArraySize(_result, _type_id, _array, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Integer))
	when RecoveryManagedInstruction::ArrayGet(_result, type_id, _array, _index, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(_recovery_managed_qbe_array_element_type(native_module, type_id))
	when RecoveryManagedInstruction::ArraySet(_type_id, _array, _index, _value, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
	when RecoveryManagedInstruction::ArrayPush(_type_id, _array, _value, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
	when RecoveryManagedInstruction::ClosureConstruct(_result, type_id, _function_id, _captures, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate(type_id))
	when RecoveryManagedInstruction::ClosureCall(_result, type_id, _closure, _arguments, _origin)
		result_type := _recovery_managed_qbe_function_result_type(native_module, type_id)
		if result_type == nil
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
		end
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(result_type)
	when RecoveryManagedInstruction::RuntimeCollect(_origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
	when RecoveryManagedInstruction::RuntimeStatistic(_result, _statistic, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Integer))
	when RecoveryManagedInstruction::RecordConstruct(_result, type_id, _arguments, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate(type_id))
	when RecoveryManagedInstruction::RecordProject(_result, type_id, _record, field, _origin)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(_recovery_managed_qbe_required_field(layout, field).value_type)
	when RecoveryManagedInstruction::VariantConstruct(_result, type_id, _variant, _arguments, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Aggregate(type_id))
	when RecoveryManagedInstruction::VariantTest(_result, _type_id, _value, _variant, _origin)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Boolean))
	when RecoveryManagedInstruction::VariantProject(_result, type_id, _value, variant, field, _origin)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		variant_layout := _recovery_managed_qbe_required_variant(layout, variant)
		return Result<RecoveryManagedValueType, Diagnostic>::Ok(_recovery_managed_qbe_required_variant_field(variant_layout, field).value_type)
	when RecoveryManagedInstruction::Call(_result, function_id, _arguments, _origin)
		callee := recovery_managed_function(native_module.functions, function_id)
		case callee.result_type
		when RecoveryManagedResultType::Void
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(RecoveryManagedValueType::Scalar(ScalarType::Void))
		when RecoveryManagedResultType::Value(value_type)
			return Result<RecoveryManagedValueType, Diagnostic>::Ok(value_type)
		end
	end
end

def _recovery_managed_qbe_emit_block(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		block_index: Integer,
		context: RecoveryManagedQbeContext,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	block := function.blocks[block_index]
	_qbe_line(writer, "@b" + block_index.to_s())
	if block.id == function.entry
		try _recovery_managed_qbe_emit_allocations(native_module, function, context, writer)
		try _recovery_managed_qbe_emit_capture_loads(native_module, function, context, writer)
		_recovery_managed_qbe_emit_root_frame(function, context, writer)
	else
		try _recovery_managed_qbe_emit_block_parameter_loads(native_module, block, context, writer)
	end
	mut instruction_index := 0
	while instruction_index < block.instructions.size()
		try _recovery_managed_qbe_emit_instruction(
			native_module,
			function,
			block.instructions[instruction_index],
			block_index,
			instruction_index,
			context,
			static_data,
			writer,
		)
		result := recovery_managed_instruction_result(block.instructions[instruction_index])
		if result != nil
			if context.root_slots.key?(result)
				_qbe_line(writer, "\tstorel " + context.values.fetch(result) + ", " + context.root_slots.fetch(result))
			end
		end
		instruction_index += 1
	end
	try _recovery_managed_qbe_emit_terminator(native_module, function, block.terminator, block_index, context, writer)
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_allocations(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut block_index := 0
	while block_index < function.blocks.size()
		block := function.blocks[block_index]
		mut parameter_index := 0
		while parameter_index < block.parameters.size()
			parameter := block.parameters[parameter_index]
			try _recovery_managed_qbe_emit_allocation(
				native_module,
				parameter.value_type,
				context.transfer_slots.fetch(parameter.id),
				writer,
			)
			if context.storage_slots.key?(parameter.id)
				try _recovery_managed_qbe_emit_allocation(
					native_module,
					parameter.value_type,
					context.storage_slots.fetch(parameter.id),
					writer,
				)
			end
			parameter_index += 1
		end
		mut instruction_index := 0
		while instruction_index < block.instructions.size()
			result := recovery_managed_instruction_result(block.instructions[instruction_index])
			if result != nil
				if context.storage_slots.key?(result)
					try _recovery_managed_qbe_emit_allocation(
						native_module,
						context.value_types.fetch(result),
						context.storage_slots.fetch(result),
						writer,
					)
				end
			end
			instruction_index += 1
		end
		block_index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_allocation(
		native_module: RecoveryManagedModule,
		value_type: RecoveryManagedValueType,
		slot: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut allocation := "alloc8"
	mut size := 8
	case value_type
	when RecoveryManagedValueType::Scalar(scalar)
		if scalar == ScalarType::Boolean
			allocation = "alloc4"
			size = 4
		end
	when RecoveryManagedValueType::Aggregate(type_id)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		if layout.managed
			size = 8
		else
			size = layout.size
		end
		if !layout.managed && layout.alignment < 8
			allocation = "alloc4"
			if size < 4
				size = 4
			end
		end
	end
	_qbe_line(writer, "\t" + slot + " =l " + allocation + " " + size.to_s())
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_block_parameter_loads(
		native_module: RecoveryManagedModule,
		block: RecoveryManagedBlock,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut index := 0
	while index < block.parameters.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when RecoveryManagedValueType::Scalar(scalar)
			if _recovery_managed_qbe_parameter_uses_transfer(parameter, context)
				_qbe_line(writer,
					"\t" + context.values.fetch(parameter.id) + " =" + _qbe_type(scalar) + " " +
					_recovery_managed_qbe_scalar_slot_load(scalar) + " " + context.transfer_slots.fetch(parameter.id)
				)
			end
		when RecoveryManagedValueType::Aggregate(_type_id)
			if try recovery_managed_value_is_managed(native_module.types, parameter.value_type)
				if _recovery_managed_qbe_parameter_uses_transfer(parameter, context)
					_qbe_line(
						writer,
						"\t" + context.values.fetch(parameter.id) + " =l loadl " +
						context.transfer_slots.fetch(parameter.id),
					)
					_qbe_line(
						writer,
						"\tstorel " + context.values.fetch(parameter.id) + ", " + context.root_slots.fetch(parameter.id),
					)
				end
			end
		end
		index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_capture_loads(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut index := 0
	mut offset := 0
	while index < function.captures.size()
		capture := function.captures[index]
		address := _recovery_managed_qbe_address("%environment", 32 + offset, "%capture_address" + index.to_s(), writer)
		case capture.value_type
		when RecoveryManagedValueType::Scalar(scalar)
			_qbe_line(
				writer,
				"\t" + context.values.fetch(capture.id) + " =" + _qbe_type(scalar) + " " +
				_recovery_managed_qbe_scalar_slot_load(scalar) + " " + address,
			)
		when RecoveryManagedValueType::Aggregate(_type_id)
			if try recovery_managed_value_is_managed(native_module.types, capture.value_type)
				_qbe_line(writer, "\t" + context.values.fetch(capture.id) + " =l loadl " + address)
			else
				_qbe_line(writer, "\t" + context.values.fetch(capture.id) + " =l copy " + address)
			end
		end
		offset += try _recovery_managed_qbe_capture_storage_size(native_module, capture.value_type)
		index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_root_frame(
		function: RecoveryManagedFunction,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	)
	frame_size := 16 + context.root_count * 8
	_qbe_line(writer, "\t%root_frame =l alloc8 " + frame_size.to_s())
	_qbe_line(writer, "\t%previous_roots =l loadl $trbn_roots")
	_qbe_line(writer, "\tstorel %previous_roots, %root_frame")
	_qbe_line(writer, "\t%root_count_address =l add %root_frame, 8")
	_qbe_line(writer, "\tstorel " + context.root_count.to_s() + ", %root_count_address")
	mut index := 0
	while index < context.root_count
		_qbe_line(writer, "\t%root" + index.to_s() + " =l add %root_frame, " + (16 + index * 8).to_s())
		_qbe_line(writer, "\tstorel 0, %root" + index.to_s())
		index += 1
	end
	index = 0
	while index < function.captures.size()
		capture := function.captures[index]
		if context.root_slots.key?(capture.id)
			_qbe_line(writer, "\tstorel " + context.values.fetch(capture.id) + ", " + context.root_slots.fetch(capture.id))
		end
		index += 1
	end
	index = 0
	while index < function.parameters.size()
		parameter := function.parameters[index]
		if context.root_slots.key?(parameter.id)
			_qbe_line(writer, "\tstorel " + context.values.fetch(parameter.id) + ", " + context.root_slots.fetch(parameter.id))
		end
		index += 1
	end
	_qbe_line(writer, "\tstorel %root_frame, $trbn_roots")
	return
end

def _recovery_managed_qbe_emit_instruction(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		instruction: RecoveryManagedInstruction,
		block_index: Integer,
		instruction_index: Integer,
		context: RecoveryManagedQbeContext,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	prefix := "%g3_" + block_index.to_s() + "_" + instruction_index.to_s() + "_"
	case instruction
	when RecoveryManagedInstruction::Scalar(scalar)
		_recovery_managed_qbe_emit_scalar(native_module, scalar, block_index, instruction_index, context.values, static_data, writer)
	when RecoveryManagedInstruction::StringLiteral(result, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l copy " + _recovery_managed_qbe_static_string_symbol(static_data, value),
		)
	when RecoveryManagedInstruction::StringConcat(result, left, right, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		if context.known_static_strings.key?(result)
			_qbe_line(
				writer,
				"\t" + context.values.fetch(result) + " =l copy " +
				_recovery_managed_qbe_static_string_symbol(static_data, context.known_static_strings.fetch(result)),
			)
		else
			_qbe_line(
				writer,
				"\t" + context.values.fetch(result) + " =l call $trbn_string_concat(l " +
				context.values.fetch(left) + ", l " + context.values.fetch(right) + ")",
			)
		end
	when RecoveryManagedInstruction::StringEqual(result, left, right, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =w call $trbn_string_equal(l " +
			context.values.fetch(left) + ", l " + context.values.fetch(right) + ")",
		)
	when RecoveryManagedInstruction::StringSize(result, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		address := _recovery_managed_qbe_address(context.values.fetch(value), 40, prefix + "string_size", writer)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l loadl " + address)
	when RecoveryManagedInstruction::StringIndex(result, value, index, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l call $trbn_string_index(l " +
			context.values.fetch(value) + ", l " + context.values.fetch(index) + ")",
		)
	when RecoveryManagedInstruction::WriteString(value, newline, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		mut newline_value := "0"
		if newline
			newline_value = "1"
		end
		_qbe_line(writer, "\tcall $trbn_write_string(l " + context.values.fetch(value) + ", w " + newline_value + ")")
	when RecoveryManagedInstruction::HashConstruct(result, _type_id, entry_keys, entry_values, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l call $trbn_hash_new(l 8)")
		_qbe_line(writer, "\tstorel " + context.values.fetch(result) + ", " + context.root_slots.fetch(result))
		mut index := 0
		while index < entry_keys.size()
			_qbe_line(writer, "\tcall $trbn_hash_set(l " + context.values.fetch(result) + ", l " + context.values.fetch(entry_keys[index]) + ", l " + context.values.fetch(entry_values[index]) + ")")
			index += 1
		end
	when RecoveryManagedInstruction::HashGet(result, _type_id, hash, key, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l call $trbn_hash_get(l " + context.values.fetch(hash) + ", l " + context.values.fetch(key) + ")")
	when RecoveryManagedInstruction::HashContains(result, _type_id, hash, key, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =w call $trbn_hash_contains(l " + context.values.fetch(hash) + ", l " + context.values.fetch(key) + ")")
	when RecoveryManagedInstruction::HashSet(_type_id, hash, key, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\tcall $trbn_hash_set(l " + context.values.fetch(hash) + ", l " + context.values.fetch(key) + ", l " + context.values.fetch(value) + ")")
	when RecoveryManagedInstruction::ArrayConstruct(result, type_id, arguments, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		descriptor := _recovery_managed_qbe_type_descriptor(_recovery_managed_qbe_type_index(native_module.types, type_id))
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l call $trbn_array_new(l " + descriptor + ", l " +
			arguments.size().to_s() + ")",
		)
		backing_address := _recovery_managed_qbe_address(context.values.fetch(result), 64, prefix + "array_backing_address", writer)
		backing := prefix + "array_backing"
		_qbe_line(writer, "\t" + backing + " =l loadl " + backing_address)
		mut index := 0
		while index < arguments.size()
			entry := _recovery_managed_qbe_address(backing, index * 8, prefix + "array_entry" + index.to_s(), writer)
			stored := _recovery_managed_qbe_array_storage_value(
				native_module, type_id, context.values.fetch(arguments[index]),
				prefix + "array_value" + index.to_s(), writer,
			)
			_qbe_line(writer, "\tstorel " + stored + ", " + entry)
			index += 1
		end
	when RecoveryManagedInstruction::ArraySize(result, _type_id, array, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l call $trbn_array_size(l " + context.values.fetch(array) + ")")
	when RecoveryManagedInstruction::ArrayGet(result, type_id, array, index, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		mut loaded := context.values.fetch(result)
		if _recovery_managed_qbe_abi_type(_recovery_managed_qbe_array_element_type(native_module, type_id)) == "w"
			loaded = prefix + "array_value"
		end
		_qbe_line(
			writer,
			"\t" + loaded + " =l call $trbn_array_get(l " + context.values.fetch(array) +
			", l " + context.values.fetch(index) + ")",
		)
		if loaded != context.values.fetch(result)
			_qbe_line(writer, "\t" + context.values.fetch(result) + " =w copy " + loaded)
		end
	when RecoveryManagedInstruction::ArraySet(type_id, array, index, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		stored := _recovery_managed_qbe_array_storage_value(native_module, type_id, context.values.fetch(value), prefix + "array_value", writer)
		_qbe_line(
			writer,
			"\tcall $trbn_array_set(l " + context.values.fetch(array) + ", l " + context.values.fetch(index) +
			", l " + stored + ")",
		)
	when RecoveryManagedInstruction::ArrayPush(type_id, array, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		stored := _recovery_managed_qbe_array_storage_value(native_module, type_id, context.values.fetch(value), prefix + "array_value", writer)
		_qbe_line(
			writer,
			"\tcall $trbn_array_push(l " + context.values.fetch(array) + ", l " + stored + ")",
		)
	when RecoveryManagedInstruction::ClosureConstruct(result, _type_id, function_id, captures, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		callee_index := _recovery_managed_qbe_function_index(native_module.functions, function_id)
		environment := prefix + "environment"
		environment_size := try _recovery_managed_qbe_environment_payload_size(native_module, native_module.functions[callee_index])
		_qbe_line(
			writer,
			"\t" + environment + " =l call $trbn_alloc(l " + _recovery_managed_qbe_environment_descriptor(callee_index) +
			", l " + environment_size.to_s() + ", l 0)",
		)
		_qbe_line(writer, "\tstorel " + environment + ", " + context.root_slots.fetch(result))
		mut capture_index := 0
		mut capture_offset := 0
		while capture_index < captures.size()
			capture_type := native_module.functions[callee_index].captures[capture_index].value_type
			capture_address := _recovery_managed_qbe_address(
				environment,
				32 + capture_offset,
				prefix + "capture" + capture_index.to_s(),
				writer,
			)
			try _recovery_managed_qbe_emit_environment_store(
				native_module,
				capture_type,
				context.values.fetch(captures[capture_index]),
				capture_address,
				writer,
			)
			capture_offset += try _recovery_managed_qbe_capture_storage_size(native_module, capture_type)
			capture_index += 1
		end
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l call $trbn_alloc(l $trbn_desc_closure, l 16, l 0)",
		)
		code_address := _recovery_managed_qbe_address(context.values.fetch(result), 32, prefix + "closure_code", writer)
		_qbe_line(writer, "\tstorel $trbn_managed_f" + callee_index.to_s() + ", " + code_address)
		environment_address := _recovery_managed_qbe_address(context.values.fetch(result), 40, prefix + "closure_environment", writer)
		_qbe_line(writer, "\tstorel " + environment + ", " + environment_address)
	when RecoveryManagedInstruction::ClosureCall(result, type_id, closure, arguments, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		if _recovery_managed_qbe_emit_inlined_closure_call(
				native_module,
				function,
				result,
				closure,
				arguments,
				block_index,
				instruction_index,
				context,
				writer,
			)
			return Result<Boolean, Diagnostic>::Ok(true)
		end
		code_address := _recovery_managed_qbe_address(context.values.fetch(closure), 32, prefix + "call_code_address", writer)
		code := prefix + "call_code"
		_qbe_line(writer, "\t" + code + " =l loadl " + code_address)
		environment_address := _recovery_managed_qbe_address(context.values.fetch(closure), 40, prefix + "call_environment_address", writer)
		environment := prefix + "call_environment"
		_qbe_line(writer, "\t" + environment + " =l loadl " + environment_address)
		parameter_types := _recovery_managed_qbe_function_parameter_types(native_module, type_id)
		mut call_arguments: Array<String> := ["l " + environment]
		mut index := 0
		while index < arguments.size()
			call_arguments.push(_recovery_managed_qbe_abi_type(parameter_types[index]) + " " + context.values.fetch(arguments[index]))
			index += 1
		end
		result_type := _recovery_managed_qbe_function_result_type(native_module, type_id)
		mut call_prefix := "\t"
		if result_type != nil
			case result_type
			when RecoveryManagedValueType::Scalar(scalar)
				call_prefix = "\t" + context.values.fetch(_recovery_managed_qbe_required_id(result)) + " =" + _qbe_type(scalar) + " "
			when RecoveryManagedValueType::Aggregate(_result_type_id)
				if try recovery_managed_value_is_managed(native_module.types, result_type)
					call_prefix = "\t" + context.values.fetch(_recovery_managed_qbe_required_id(result)) + " =l "
				else
					mut prefixed_arguments: Array<String> := ["l " + context.values.fetch(_recovery_managed_qbe_required_id(result))]
					mut argument_index := 0
					while argument_index < call_arguments.size()
						prefixed_arguments.push(call_arguments[argument_index])
						argument_index += 1
					end
					call_arguments = prefixed_arguments
				end
			end
		end
		_qbe_line(writer, call_prefix + "call " + code + "(" + call_arguments.join(", ") + ")")
	when RecoveryManagedInstruction::RuntimeCollect(origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\tcall $trbn_collect(w 0)")
	when RecoveryManagedInstruction::RuntimeStatistic(result, statistic, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		mut symbol := "$trbn_heap_bytes"
		case statistic
		when RecoveryManagedRuntimeStatistic::CollectionCount
			symbol = "$trbn_collection_count"
		when RecoveryManagedRuntimeStatistic::AutomaticCollectionCount
			symbol = "$trbn_automatic_collection_count"
		when RecoveryManagedRuntimeStatistic::CollectionNanoseconds
			symbol = "$trbn_collection_nanoseconds"
		when RecoveryManagedRuntimeStatistic::AllocatedBytes
			symbol = "$trbn_allocated_bytes"
		when RecoveryManagedRuntimeStatistic::HeapBytes
			symbol = "$trbn_heap_bytes"
		when RecoveryManagedRuntimeStatistic::ReclaimedBytes
			symbol = "$trbn_reclaimed_bytes"
		end
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l loadl " + symbol)
	when RecoveryManagedInstruction::RecordConstruct(result, type_id, arguments, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		destination := context.values.fetch(result)
		mut payload := destination
		if layout.managed
			descriptor := _recovery_managed_qbe_type_descriptor(_recovery_managed_qbe_type_index(native_module.types, type_id))
			_qbe_line(
				writer,
				"\t" + destination + " =l call $trbn_alloc(l " + descriptor + ", l " + layout.size.to_s() + ", l 0)",
			)
			_qbe_line(writer, "\tstorel " + destination + ", " + context.root_slots.fetch(result))
			payload = _recovery_managed_qbe_address(destination, 32, prefix + "record_payload", writer)
		else
			_recovery_managed_qbe_emit_zero(destination, layout.size, writer)
		end
		mut index := 0
		while index < layout.fields.size()
			try _recovery_managed_qbe_emit_store_field(
				native_module,
				layout.fields[index],
				context.values.fetch(arguments[index]),
				payload,
				prefix + "field" + index.to_s(),
				writer,
			)
			index += 1
		end
	when RecoveryManagedInstruction::RecordProject(result, type_id, record, field, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		field_layout := _recovery_managed_qbe_required_field(layout, field)
		mut source := context.values.fetch(record)
		if layout.managed
			source = _recovery_managed_qbe_address(source, 32, prefix + "record_payload", writer)
		end
		try _recovery_managed_qbe_emit_project(
			native_module,
			field_layout,
			source,
			context.values.fetch(result),
			prefix,
			writer,
		)
	when RecoveryManagedInstruction::VariantConstruct(result, type_id, variant, arguments, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		variant_layout := _recovery_managed_qbe_required_variant(layout, variant)
		destination := context.values.fetch(result)
		mut payload := destination
		if layout.managed
			descriptor := _recovery_managed_qbe_type_descriptor(_recovery_managed_qbe_type_index(native_module.types, type_id))
			_qbe_line(
				writer,
				"\t" + destination + " =l call $trbn_alloc(l " + descriptor + ", l " + layout.size.to_s() + ", l 0)",
			)
			_qbe_line(writer, "\tstorel " + destination + ", " + context.root_slots.fetch(result))
			payload = _recovery_managed_qbe_address(destination, 32, prefix + "variant_payload", writer)
		else
			_recovery_managed_qbe_emit_zero(destination, layout.size, writer)
		end
		_qbe_line(writer, "\tstorew " + variant_layout.tag.to_s() + ", " + payload)
		mut index := 0
		while index < variant_layout.fields.size()
			try _recovery_managed_qbe_emit_store_field(
				native_module,
				variant_layout.fields[index],
				context.values.fetch(arguments[index]),
				payload,
				prefix + "payload" + index.to_s(),
				writer,
			)
			index += 1
		end
	when RecoveryManagedInstruction::VariantTest(result, type_id, value, variant, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		variant_layout := _recovery_managed_qbe_required_variant(layout, variant)
		tag := prefix + "tag"
		mut source := context.values.fetch(value)
		if layout.managed
			source = _recovery_managed_qbe_address(source, 32, prefix + "variant_payload", writer)
		end
		_qbe_line(writer, "\t" + tag + " =w loadw " + source)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =w ceqw " + tag + ", " + variant_layout.tag.to_s())
	when RecoveryManagedInstruction::VariantProject(result, type_id, value, variant, field, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		variant_layout := _recovery_managed_qbe_required_variant(layout, variant)
		mut source := context.values.fetch(value)
		if layout.managed
			source = _recovery_managed_qbe_address(source, 32, prefix + "variant_payload", writer)
		end
		tag := prefix + "tag"
		matches := prefix + "matches"
		ok := "@g3_" + block_index.to_s() + "_" + instruction_index.to_s() + "_project_ok"
		fail := "@g3_" + block_index.to_s() + "_" + instruction_index.to_s() + "_project_fail"
		_qbe_line(writer, "\t" + tag + " =w loadw " + source)
		_qbe_line(writer, "\t" + matches + " =w ceqw " + tag + ", " + variant_layout.tag.to_s())
		_qbe_line(writer, "\tjnz " + matches + ", " + ok + ", " + fail)
		_qbe_line(writer, fail)
		_qbe_line(writer, "\tcall $trbn_variant_projection_fail()")
		_qbe_line(writer, "\thlt")
		_qbe_line(writer, ok)
		field_layout := _recovery_managed_qbe_required_variant_field(variant_layout, field)
		try _recovery_managed_qbe_emit_project(
			native_module,
			field_layout,
			source,
			context.values.fetch(result),
			prefix,
			writer,
		)
	when RecoveryManagedInstruction::Call(result, function_id, arguments, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		if _recovery_managed_qbe_emit_inlined_forwarded_closure_call(
				native_module,
				function,
				result,
				function_id,
				arguments,
				block_index,
				instruction_index,
				context,
				writer,
			)
			return Result<Boolean, Diagnostic>::Ok(true)
		end
		callee_index := _recovery_managed_qbe_function_index(native_module.functions, function_id)
		callee := native_module.functions[callee_index]
		mut call_arguments: Array<String> := []
		case callee.result_type
		when RecoveryManagedResultType::Void
		when RecoveryManagedResultType::Value(value_type)
			case value_type
			when RecoveryManagedValueType::Scalar(_scalar)
			when RecoveryManagedValueType::Aggregate(_type_id)
				if !(try recovery_managed_value_is_managed(native_module.types, value_type))
					call_arguments.push("l " + context.values.fetch(_recovery_managed_qbe_required_id(result)))
				end
			end
		end
		if _recovery_managed_qbe_function_uses_closure_abi(native_module, function_id)
			call_arguments.push("l 0")
		end
		mut index := 0
		while index < arguments.size()
			call_arguments.push(
				_recovery_managed_qbe_abi_type(callee.parameters[index].value_type) + " " + context.values.fetch(arguments[index])
			)
			index += 1
		end
		mut call_prefix := "\t"
		case callee.result_type
		when RecoveryManagedResultType::Void
		when RecoveryManagedResultType::Value(value_type)
			case value_type
			when RecoveryManagedValueType::Scalar(scalar)
				call_prefix = "\t" + context.values.fetch(_recovery_managed_qbe_required_id(result)) + " =" + _qbe_type(scalar) + " "
			when RecoveryManagedValueType::Aggregate(_type_id)
				if try recovery_managed_value_is_managed(native_module.types, value_type)
					call_prefix = "\t" + context.values.fetch(_recovery_managed_qbe_required_id(result)) + " =l "
				end
			end
		end
		_qbe_line(writer, call_prefix + "call $trbn_managed_f" + callee_index.to_s() + "(" + call_arguments.join(", ") + ")")
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_scalar(
		native_module: RecoveryManagedModule,
		instruction: RecoveryScalarInstruction,
		block_index: Integer,
		instruction_index: Integer,
		values: Hash<String, String>,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	)
	case instruction
	when RecoveryScalarInstruction::BooleanLiteral(result, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		mut literal := "0"
		if value
			literal = "1"
		end
		_qbe_line(writer, "\t" + values.fetch(result) + " =w copy " + literal)
	when RecoveryScalarInstruction::IntegerLiteral(result, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + values.fetch(result) + " =l copy " + value.to_s())
	when RecoveryScalarInstruction::FloatLiteral(result, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + values.fetch(result) + " =d copy d_" + value.to_s())
	when RecoveryScalarInstruction::IntegerBinary(result, operator, left, right, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_emit_integer_binary(
			operator,
			values.fetch(result),
			values.fetch(left),
			values.fetch(right),
			block_index,
			instruction_index,
			writer,
		)
	when RecoveryScalarInstruction::FloatBinary(result, operator, left, right, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer,
			"\t" + values.fetch(result) + " =d " + _qbe_float_operator(operator) + " " +
			values.fetch(left) + ", " + values.fetch(right)
		)
	when RecoveryScalarInstruction::IntegerCompare(result, operator, left, right, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer,
			"\t" + values.fetch(result) + " =w " + _qbe_comparison(operator, "l") + " " +
			values.fetch(left) + ", " + values.fetch(right)
		)
	when RecoveryScalarInstruction::FloatCompare(result, operator, left, right, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer,
			"\t" + values.fetch(result) + " =w " + _qbe_comparison(operator, "d") + " " +
			values.fetch(left) + ", " + values.fetch(right)
		)
	when RecoveryScalarInstruction::BooleanNot(result, value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + values.fetch(result) + " =w ceqw " + values.fetch(value) + ", 0")
	when RecoveryScalarInstruction::Call(_result, _function_id, _arguments, _origin)
	when RecoveryScalarInstruction::WriteStatic(value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		symbol := _qbe_static_symbol(static_data, value)
		_qbe_line(writer,
			"\t%g3_io_" + block_index.to_s() + "_" + instruction_index.to_s() +
			" =l call $write(w 1, l " + symbol + ", l " + value.to_bytes().size().to_s() + ")"
		)
	end
	return
end

def _recovery_managed_qbe_emit_store_field(
		native_module: RecoveryManagedModule,
		field: RecoveryManagedFieldLayout,
		source: String,
		destination: String,
		prefix: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	address := _recovery_managed_qbe_address(destination, field.offset, prefix + "_address", writer)
	case field.value_type
	when RecoveryManagedValueType::Scalar(scalar)
		_qbe_line(writer, "\t" + _recovery_managed_qbe_scalar_field_store(scalar) + " " + source + ", " + address)
	when RecoveryManagedValueType::Aggregate(type_id)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		if layout.managed
			_qbe_line(writer, "\tstorel " + source + ", " + address)
		else
			_recovery_managed_qbe_emit_copy(address, source, layout.size, writer)
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_project(
		native_module: RecoveryManagedModule,
		field: RecoveryManagedFieldLayout,
		source: String,
		destination: String,
		prefix: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	address := _recovery_managed_qbe_address(source, field.offset, prefix + "address", writer)
	case field.value_type
	when RecoveryManagedValueType::Scalar(scalar)
		_qbe_line(writer,
			"\t" + destination + " =" + _qbe_type(scalar) + " " + _recovery_managed_qbe_scalar_field_load(scalar) + " " + address
		)
	when RecoveryManagedValueType::Aggregate(type_id)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		if layout.managed
			_qbe_line(writer, "\t" + destination + " =l loadl " + address)
		else
			_recovery_managed_qbe_emit_copy(destination, address, layout.size, writer)
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_terminator(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		terminator: RecoveryManagedTerminator,
		block_index: Integer,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	case terminator
	when RecoveryManagedTerminator::Jump(target, arguments, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		try _recovery_managed_qbe_emit_edge(native_module, function, target, arguments, context, writer)
		_qbe_line(writer, "\tjmp " + _recovery_managed_qbe_block_label(function.blocks, target))
	when RecoveryManagedTerminator::Branch(condition, when_true, true_arguments, when_false, false_arguments, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		true_edge := "@g3_edge_" + block_index.to_s() + "_true"
		false_edge := "@g3_edge_" + block_index.to_s() + "_false"
		_qbe_line(writer, "\tjnz " + context.values.fetch(condition) + ", " + true_edge + ", " + false_edge)
		_qbe_line(writer, true_edge)
		try _recovery_managed_qbe_emit_edge(native_module, function, when_true, true_arguments, context, writer)
		_qbe_line(writer, "\tjmp " + _recovery_managed_qbe_block_label(function.blocks, when_true))
		_qbe_line(writer, false_edge)
		try _recovery_managed_qbe_emit_edge(native_module, function, when_false, false_arguments, context, writer)
		_qbe_line(writer, "\tjmp " + _recovery_managed_qbe_block_label(function.blocks, when_false))
	when RecoveryManagedTerminator::Return(value, origin)
		_recovery_managed_qbe_emit_origin(native_module, origin, writer)
		previous_roots := "%g3_return_roots_" + block_index.to_s()
		_qbe_line(writer, "\t" + previous_roots + " =l loadl %root_frame")
		_qbe_line(writer, "\tstorel " + previous_roots + ", $trbn_roots")
		case function.result_type
		when RecoveryManagedResultType::Void
			_qbe_line(writer, "\tret")
		when RecoveryManagedResultType::Value(value_type)
			case value_type
			when RecoveryManagedValueType::Scalar(_scalar)
				_qbe_line(writer, "\tret " + context.values.fetch(_recovery_managed_qbe_required_id(value)))
			when RecoveryManagedValueType::Aggregate(type_id)
				layout := try compute_recovery_managed_layout(native_module.types, type_id)
				if layout.managed
					_qbe_line(writer, "\tret " + context.values.fetch(_recovery_managed_qbe_required_id(value)))
				else
					_recovery_managed_qbe_emit_copy("%return", context.values.fetch(_recovery_managed_qbe_required_id(value)), layout.size, writer)
					_qbe_line(writer, "\tret")
				end
			end
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_emit_edge(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		target: String,
		arguments: Array<String>,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	block := recovery_managed_block(function.blocks, target)
	mut index := 0
	while index < arguments.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when RecoveryManagedValueType::Scalar(_scalar)
		when RecoveryManagedValueType::Aggregate(type_id)
			managed := try recovery_managed_value_is_managed(native_module.types, parameter.value_type)
			if !managed && _recovery_managed_qbe_parameter_uses_transfer(parameter, context)
				source := context.values.fetch(arguments[index])
				destination := context.transfer_slots.fetch(parameter.id)
				if source != destination && _recovery_managed_qbe_edge_source_is_destination(block, source, context)
					layout := try compute_recovery_managed_layout(native_module.types, type_id)
					_recovery_managed_qbe_emit_copy(context.storage_slots.fetch(parameter.id), source, layout.size, writer)
				end
			end
		end
		index += 1
	end
	index = 0
	while index < arguments.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when RecoveryManagedValueType::Scalar(scalar)
			if _recovery_managed_qbe_parameter_uses_transfer(parameter, context)
				_qbe_line(writer,
					"\t" + _recovery_managed_qbe_scalar_slot_store(scalar) + " " + context.values.fetch(arguments[index]) +
					", " + context.transfer_slots.fetch(parameter.id)
				)
			end
		when RecoveryManagedValueType::Aggregate(type_id)
			if try recovery_managed_value_is_managed(native_module.types, parameter.value_type)
				if _recovery_managed_qbe_parameter_uses_transfer(parameter, context)
					_qbe_line(
						writer,
						"\tstorel " + context.values.fetch(arguments[index]) + ", " +
						context.transfer_slots.fetch(parameter.id),
					)
				end
			else
				if _recovery_managed_qbe_parameter_uses_transfer(parameter, context)
					layout := try compute_recovery_managed_layout(native_module.types, type_id)
					destination := context.transfer_slots.fetch(parameter.id)
					mut source := context.values.fetch(arguments[index])
					if source != destination && _recovery_managed_qbe_edge_source_is_destination(block, source, context)
						source = context.storage_slots.fetch(parameter.id)
					end
					if source != destination
						_recovery_managed_qbe_emit_copy(destination, source, layout.size, writer)
					end
				end
			end
		end
		index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_parameter_uses_transfer(parameter: RecoveryManagedParameter, context: RecoveryManagedQbeContext): Boolean
	return !context.aliased_parameters.key?(parameter.id)
end

def _recovery_managed_qbe_edge_source_is_destination(
		block: RecoveryManagedBlock?,
		source: String,
		context: RecoveryManagedQbeContext,
	): Boolean
	mut index := 0
	while index < block.parameters.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when RecoveryManagedValueType::Scalar(_scalar)
		when RecoveryManagedValueType::Aggregate(_type_id)
			if _recovery_managed_qbe_parameter_uses_transfer(parameter, context) && context.transfer_slots.fetch(parameter.id) == source
				return true
			end
		end
		index += 1
	end
	return false
end

def _recovery_managed_qbe_emit_entry(native_module: RecoveryManagedModule, report_runtime: Boolean, mut writer: StringBuilder)
	entry_index := _recovery_managed_qbe_function_index(native_module.functions, native_module.entry_function)
	_qbe_line(writer, "export function w $main() {")
	_qbe_line(writer, "@start")
	mut arguments := ""
	if _recovery_managed_qbe_function_uses_closure_abi(native_module, native_module.entry_function)
		arguments = "l 0"
	end
	_qbe_line(writer, "\tcall $trbn_managed_f" + entry_index.to_s() + "(" + arguments + ")")
	if report_runtime
		_recovery_managed_qbe_emit_runtime_report(writer)
	end
	_qbe_line(writer, "\tret 0")
	_qbe_line(writer, "}")
	return
end

def _recovery_managed_qbe_emit_bootstrap_entry(function_index: Integer, mut writer: StringBuilder)
	_qbe_line(writer, "export function w $main(w %argc, l %argv) {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\t%valid_argc =w ceqw %argc, 4")
	_qbe_line(writer, "\tjnz %valid_argc, @check_flag, @usage")
	_qbe_line(writer, "@check_flag")
	_qbe_line(writer, "\t%flag_address =l add %argv, 8")
	_qbe_line(writer, "\t%flag =l loadl %flag_address")
	_qbe_line(writer, "\t%flag_comparison =w call $strcmp(l %flag, l $trbn_bootstrap_source_content)")
	_qbe_line(writer, "\t%valid_flag =w ceqw %flag_comparison, 0")
	_qbe_line(writer, "\tjnz %valid_flag, @compile, @check_file_flag")
	_qbe_line(writer, "@check_file_flag")
	_qbe_line(writer, "\t%file_flag_comparison =w call $strcmp(l %flag, l $trbn_bootstrap_source_file)")
	_qbe_line(writer, "\t%valid_file_flag =w ceqw %file_flag_comparison, 0")
	_qbe_line(writer, "\tjnz %valid_file_flag, @compile, @usage")
	_qbe_line(writer, "@usage")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_bootstrap_usage, l " + _recovery_compiler_usage().to_bytes().size().to_s() + ")")
	_qbe_line(writer, "\tret 64")
	_qbe_line(writer, "@compile")
	_qbe_line(writer, "\t%root_frame =l alloc8 32")
	_qbe_line(writer, "\t%previous_roots =l loadl $trbn_roots")
	_qbe_line(writer, "\tstorel %previous_roots, %root_frame")
	_qbe_line(writer, "\t%root_count_address =l add %root_frame, 8")
	_qbe_line(writer, "\tstorel 2, %root_count_address")
	_qbe_line(writer, "\t%source_root =l add %root_frame, 16")
	_qbe_line(writer, "\tstorel 0, %source_root")
	_qbe_line(writer, "\t%mode_root =l add %root_frame, 24")
	_qbe_line(writer, "\tstorel 0, %mode_root")
	_qbe_line(writer, "\tstorel %root_frame, $trbn_roots")
	_qbe_line(writer, "\t%source_argument_address =l add %argv, 24")
	_qbe_line(writer, "\t%source_argument =l loadl %source_argument_address")
	_qbe_line(writer, "\tjnz %valid_flag, @source_content, @source_file")
	_qbe_line(writer, "@source_content")
	_qbe_line(writer, "\t%content =l call $trbn_bootstrap_string_from_c(l %source_argument)")
	_qbe_line(writer, "\tjmp @source_ready")
	_qbe_line(writer, "@source_file")
	_qbe_line(writer, "\t%file_source =l call $trbn_bootstrap_read_file(l %source_argument)")
	_qbe_line(writer, "\t%file_missing =w ceql %file_source, 0")
	_qbe_line(writer, "\tjnz %file_missing, @file_error, @source_ready")
	_qbe_line(writer, "@file_error")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_bootstrap_file_error, l 35)")
	_qbe_line(writer, "\t%path_length =l call $strlen(l %source_argument)")
	_qbe_line(writer, "\tcall $write(w 2, l %source_argument, l %path_length)")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_bootstrap_newline, l 1)")
	_qbe_line(writer, "\tstorel %previous_roots, $trbn_roots")
	_qbe_line(writer, "\tret 66")
	_qbe_line(writer, "@source_ready")
	_qbe_line(writer, "\t%source =l phi @source_content %content, @source_file %file_source")
	_qbe_line(writer, "\tstorel %source, %source_root")
	_qbe_line(writer, "\t%mode_argument_address =l add %argv, 16")
	_qbe_line(writer, "\t%mode_argument =l loadl %mode_argument_address")
	_qbe_line(writer, "\t%mode =l call $trbn_bootstrap_string_from_c(l %mode_argument)")
	_qbe_line(writer, "\tstorel %mode, %mode_root")
	_qbe_line(writer, "\t%status =l call $trbn_managed_f" + function_index.to_s() + "(l %source, l %mode, w 0)")
	_qbe_line(writer, "\t%restore_roots =l loadl %root_frame")
	_qbe_line(writer, "\tstorel %restore_roots, $trbn_roots")
	_qbe_line(writer, "\tret 0")
	_qbe_line(writer, "}")
	return
end

def _recovery_managed_qbe_emit_runtime_report(mut writer: StringBuilder)
	_qbe_line(writer, "\tcall $trbn_collect(w 0)")
	_recovery_managed_qbe_emit_runtime_statistic_line(
		"collections",
		"$trbn_report_collections",
		"recovery-managed-gc-stat,collections,",
		"$trbn_collection_count",
		writer,
	)
	_recovery_managed_qbe_emit_runtime_statistic_line(
		"automatic_collections",
		"$trbn_report_automatic_collections",
		"recovery-managed-gc-stat,automatic-collections,",
		"$trbn_automatic_collection_count",
		writer,
	)
	_recovery_managed_qbe_emit_runtime_statistic_line(
		"collection_nanoseconds",
		"$trbn_report_collection_nanoseconds",
		"recovery-managed-gc-stat,collection-nanoseconds,",
		"$trbn_collection_nanoseconds",
		writer,
	)
	_recovery_managed_qbe_emit_runtime_statistic_line(
		"allocated_bytes",
		"$trbn_report_allocated_bytes",
		"recovery-managed-gc-stat,allocated-bytes,",
		"$trbn_allocated_bytes",
		writer,
	)
	_recovery_managed_qbe_emit_runtime_statistic_line(
		"reclaimed_bytes",
		"$trbn_report_reclaimed_bytes",
		"recovery-managed-gc-stat,reclaimed-bytes,",
		"$trbn_reclaimed_bytes",
		writer,
	)
	_recovery_managed_qbe_emit_runtime_statistic_line(
		"live_bytes",
		"$trbn_report_live_bytes",
		"recovery-managed-gc-stat,live-bytes,",
		"$trbn_heap_bytes",
		writer,
	)
	return
end

def _recovery_managed_qbe_emit_runtime_statistic_line(
		name: String,
		label_symbol: String,
		label: String,
		value_symbol: String,
		mut writer: StringBuilder,
	)
	value := "%report_" + name
	_qbe_line(writer, "\t" + value + " =l loadl " + value_symbol)
	_qbe_line(
		writer,
		"\tcall $trbn_report_statistic(l " + label_symbol + ", l " + label.to_bytes().size().to_s() + ", l " + value + ")",
	)
	return
end

def _recovery_managed_qbe_emit_origin(native_module: RecoveryManagedModule, origin: SourceOrigin, mut writer: StringBuilder)
	mut source_index := 0
	while native_module.sources[source_index].id != origin.source_id
		source_index += 1
	end
	_qbe_line(writer,
		"\t# trb-origin source=" + source_index.to_s() + " start=" + origin.start_line.to_s() + ":" +
		origin.start_column.to_s() + " end=" + origin.end_line.to_s() + ":" + origin.end_column.to_s()
	)
	return
end

def _recovery_managed_qbe_emit_zero(destination: String, size: Integer, mut writer: StringBuilder)
	mut offset := 0
	while size - offset >= 8
		address := _recovery_managed_qbe_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstorel 0, " + address)
		offset += 8
	end
	if size - offset >= 4
		address := _recovery_managed_qbe_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstorew 0, " + address)
		offset += 4
	end
	if size - offset >= 2
		address := _recovery_managed_qbe_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstoreh 0, " + address)
		offset += 2
	end
	if size - offset == 1
		address := _recovery_managed_qbe_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstoreb 0, " + address)
	end
	return
end

def _recovery_managed_qbe_emit_copy(destination: String, source: String, size: Integer, mut writer: StringBuilder)
	_qbe_line(writer, "\tblit " + source + ", " + destination + ", " + size.to_s())
	return
end

def _recovery_managed_qbe_address(base: String, offset: Integer, name: String, mut writer: StringBuilder): String
	if offset == 0
		return base
	end
	_qbe_line(writer, "\t" + name + " =l add " + base + ", " + offset.to_s())
	return name
end

def _recovery_managed_qbe_abi_type(value_type: RecoveryManagedValueType): String
	case value_type
	when RecoveryManagedValueType::Scalar(scalar)
		return _qbe_type(scalar)
	when RecoveryManagedValueType::Aggregate(_type_id)
		return "l"
	end
end

def _recovery_managed_qbe_array_storage_value(
		native_module: RecoveryManagedModule,
		type_id: String,
		value: String,
		result: String,
		mut writer: StringBuilder,
	): String
	if _recovery_managed_qbe_abi_type(_recovery_managed_qbe_array_element_type(native_module, type_id)) == "w"
		_qbe_line(writer, "\t" + result + " =l extuw " + value)
		return result
	end
	return value
end

def _recovery_managed_qbe_array_element_type(native_module: RecoveryManagedModule, type_id: String): RecoveryManagedValueType
	definition := recovery_managed_type_definition(native_module.types, type_id)
	if definition == nil
		return RecoveryManagedValueType::Scalar(ScalarType::Void)
	end
	case definition
	when RecoveryManagedTypeDefinition::Array(_id, element_type)
		return element_type
	else
		return RecoveryManagedValueType::Scalar(ScalarType::Void)
	end
end

def _recovery_managed_qbe_function_result_type(native_module: RecoveryManagedModule, type_id: String): RecoveryManagedValueType?
	definition := recovery_managed_type_definition(native_module.types, type_id)
	if definition == nil
		return nil
	end
	case definition
	when RecoveryManagedTypeDefinition::Function(_id, _parameter_types, result_type)
		return result_type
	else
		return nil
	end
end

def _recovery_managed_qbe_function_parameter_types(native_module: RecoveryManagedModule, type_id: String): Array<RecoveryManagedValueType>
	definition := recovery_managed_type_definition(native_module.types, type_id)
	if definition == nil
		return []
	end
	case definition
	when RecoveryManagedTypeDefinition::Function(_id, parameter_types, _result_type)
		return parameter_types
	else
		return []
	end
end

def _recovery_managed_qbe_type_index(definitions: Array<RecoveryManagedTypeDefinition>, type_id: String): Integer
	mut index := 0
	while index < definitions.size()
		definition := definitions[index]
		mut candidate := ""
		case definition
		when RecoveryManagedTypeDefinition::Record(id, _fields)
			candidate = id
		when RecoveryManagedTypeDefinition::Tagged(id, _variants)
			candidate = id
		when RecoveryManagedTypeDefinition::Hash(id)
			candidate = id
		when RecoveryManagedTypeDefinition::String(id)
			candidate = id
		when RecoveryManagedTypeDefinition::Array(id, _element_type)
			candidate = id
		when RecoveryManagedTypeDefinition::Function(id, _parameter_types, _result_type)
			candidate = id
		end
		if candidate == type_id
			return index
		end
		index += 1
	end
	return 0
end

def _recovery_managed_qbe_emit_environment_store(
		native_module: RecoveryManagedModule,
		value_type: RecoveryManagedValueType,
		source: String,
		destination: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	case value_type
	when RecoveryManagedValueType::Scalar(scalar)
		_qbe_line(writer, "\t" + _recovery_managed_qbe_scalar_slot_store(scalar) + " " + source + ", " + destination)
	when RecoveryManagedValueType::Aggregate(_type_id)
		if try recovery_managed_value_is_managed(native_module.types, value_type)
			_qbe_line(writer, "\tstorel " + source + ", " + destination)
		else
			case value_type
			when RecoveryManagedValueType::Aggregate(type_id)
				layout := try compute_recovery_managed_layout(native_module.types, type_id)
				_recovery_managed_qbe_emit_copy(destination, source, layout.size, writer)
			else
			end
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _recovery_managed_qbe_capture_storage_size(
		native_module: RecoveryManagedModule,
		value_type: RecoveryManagedValueType,
	): Result<Integer, Diagnostic>
	case value_type
	when RecoveryManagedValueType::Scalar(_scalar)
		return Result<Integer, Diagnostic>::Ok(8)
	when RecoveryManagedValueType::Aggregate(type_id)
		layout := try compute_recovery_managed_layout(native_module.types, type_id)
		if layout.managed
			return Result<Integer, Diagnostic>::Ok(8)
		end
		return Result<Integer, Diagnostic>::Ok(((layout.size + 7) / 8) * 8)
	end
end

def _recovery_managed_qbe_environment_payload_size(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
	): Result<Integer, Diagnostic>
	mut size := 0
	mut index := 0
	while index < function.captures.size()
		size += try _recovery_managed_qbe_capture_storage_size(native_module, function.captures[index].value_type)
		index += 1
	end
	return Result<Integer, Diagnostic>::Ok(size)
end

def _recovery_managed_qbe_scalar_field_load(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "loadub"
	end
	if value_type == ScalarType::Float
		return "loadd"
	end
	return "loadl"
end

def _recovery_managed_qbe_scalar_field_store(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "storeb"
	end
	if value_type == ScalarType::Float
		return "stored"
	end
	return "storel"
end

def _recovery_managed_qbe_scalar_slot_load(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "loadw"
	end
	return _recovery_managed_qbe_scalar_field_load(value_type)
end

def _recovery_managed_qbe_scalar_slot_store(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "storew"
	end
	return _recovery_managed_qbe_scalar_field_store(value_type)
end

def _recovery_managed_qbe_function_index(functions: Array<RecoveryManagedFunction>, id: String): Integer
	mut index := 0
	while functions[index].id != id
		index += 1
	end
	return index
end

def _recovery_managed_qbe_function_uses_closure_abi(native_module: RecoveryManagedModule, function_id: String): Boolean
	function := recovery_managed_function(native_module.functions, function_id)
	if !function.captures.empty?()
		return true
	end
	mut function_index := 0
	while function_index < native_module.functions.size()
		candidate := native_module.functions[function_index]
		mut block_index := 0
		while block_index < candidate.blocks.size()
			block := candidate.blocks[block_index]
			mut instruction_index := 0
			while instruction_index < block.instructions.size()
				case block.instructions[instruction_index]
				when RecoveryManagedInstruction::ClosureConstruct(_result, _type_id, target_id, _captures, _origin)
					if target_id == function_id
						return true
					end
				else
				end
				instruction_index += 1
			end
			block_index += 1
		end
		function_index += 1
	end
	return false
end

def _recovery_managed_qbe_emit_inlined_forwarded_closure_call(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		result: String?,
		function_id: String,
		arguments: Array<String>,
		block_index: Integer,
		instruction_index: Integer,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	): Boolean
	callee := native_module.functions[_recovery_managed_qbe_function_index(native_module.functions, function_id)]
	if !callee.captures.empty?() || callee.blocks.size() != 1
		return false
	end
	block := callee.blocks[0]
	if block.id != callee.entry || !block.parameters.empty?() || block.instructions.size() != 1
		return false
	end
	case block.instructions[0]
	when RecoveryManagedInstruction::ClosureCall(inner_result, _type_id, closure, inner_arguments, _origin)
		case block.terminator
		when RecoveryManagedTerminator::Return(returned, _return_origin)
			if !_recovery_managed_qbe_optional_ids_equal(returned, inner_result)
				return false
			end
		else
			return false
		end
		closure_index := _recovery_managed_qbe_parameter_index(callee.parameters, closure)
		if closure_index < 0
			return false
		end
		mut forwarded_arguments: Array<String> := []
		mut index := 0
		while index < inner_arguments.size()
			parameter_index := _recovery_managed_qbe_parameter_index(callee.parameters, inner_arguments[index])
			if parameter_index < 0
				return false
			end
			forwarded_arguments.push(arguments[parameter_index])
			index += 1
		end
		return _recovery_managed_qbe_emit_inlined_closure_call(
			native_module,
			function,
			result,
			arguments[closure_index],
			forwarded_arguments,
			block_index,
			instruction_index,
			context,
			writer,
		)
	else
		return false
	end
end

def _recovery_managed_qbe_emit_inlined_closure_call(
		native_module: RecoveryManagedModule,
		function: RecoveryManagedFunction,
		result: String?,
		closure: String,
		arguments: Array<String>,
		block_index: Integer,
		instruction_index: Integer,
		context: RecoveryManagedQbeContext,
		mut writer: StringBuilder,
	): Boolean
	known := _recovery_managed_qbe_known_closure(function, closure, context)
	if known == nil
		return false
	end
	if result == nil
		return false
	end
	callee := native_module.functions[_recovery_managed_qbe_function_index(native_module.functions, known.function_id)]
	if callee.blocks.size() != 1
		return false
	end
	block := callee.blocks[0]
	if block.id != callee.entry || !block.parameters.empty?()
		return false
	end
	case callee.result_type
	when RecoveryManagedResultType::Void
		return false
	when RecoveryManagedResultType::Value(value_type)
		case value_type
		when RecoveryManagedValueType::Aggregate(_type_id)
			return false
		when RecoveryManagedValueType::Scalar(scalar)
			case block.terminator
			when RecoveryManagedTerminator::Return(returned, _return_origin)
				if returned == nil
					return false
				end
				if block.instructions.empty?()
					source := _recovery_managed_qbe_inline_operand(callee, known, arguments, returned, context)
					if source.empty?()
						return false
					end
					_qbe_line(
						writer,
						"\t" + context.values.fetch(result) + " =" + _qbe_type(scalar) + " copy " + source,
					)
					return true
				end
				if block.instructions.size() != 1
					return false
				end
				case block.instructions[0]
				when RecoveryManagedInstruction::Scalar(scalar_instruction)
					case scalar_instruction
					when RecoveryScalarInstruction::IntegerBinary(inner_result, operator, left, right, _origin)
						if scalar != ScalarType::Integer || returned != inner_result
							return false
						end
						left_value := _recovery_managed_qbe_inline_operand(callee, known, arguments, left, context)
						right_value := _recovery_managed_qbe_inline_operand(callee, known, arguments, right, context)
						if left_value.empty?() || right_value.empty?()
							return false
						end
						_qbe_emit_integer_binary(
							operator,
							context.values.fetch(result),
							left_value,
							right_value,
							block_index,
							instruction_index,
							writer,
						)
						return true
					else
						return false
					end
				else
					return false
				end
			else
				return false
			end
		end
	end
end

def _recovery_managed_qbe_known_closure(
		function: RecoveryManagedFunction,
		closure: String,
		context: RecoveryManagedQbeContext,
	): RecoveryManagedKnownClosure?
	value := context.values.fetch(closure)
	mut block_index := 0
	while block_index < function.blocks.size()
		block := function.blocks[block_index]
		mut instruction_index := 0
		while instruction_index < block.instructions.size()
			case block.instructions[instruction_index]
			when RecoveryManagedInstruction::ClosureConstruct(result, _type_id, function_id, captures, _origin)
				if context.values.fetch(result) == value
					return RecoveryManagedKnownClosure.new(function_id: function_id, captures: captures)
				end
			else
			end
			instruction_index += 1
		end
		block_index += 1
	end
	return nil
end

def _recovery_managed_qbe_inline_operand(
		callee: RecoveryManagedFunction,
		known: RecoveryManagedKnownClosure,
		arguments: Array<String>,
		operand: String,
		context: RecoveryManagedQbeContext,
	): String
	mut index := 0
	while index < callee.captures.size()
		if callee.captures[index].id == operand
			return context.values.fetch(known.captures[index])
		end
		index += 1
	end
	index = 0
	while index < callee.parameters.size()
		if callee.parameters[index].id == operand
			return context.values.fetch(arguments[index])
		end
		index += 1
	end
	return ""
end

def _recovery_managed_qbe_parameter_index(parameters: Array<RecoveryManagedParameter>, id: String): Integer
	mut index := 0
	while index < parameters.size()
		if parameters[index].id == id
			return index
		end
		index += 1
	end
	return -1
end

def _recovery_managed_qbe_optional_ids_equal(left: String?, right: String?): Boolean
	if left == nil
		return right == nil
	end
	if right == nil
		return false
	end
	return left == right
end

def _recovery_managed_qbe_block_label(blocks: Array<RecoveryManagedBlock>, id: String): String
	return "@b" + _recovery_managed_qbe_block_index(blocks, id).to_s()
end

def _recovery_managed_qbe_block_index(blocks: Array<RecoveryManagedBlock>, id: String): Integer
	mut index := 0
	while blocks[index].id != id
		index += 1
	end
	return index
end

def _recovery_managed_qbe_required_id(value: String?): String
	if value == nil
		return ""
	end
	return value
end

def _recovery_managed_qbe_required_field(layout: RecoveryManagedLayout, name: String): RecoveryManagedFieldLayout
	mut index := 0
	while layout.fields[index].name != name
		index += 1
	end
	return layout.fields[index]
end

def _recovery_managed_qbe_required_variant(layout: RecoveryManagedLayout, name: String): RecoveryManagedVariantLayout
	mut index := 0
	while layout.variants[index].name != name
		index += 1
	end
	return layout.variants[index]
end

def _recovery_managed_qbe_required_variant_field(variant: RecoveryManagedVariantLayout, name: String): RecoveryManagedFieldLayout
	mut index := 0
	while variant.fields[index].name != name
		index += 1
	end
	return variant.fields[index]
end
